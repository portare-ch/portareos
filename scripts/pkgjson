#!/bin/bash

# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2019-present Team LibreELEC (https://libreelec.tv)

. config/options ""

# Source one package.mk and print its dependencies as JSON. Run in a
# subshell by json_worker: source_package resets PKG_* between recipes but
# nothing else, and a recipe that sets an ordinary variable (SDL2_glesonly
# sets OPENGL_SUPPORT=no before inheriting SDL2's recipe) would otherwise
# leak into every recipe sourced after it in the same worker. Which recipes
# those are depends on how the 64-per-worker batches happen to fall, so the
# plan changed with the directory listing: SDL2 lost its glu dependency
# when packages/linux was removed and the batch boundaries shifted.
json_package() {
  local pkgpath="${1}" hierarchy exited=0

  exit() { exited=1; }

  source_package "${pkgpath}/package.mk" &>/dev/null || return 1

  [ ${exited} -eq 1 ] && return 0

  [[ ${pkgpath} =~ ^${ROOT}/${PACKAGES}/ ]] && hierarchy="global" || hierarchy="local"

  cat <<EOF
  {
    "name": "${PKG_NAME}",
    "hierarchy": "${hierarchy}",
    "section": "${PKG_SECTION}",
    "bootstrap": "${PKG_DEPENDS_BOOTSTRAP}",
    "init": "${PKG_DEPENDS_INIT}",
    "host": "${PKG_DEPENDS_HOST}",
    "target": "${PKG_DEPENDS_TARGET}",
    "unpack": "${PKG_DEPENDS_UNPACK}"
  },
EOF
}

# This function is passed a list of package.mk paths to be processed.
json_worker() {
  local pkgpath

  for pkgpath in "$@"; do
    pkgpath="${pkgpath%%@*}"
    ( json_package "${pkgpath}" ) \
      || die "$(print_color CLR_ERROR "FAILURE: sourcing package ${pkgpath}/package.mk")"
  done
}

if [ "$1" = "--worker" ]; then
  shift
  json_worker "$@"
  exit $?
fi

# pipefail: return value of a pipeline is the value of the last (rightmost) command to exit with a non-zero status
set -o pipefail

cat ${_CACHE_PACKAGE} |
  xargs --max-args=64 --max-procs="$(nproc)" "$0" --worker
exit $?
