# LTO (Link Time Optimization) support
  LTO_SUPPORT="yes"

# GOLD (Google Linker) support
  GOLD_SUPPORT="yes"

# HARDENING (security relevant linker and compiler flags) support
  HARDENING_SUPPORT="no"

# The name of the parent organization for updates
  GIT_ORGANIZATION="portare-ch"

# The name of the github project for updates
  GIT_REPO="distribution"

# Name of the Distro to build (full name, without special characters)
  DISTRONAME="PortareOS"

# Name of the OS to build (full name, lower case, without special characters)
  OSNAME="portareos"

# short project description
  DESCRIPTION="A PortareOS fork focused on the Retroid Pocket Nova."

# Distribution Home URL
  HOME_URL="https://os.portare.org"

# Documentation URL
  WIKI_URL="https://os.portare.org"

# Where to report bugs
  BUG_REPORT_URL="https://github.com/portare-ch/portareos/issues"

# Root password to integrate in the target system
  ROOT_PASSWORD="portareos"

# Install glibc locales to the build (yes / no)
  GLIBC_LOCALES="yes"

# build and install pipewire support (yes / no)
  PIPEWIRE_SUPPORT="yes"

# Define package sets to clean based on the type of build being executed.
# This should be updated to be more dynamic in the future.
  CLEAN_OS_BASE="emulators system-utils modules quirks autostart portareos kernel-firmware"
  CLEAN_NETWORK=""
  CLEAN_EMU_32BIT=""


# additional drivers to install:
# for a list of additional drivers see packages/linux-drivers
# Space separated list is supported,
# e.g. ADDITIONAL_DRIVERS="DRIVER1 DRIVER2"
  ADDITIONAL_DRIVERS=""

# build and install driver addons (yes / no)
  DRIVER_ADDONS_SUPPORT="no"

# driver addons to install:
# for a list of additinoal drivers see packages/linux-driver-addons
# Space separated list is supported,
  DRIVER_ADDONS=""

# build and install bluetooth support (yes / no)
  BLUETOOTH_SUPPORT="yes"

# build with NFS support (mounting nfs shares via the OS) (yes / no)
# Off: the package installs mount.nfs and nothing in the image ever calls it.
# Nothing under packages/portareos/sources mounts an NFS share, the front-end
# has no UI for one, and there is no fstab entry. Turning this back on is one
# word here, and brings back nfs-utils, rpcbind and libevent with it.
  NFS_SUPPORT="no"

# build and install SFTP Server (yes / no)
  SFTP_SERVER="yes"

# build and install OpenVPN support (yes / no)
  OPENVPN_SUPPORT="no"

# build and install ZeroTier support (yes / no)
  ZEROTIER_SUPPORT="no"

# build and install WireGuard support (yes / no)
  WIREGUARD_SUPPORT="yes"

# build and install diskmounter support (udevil)
# this service provide auto mounting support for external drives in the
# mediacenter also automount internally drives at boottime via udev (yes / no)
  UDEVIL="yes"

# build and install exFAT fuse support (yes / no)
  EXFAT="yes"

# build and install hfs filesystem utilities (yes / no)
  HFSTOOLS="no"

# Target an emulation device
  EMULATION_DEVICE="${EMULATION_DEVICE:-yes}"

# Add support for containers
  CONTAINER_SUPPORT="${CONTAINER_SUPPORT:-no}"

# Build modules packages
  MODULES_PKG="${MODULES_PKG:-yes}"

# Debug tools: gdb and strace, a dozen megabytes, in builds that are not
# official. The set used to be forty megabytes of GPU tracers and
# monitors nobody ran on a device; these two are what a problem gets
# debugged with. DEBUG_PACKAGES=yes still overrides either way.
  if [ "${OFFICIAL}" = "yes" ]; then
    DEBUG_PACKAGES="${DEBUG_PACKAGES:-no}"
  else
    DEBUG_PACKAGES="${DEBUG_PACKAGES:-yes}"
  fi

# Windowmanager to use (swaywm-env / no)
  WINDOWMANAGER="none"

# Xorg Graphic drivers to use (all / i915,i965,r200,r300,r600,nvidia)
# Space separated list is supported,
# e.g. GRAPHIC_DRIVERS="i915 i965 r300 r600 radeonsi nvidia"
  GRAPHIC_DRIVERS=""

# build and install remote support (yes / no)
# Off: this is infrared remote control and Video4Linux tooling - lirc,
# libirman, v4l-utils and evrepeat. The Nova has no IR receiver, no IR
# blaster, no camera and no tuner, and nothing in the tree drives any of
# them. Game input is evdev through SDL and inputplumber, which is
# unrelated.
  REMOTE_SUPPORT="no"

# build and install Joystick support (yes / no)
  JOYSTICK_SUPPORT="yes"

# Support for partitioning and formating disks in initramfs (yes / no)
# This adds support for parted and mkfs.ext3/4 to initramfs for OEM usage
  INITRAMFS_PARTED_SUPPORT="no"

# build with swap support (yes / no)
  SWAP_SUPPORT="yes"

# swap support enabled per default (yes / no)
  SWAP_ENABLED_DEFAULT="yes"

# swap size if SWAP_SUPPORT=yes in MB
  SWAPSIZE="384"

# swap type if SWAP_SUPPORT=yes (file / zram)
  SWAP_TYPE="file"

# additional packages to install:
# Space separated list is supported,
# e.g. ADDITIONAL_PACKAGES="PACKAGE1 PACKAGE2"

# build with installer (yes / no)
  INSTALLER_SUPPORT="no"

# Testpackages for development (yes / no)
  TESTING="no"

# OEM packages for OEM's (yes / no)
  OEM_SUPPORT="no"

# build and install nano text editor (yes / no)
  NANO_EDITOR="yes"

# cron support (yes / no)
  CRON_SUPPORT="no"

# htop tool (yes / no)
  HTOP_TOOL="yes"

# btop tool (yes / no)

# Distribution Specific source location
  DISTRO_MIRROR="https://github.com/ROCKNIX/distribution-sources/releases/download/sources-v2"
  DISTRO_SRC="https://sources.libreelec.tv/$DISTRO_VERSION"

# Default size of system partition, in MB, eg. 512
  SYSTEM_SIZE=2048

# Default system partition offset, in sectors, eg. 2048
  SYSTEM_PART_START=32768

# Size of storage partition, in MB. Must be >=32
  STORAGE_SIZE=32

# Default supported get handlers (archive, git, file etc.)
  GET_HANDLER_SUPPORT="${GET_HANDLER_SUPPORT:-archive git file}"

# Partition labels for USB/SD installation media.
#
# Both have to be ours alone. The initramfs resolves boot= and disk= by label
# and takes the first blkid match, so a label shared with another distribution
# already on the device resolves to whichever disk enumerates first, which is
# normally internal storage rather than the card we booted from. "STORAGE" is
# what ROCKNIX and LibreELEC use, and it silently handed /storage to an
# existing internal install.
#
# ext4 labels are capped at 16 characters, FAT at 11.
  DISTRO_BOOTLABEL="PORTAREOS"
  DISTRO_DISKLABEL="PORTAREOS_STOR"

# Settings package name - blank if not required
  DISTRO_PKG_SETTINGS=""

# Enable Updates
  ENABLE_UPDATES="yes"

# defines the born on date of a build
  BUILD_DATE=$(date)

# Define supported systems documentation path
  SYSDOCROOT="${ROOT}/documentation/PER_DEVICE_DOCUMENTATION/${DEVICE}"
  SYSDOC="${SYSDOCROOT}/SUPPORTED_EMULATORS_AND_CORES"
