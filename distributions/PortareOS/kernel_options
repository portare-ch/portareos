# Kernel options asserted after oldconfig has run, by the check at the end of
# projects/PortareOS/packages/linux/package.mk's pre_make_target.
#
# This file exists because the failure mode it guards is silent. Kconfig drops
# a symbol whose dependencies are unmet without printing anything: no warning,
# no "is not set" line, just an option that quietly is not there. Every entry
# below is a symbol whose absence produces a kernel that boots fine and then
# fails at runtime.
#
# Cluster-aware topology, so the scheduler can tell the X3 from the A510s.
CONFIG_SCHED_CLUSTER=y
# schedutil, the default governor (autostart/008-perfmode). Energy Aware
# Scheduling needs it, and uses the energy model sm8550.dtsi provides.
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# Utilization clamping, so a thread can carry a floor for schedutil to clock
# and place by. An emulator whose threads take turns looks lightly loaded
# however busy the frame is: PS2 ran at 40 fps under schedutil and 59.7 with
# the big cores pinned at maximum. Depends on schedutil above.
CONFIG_UCLAMP_TASK=y
# cgroup v2 cpusets. runemu keeps the system off a game's cores with them
# (documentation/CPU_ISOLATION.md); without them systemd ignores
# AllowedCPUs= and the game shares its cores with everything else, silently.
CONFIG_CPUSETS=y

# Latency tuning (issue #13). Asserted for the same reason as everything above:
# a preemption or idle symbol that Kconfig drops leaves a kernel that boots and
# behaves like the old one, which is indistinguishable from the change not
# having helped.
#
# 1000 Hz. At 250 the scheduler ticked every 4 ms against an 8.3 ms frame on a
# 120 Hz panel.
CONFIG_HZ_1000=y
# Numeric values are asserted here but NOT written by
# tools/check_kernel_config, which only knows y/m/n and strings. This one
# is safe because Kconfig derives it from CONFIG_HZ_1000 above; a numeric
# option with no such parent would need setting by hand.
CONFIG_HZ=1000
# Preemption model selectable at boot, so "preempt=none|voluntary|full" can be
# measured against each other on one image instead of three. The built-in
# default stays full, which is what CONFIG_PREEMPT gave us before.
CONFIG_PREEMPT_DYNAMIC=y
# The timer-events-oriented idle governor, which predicts better than menu on
# hardware like this and pairs with schedutil, the default governor. Both
# governors are built in: menu outranks teo (rating 20 against 19), so
# teo only runs because the cmdline names it. Check which one actually won with
#   cat /sys/devices/system/cpu/cpuidle/current_governor
CONFIG_CPU_IDLE_GOV_TEO=y

# Filesystems deliberately absent. Asserted as =n because the check treats an
# undefined symbol as satisfying it, so this fails the build if a kernel bump
# or a config refresh brings one back - the same silent-return problem the
# options above guard against, in the other direction.
#
# btrfs: nothing here makes or repairs one since btrfs-progs came out, and a
# card the device can mount but cannot check is worse than one it declines.
# Cards arrive FAT32 or exFAT; internal storage is ext4.
CONFIG_BTRFS_FS=n
# ntfs: ntfs-3g and its tools came out in #403, which left two kernel drivers
# for a filesystem nothing here can check either. A card or drive formatted
# NTFS is now declined rather than mounted unrepairable. Both symbols, because
# the legacy driver and ntfs3 are separate.
CONFIG_NTFS_FS=n
CONFIG_NTFS3_FS=n
