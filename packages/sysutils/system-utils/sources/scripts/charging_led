###
### redirects to the quirk device or platform charging_led
### so we don't need to have multiple variants in /usr/bin.
###

if [ -z "${QUIRK_DEVICE}" ] || [ -z "${HW_DEVICE}" ]; then
  . /etc/profile
fi

if [ -f "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/bin/charging_led" ]; then
  exec "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/bin/charging_led" $*
elif [ -f "/usr/lib/autostart/quirks/platforms/${HW_DEVICE}/bin/charging_led" ]; then
  exec "/usr/lib/autostart/quirks/platforms/${HW_DEVICE}/bin/charging_led" $*
fi
