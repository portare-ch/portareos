From: PortareOS <hello@portare.org>
Subject: [PATCH] the DSP's own 32040 Hz, one frame's audio per frame

The core reported 48000 Hz and asked for it with
configure("Audio/Frequency"), a key the configuration does not have, so
the request did nothing and the mixer ran at its own default of 48000:
the DSP's 32040 Hz resampled up by half. The mixer's frequency is now
set directly, to the DSP's rate, so the core does not resample at all
and RetroArch carries it on the device's 32 kHz link. A game with an
MSU-1 data file next to it gets 44100, the rate of its soundtrack, as
snes9x gave it.

Audio was also handed over in fixed batches of 1/60 s of samples, which
drifted against the frames: some frames sent none and the next sent the
held batch, up to a frame of audio late. What a frame produced is now
sent at the end of retro_run.

Measured in a test frontend: 533.12 samples per frame at 32040 Hz and
733.79 at 44100, as the reported rates give; before, 799 whatever was
reported.

--- a/bsnes/target-libretro/libretro.cpp
+++ b/bsnes/target-libretro/libretro.cpp
@@ -18,8 +18,10 @@ bool sgb_border_disabled = false;
 bool retro_pointer_enabled = false;
 bool retro_pointer_superscope_reverse_buttons = false;
 
-#define SAMPLERATE 48000
-#define AUDIOBUFSIZE (SAMPLERATE/50) * 2
+// The DSP's own 32040 Hz, so the core does not resample; RetroArch carries
+// it on the 32 kHz link. MSU-1 games get 44100, their soundtrack's rate.
+static double output_rate = 32040.0;
+#define AUDIOBUFSIZE (48000/50) * 2
 static int16_t audio_buffer[AUDIOBUFSIZE];
 static uint16_t audio_buffer_index = 0;
 static uint16_t audio_buffer_max = AUDIOBUFSIZE;
@@ -772,14 +774,13 @@ void retro_get_system_av_info(struct retro_system_av_info *info)
 
 	info->geometry.aspect_ratio = get_aspect_ratio();
 
-	info->timing.sample_rate   = SAMPLERATE;
+	info->timing.sample_rate   = output_rate;
 
 	if (retro_get_region() == RETRO_REGION_NTSC) {
 		// 945/44 MHz, six times the colour subcarrier, over 357366 master
 		// clocks a frame. 21477272 rounds it 0.034 ppm low, enough to miss
 		// a panel mode cut to twice the true rate.
 		info->timing.fps = Emulator::Constants::Colorburst::NTSC * 6.0 / 357366.0;
-		audio_buffer_max = (SAMPLERATE/60) * 2;
 	}
 	else
 	{
@@ -831,6 +832,14 @@ void retro_run()
 		emulator->run();
 	else
 		run_with_runahead(run_ahead_frames);
+
+	// Hand over the frame's audio with the frame. Batches of a fixed size
+	// drifted against the frames and held up to one in the core.
+	if (audio_buffer_index)
+	{
+		audio_batch_cb(audio_buffer, audio_buffer_index/2);
+		audio_buffer_index = 0;
+	}
 }
 
 size_t retro_serialize_size()
@@ -925,11 +934,15 @@ void retro_cheat_set(unsigned index, bool enabled, const char *code)
 
 bool retro_load_game(const retro_game_info *game)
 {
+	output_rate = file::exists({Location::notsuffix(string(game->path)), ".msu"}) ? 44100.0 : 32040.0;
+
 	retro_pixel_format fmt = RETRO_PIXEL_FORMAT_XRGB8888;
 	if (!environ_cb(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &fmt))
 		return false;
 
-	emulator->configure("Audio/Frequency", SAMPLERATE);
+	// Not configure("Audio/Frequency"): nothing reads that key, and the
+	// mixer stayed at its own default of 48000.
+	Emulator::audio.setFrequency(output_rate);
 	emulator->configure("Video/ColorEmulation", false);
 	program->filterRender = &Filter::None::render;
 	program->filterSize = &Filter::None::size;
@@ -987,7 +1000,9 @@ bool retro_load_game_special(unsigned game_type,
 	if (!environ_cb(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &fmt))
 		return false;
 
-	emulator->configure("Audio/Frequency", SAMPLERATE);
+	// Not configure("Audio/Frequency"): nothing reads that key, and the
+	// mixer stayed at its own default of 48000.
+	Emulator::audio.setFrequency(output_rate);
 	emulator->configure("Video/ColorEmulation", false);
 	program->filterRender = &Filter::None::render;
 	program->filterSize = &Filter::None::size;
