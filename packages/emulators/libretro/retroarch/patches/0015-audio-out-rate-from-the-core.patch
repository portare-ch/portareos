@@ -4000,10 +4000,68 @@ static bool audio_driver_inline_prepare(audio_driver_state_t *audio_st,
 
 static bool audio_driver_transport_configure(const settings_t *settings);
 
+/* The rates the device's audio link carries without a resampling stage
+ * of its own (the Nova's DSP, codec and I2S clock: 32, 44.1 and 48 kHz).
+ * With audio_out_rate = 0 the output rate is picked from these by the
+ * core's rate: a link rate the core's divides into within 0.5 % wins
+ * (32040 -> 32000, 22050 -> 44100, 44100 -> 44100), the smallest such;
+ * else the smallest above it, so nothing is cut; else the highest. */
+static const unsigned audio_link_rates[] = { 32000, 44100, 48000 };
+
+static unsigned audio_driver_pick_out_rate(double core_rate)
+{
+   unsigned i, multiple = 0, above = 0;
+   unsigned highest = audio_link_rates[ARRAY_SIZE(audio_link_rates) - 1];
+
+   if (core_rate <= 0.0)
+      return highest;
+
+   for (i = 0; i < ARRAY_SIZE(audio_link_rates); i++)
+   {
+      unsigned c = audio_link_rates[i];
+      double   n = (double)c / core_rate;
+      double   r = floor(n + 0.5);
+
+      if (r >= 1.0 && fabs(n / r - 1.0) <= 0.005)
+      {
+         if (!multiple || c < multiple)
+            multiple = c;
+      }
+      else if ((double)c >= core_rate && (!above || c < above))
+         above = c;
+   }
+
+   if (multiple)
+      return multiple;
+   if (above)
+      return above;
+   return highest;
+}
+
+/* The rate the device is open at, or would be: the setting, or with the
+ * setting at 0 the pick for the current core. Callers outside the init
+ * path read this, never the setting, which stays 0 in that mode. */
+unsigned audio_driver_out_rate(void)
+{
+   settings_t *settings = config_get_ptr();
+
+   if (audio_driver_st.out_rate)
+      return audio_driver_st.out_rate;
+   if (settings->uints.audio_output_sample_rate)
+      return settings->uints.audio_output_sample_rate;
+   return audio_driver_pick_out_rate(
+         video_state_get_ptr()->av_info.timing.sample_rate);
+}
+
 bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
 {
    unsigned new_rate              = 0;
    settings_t *settings           = (settings_t*)settings_data;
+   unsigned out_rate              = settings->uints.audio_output_sample_rate;
+   /* audio_out_rate = 0 leaves the choice to the core's rate, at every
+    * init, so a core that changes its rate through SET_SYSTEM_AV_INFO
+    * reopens the device to match. The setting stays 0. */
+   bool out_rate_auto             = (out_rate == 0);
    bool audio_enable              = settings->bools.audio_enable;
    bool audio_sync                = settings->bools.audio_sync;
    bool audio_rate_control        = settings->bools.audio_rate_control;
@@ -4250,6 +4308,14 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
             audio_driver_st.pipe_float ? "float" : "int16");
    }
 
+   if (out_rate_auto)
+   {
+      double core_rate = video_state_get_ptr()->av_info.timing.sample_rate;
+      out_rate         = audio_driver_pick_out_rate(core_rate);
+      RARCH_LOG("[Audio] Output rate picked for the core's %.2f Hz: %u Hz.\n",
+            core_rate, out_rate);
+   }
+
    /* Before the driver's init, which is where a driver that reports a
     * device stage sets it. */
    audio_driver_st.device_latency_frames = 0;
@@ -4262,7 +4328,7 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
                &audio_driver_st.context_audio_data,
                 *settings->arrays.audio_device
                ? settings->arrays.audio_device : NULL,
-               settings->uints.audio_output_sample_rate, &new_rate,
+               out_rate, &new_rate,
                audio_latency,
                settings->bools.audio_thread_priority,
                settings->bools.thread_prefer_fast_cores,
@@ -4278,15 +4344,19 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
       audio_driver_st.context_audio_data =
          audio_driver_st.current_audio->init(*settings->arrays.audio_device
                ? settings->arrays.audio_device : NULL,
-               settings->uints.audio_output_sample_rate,
+               out_rate,
                audio_latency,
                &new_rate);
       RARCH_LOG("[Audio] Started synchronous audio driver.\n");
    }
 
    if (new_rate != 0)
-      configuration_set_int(settings,
-            settings->uints.audio_output_sample_rate, new_rate);
+   {
+      out_rate = new_rate;
+      if (!out_rate_auto)
+         configuration_set_int(settings,
+               settings->uints.audio_output_sample_rate, new_rate);
+   }
 
    if (!audio_driver_st.context_audio_data)
    {
@@ -4320,7 +4390,7 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
          audio_driver_st.upmix_i16 = (int16_t*)malloc(frames * ch * sizeof(int16_t));
          if (audio_driver_st.upmix_buf && audio_driver_st.upmix_i16
                && audio_upmix_init(&audio_driver_st.upmix, layout,
-                  settings->uints.audio_output_sample_rate))
+                  out_rate))
          {
             audio_driver_st.out_layout   = layout;
             audio_driver_st.out_channels = ch;
@@ -4358,9 +4428,9 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
       audio_driver_st.upmix_i16 = (int16_t*)malloc(frames * 6 * sizeof(int16_t));
       if (audio_driver_st.virt_buf && audio_driver_st.upmix_buf && audio_driver_st.upmix_i16
             && audio_upmix_init(&audio_driver_st.upmix, AUDIO_LAYOUT_5POINT1,
-               settings->uints.audio_output_sample_rate)
+               out_rate)
             && audio_binaural_init(&audio_driver_st.binaural, AUDIO_LAYOUT_5POINT1,
-               settings->uints.audio_output_sample_rate))
+               out_rate))
       {
          audio_driver_st.virtualize   = true;
          audio_driver_st.upmix_frames = frames;
@@ -4391,15 +4461,15 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
       RARCH_WARN("[Audio] Input rate is invalid (%.3f Hz)."
             " Using output rate (%u Hz).\n",
             audio_driver_st.input,
-            settings->uints.audio_output_sample_rate);
+            out_rate);
 
-      audio_driver_st.input = settings->uints.audio_output_sample_rate;
+      audio_driver_st.input = out_rate;
    }
 
    audio_driver_st.src_ratio_orig    =
       audio_driver_st.src_ratio_curr =
-      (double)settings->uints.audio_output_sample_rate / audio_driver_st.input;
-   audio_driver_st.out_rate          = settings->uints.audio_output_sample_rate;
+      (double)out_rate / audio_driver_st.input;
+   audio_driver_st.out_rate          = out_rate;
 
    if (*settings->arrays.audio_resampler)
       strlcpy(audio_driver_st.resampler_ident,
@@ -4508,8 +4578,6 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
           * steady state; a driver that reports only some of its
           * stages, or in the wrong unit, shows here as a size that
           * does not match the setting. */
-         unsigned out_rate     = new_rate
-               ? new_rate : settings->uints.audio_output_sample_rate;
          /* the device's frame: the layout's channels, not two - a 5.1
           * driver's buffer read three times its size here */
          size_t   frame_bytes  = audio_driver_dev_frame_bytes(&audio_driver_st);
@@ -4600,7 +4668,7 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
    audio_driver_update_drc_threshold(&audio_driver_st);
 
 #ifdef HAVE_AUDIOMIXER
-   audio_mixer_init(settings->uints.audio_output_sample_rate);
+   audio_mixer_init(out_rate);
    AUDIO_FLAGS_SET(&audio_driver_st, AUDIO_FLAG_MIXER_INITED);
 #endif
 
@@ -8286,8 +8354,7 @@ void audio_driver_set_device_latency(size_t frames)
