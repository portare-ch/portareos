+/* The rates the device's audio link carries without a resampling stage
+ * of its own (the Nova's DSP, codec and I2S clock: 32, 44.1 and 48 kHz).
+ * With audio_out_rate = 0 the output rate is picked from these by the
+ * core's rate: a link rate the core's divides into within 0.5 % wins
+ * (32040 -> 32000, 22050 -> 44100, 44100 -> 44100), the smallest such;
+ * else the smallest above it, so nothing is cut; else the highest. */
+static const unsigned audio_link_rates[] = { 32000, 44100, 48000 };
+
+static unsigned audio_driver_pick_out_rate(double core_rate)
+{
+   unsigned i, multiple = 0, above = 0;
+   unsigned highest = audio_link_rates[ARRAY_SIZE(audio_link_rates) - 1];
+
+   if (core_rate <= 0.0)
+      return highest;
+
+   for (i = 0; i < ARRAY_SIZE(audio_link_rates); i++)
+   {
+      unsigned c = audio_link_rates[i];
+      double   n = (double)c / core_rate;
+      double   r = floor(n + 0.5);
+
+      if (r >= 1.0 && fabs(n / r - 1.0) <= 0.005)
+      {
+         if (!multiple || c < multiple)
+            multiple = c;
+      }
+      else if ((double)c >= core_rate && (!above || c < above))
+         above = c;
+   }
+
+   if (multiple)
+      return multiple;
+   if (above)
+      return above;
+   return highest;
+}
+
+/* The rate the device is open at, or would be: the setting, or with the
+ * setting at 0 the pick for the current core. Callers outside the init
+ * path read this, never the setting, which stays 0 in that mode. */
+unsigned audio_driver_out_rate(void)
+{
+   settings_t *settings = config_get_ptr();
+
+   if (audio_driver_st.out_rate)
+      return audio_driver_st.out_rate;
+   if (settings->uints.audio_output_sample_rate)
+      return settings->uints.audio_output_sample_rate;
+   return audio_driver_pick_out_rate(
+         video_state_get_ptr()->av_info.timing.sample_rate);
+}
 
