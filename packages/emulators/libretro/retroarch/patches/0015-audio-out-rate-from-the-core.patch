    audio_driver_opened.virtual_surround  = settings->bools.audio_headphone_virtual_surround;
@@ -5005,7 +5085,7 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
                &audio_driver_st.context_audio_data,
                 *settings->arrays.audio_device
                ? settings->arrays.audio_device : NULL,
-               settings->uints.audio_output_sample_rate, &new_rate,
+               out_rate, &new_rate,
                audio_latency,
                settings->bools.audio_thread_priority,
                settings->bools.thread_prefer_fast_cores,
@@ -5021,15 +5101,19 @@ bool audio_driver_init_internal(void *settings_data, bool audio_cb_inited)
       audio_driver_st.context_audio_data =
          audio_driver_st.current_audio->init(*settings->arrays.audio_device
                ? settings->arrays.audio_device : NULL,
-               settings->uints.audio_output_sample_rate,
+               out_rate,
                audio_latency,
