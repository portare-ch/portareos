From: portare-ch <hello@portare.org>
Subject: [PATCH] vulkan/khr_display: pick the display mode closest to the requested rate

vulkan_update_display_mode() took the first mode of the right size within
1 Hz of the requested rate. A panel can carry two modes a fraction of a
hertz apart - 119.880 and 119.635 Hz, twice NTSC and twice the PlayStation's
59.8173 - both inside that window, so whichever the driver listed first
always won and the other was unreachable. Among modes of equal size it now
takes the one closest to the requested rate, independent of listing order.
A request with no mode within 1 Hz still finds none, as before.

Nothing here is specific to one device.
---
--- a/gfx/common/vulkan_common.c
+++ b/gfx/common/vulkan_common.c
@@ -1361,6 +1361,7 @@
 static bool vulkan_update_display_mode(
       unsigned *width,
       unsigned *height,
+      unsigned *rate,
       const VkDisplayModePropertiesKHR *mode,
       const struct vulkan_display_surface_info *info)
 {
@@ -1387,14 +1388,24 @@
       int old_delta_x       = (int)info->width  - (int)*width;
       int old_delta_y       = (int)info->height - (int)*height;
       int delta_rate        = abs((int)info->refresh_rate_x1000 - (int)visible_rate);
+
+      int old_delta_rate    = abs((int)info->refresh_rate_x1000 - (int)*rate);
 
       int dist              = delta_x     * delta_x     + delta_y     * delta_y;
       int old_dist          = old_delta_x * old_delta_x + old_delta_y * old_delta_y;
 
-      if (dist < old_dist && delta_rate < 1000)
+      /* Among modes of the same size, the one closest to the requested
+       * rate, not the first within 1 Hz of it. A panel can carry two modes
+       * a fraction of a hertz apart - 119.880 and 119.635, twice NTSC and
+       * twice PlayStation 240p - and both are inside that window, so
+       * taking the first made the second unreachable. */
+      if (delta_rate < 1000
+            && (dist < old_dist
+               || (dist == old_dist && delta_rate < old_delta_rate)))
       {
          *width       = visible_width;
          *height      = visible_height;
+         *rate        = visible_rate;
          return true;
       }
    }
@@ -1418,6 +1429,7 @@
    uint32_t best_plane                       = UINT32_MAX;
    VkDisplayPlaneAlphaFlagBitsKHR alpha_mode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
    VkDisplayModeKHR best_mode                = VK_NULL_HANDLE;
+   unsigned best_rate                        = 0;
    /* Monitor index starts on 1, 0 is auto. */
    unsigned monitor_index                    = info->monitor_index;
    unsigned saved_width                      = *width;
@@ -1488,7 +1500,7 @@
       for (i = 0; i < mode_count; i++)
       {
          const VkDisplayModePropertiesKHR *mode = &modes[i];
-         if (vulkan_update_display_mode(width, height, mode, info))
+         if (vulkan_update_display_mode(width, height, &best_rate, mode, info))
             best_mode = modes[i].displayMode;
       }
 
