diff --git a/retroarch.c b/retroarch.c
--- a/retroarch.c
+++ b/retroarch.c
@@ -1628,6 +1628,23 @@
 
    DRIVER_FLAGS_NORMALIZE(flags);
 
+   /* On the variable refresh path a frame is shown for a whole number of
+    * refreshes, each no shorter than the panel's fastest: twice for 45 to
+    * 60 Hz content on a 120 Hz panel. Content that does not fit twice -
+    * a few arcade boards at 60.1 to 63 Hz against 120.198 - has no
+    * multiple in range, and locking it to the display would take vsync.
+    * It is refused instead. */
+   if (     config_vrr_path()
+         && video_st->av_info.timing.fps > 0.0
+         && settings->floats.video_refresh_rate > 0.0f
+         && video_st->av_info.timing.fps * 2.0
+            > (double)settings->floats.video_refresh_rate * 1.0001)
+   {
+      RARCH_LOG("[Video] %.3f fps does not fit twice into %.3f Hz, refused.\n",
+            video_st->av_info.timing.fps, settings->floats.video_refresh_rate);
+      runloop_refuse_content();
+   }
+
    /* Content av_info based automatic swap interval must be set early. */
    runloop_set_video_swap_interval(settings);
 
@@ -5244,6 +5261,8 @@
 #endif
       case CMD_EVENT_MENU_RESET_TO_DEFAULT_CONFIG:
          config_set_defaults(global_get_ptr(), config_get_ptr());
+         /* The defaults have vsync on and the exact-rate loop off. */
+         config_no_vsync(config_get_ptr());
          break;
       case CMD_EVENT_MENU_SAVE_CURRENT_CONFIG:
          /* Same as at quit: the companion's live layout first. */
@@ -6173,19 +6192,7 @@
          }
          break;
       case CMD_EVENT_VRR_RUNLOOP_TOGGLE:
-         {
-            const char *_msg = msg_hash_to_str(
