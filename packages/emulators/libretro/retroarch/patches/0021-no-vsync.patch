@@ -9712,6 +9713,22 @@ static void runloop_gpu_device_lost(runloop_state_t *runloop_st)
    command_event(CMD_EVENT_REINIT, &reinit_flags);
 }
 
+/* Content refused by drivers_init (0021): the core never runs; the message
+ * shows for three seconds over a paused, empty frame, then RetroArch quits
+ * back to the launcher. */
+static retro_time_t runloop_refused_until = 0;
+
+void runloop_refuse_content(void)
+{
+   const char *_msg = "This game is not supported";
+   if (runloop_refused_until)
+      return;
+   runloop_refused_until  = cpu_features_get_time_usec() + 3000000;
+   runloop_state.flags   |= RUNLOOP_FLAG_PAUSED;
+   runloop_msg_queue_push(_msg, strlen(_msg), 1, 180, true, NULL,
+         MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_ERROR);
+}
+
 int runloop_iterate(void)
 {
    retro_time_t pace_limit_min;
@@ -9770,6 +9787,17 @@ int runloop_iterate(void)
       return 1;
    }
 
+   if (runloop_refused_until)
+   {
+      runloop_st->flags |= RUNLOOP_FLAG_PAUSED;
+      core_paused        = true;
+      if (current_time >= runloop_refused_until)
+      {
+         runloop_refused_until = 0;
+         command_event(CMD_EVENT_QUIT, NULL);
+      }
+   }
+
    /* A video driver that lost its GPU device - a TDR on Windows, a GPU
     * reset elsewhere - sets this from whichever thread saw it, and
     * nothing it does on that device works from then on: every frame
