-static void video_driver_reinit_context(settings_t *settings, int flags)
+static void video_driver_reinit_context(settings_t *settings, int flags,
+      void (*between)(void *data), void *between_data)
 {
    /* RARCH_DRIVER_CTL_UNINIT clears the callback struct so we
     * need to make sure to keep a copy */
@@ -7224,6 +7225,9 @@
 
    driver_uninit(flags, DRIVER_LIFETIME_RESET);
 
+   if (between)
+      between(between_data);
+
    memcpy(hwr, &hwr_copy, sizeof(*hwr));
    video_st->hw_render_context_negotiation = iface;
 
@@ -7242,8 +7246,25 @@
    else
       video_driver_modify_disp_flags(0, VIDEO_FLAG_CACHE_CONTEXT);
    video_driver_cache_context_ack_clear();
-   video_driver_reinit_context(settings, flags);
+   video_driver_reinit_context(settings, flags, NULL, NULL);
    video_driver_modify_disp_flags(0, VIDEO_FLAG_CACHE_CONTEXT);
+
+   video_st->window_title_prev[0]          = '\0';
+}
+
+/* Like video_driver_reinit, but runs between() while the drivers are
+ * down, and never keeps the context: a cached Vulkan instance would
+ * keep the display, and between() is there to hand the display to
+ * another process. */
+void video_driver_reinit_around(int flags,
+      void (*between)(void *data), void *between_data)
+{
+   settings_t *settings                    = config_get_ptr();
+   video_driver_state_t *video_st          = &video_driver_st;
+
+   video_driver_modify_disp_flags(0, VIDEO_FLAG_CACHE_CONTEXT);
+   video_driver_cache_context_ack_clear();
+   video_driver_reinit_context(settings, flags, between, between_data);
 
    video_st->window_title_prev[0]          = '\0';
 }
