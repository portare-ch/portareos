diff --git a/src/core/system.h b/src/core/system.h
index 7d7987b..2b0a983 100644
--- a/src/core/system.h
+++ b/src/core/system.h
@@ -149,4 +149,11 @@ void ClearMemorySaveStates();
 void UpdateMemorySaveStateSettings();
 void SetRunaheadReplayFlag();
 
+/// States the libretro frontend takes for its own run-ahead and preemptive
+/// frames (RETRO_SAVESTATE_CONTEXT_RUNAHEAD_SAME_INSTANCE). VRAM stays on the
+/// GPU, as in the core's own memory states, keyed by the frontend's buffer.
+bool SaveFrontendRunaheadState(const void* key, ByteStream* state);
+bool LoadFrontendRunaheadState(ByteStream* state);
+bool IsFrontendRunaheadState(const void* data, size_t size);
+
 } // namespace System
diff --git a/src/libretro/libretro_host_interface.cpp b/src/libretro/libretro_host_interface.cpp
index a0613fb..c9e3bda 100644
--- a/src/libretro/libretro_host_interface.cpp
+++ b/src/libretro/libretro_host_interface.cpp
@@ -927,9 +927,29 @@ size_t HostInterface::retro_serialize_size()
   return System::MAX_SAVE_STATE_SIZE;
 }
 
+static retro_savestate_context GetSavestateContext()
+{
+  retro_savestate_context ctx = RETRO_SAVESTATE_CONTEXT_NORMAL;
+  if (!g_retro_environment_callback(RETRO_ENVIRONMENT_GET_SAVESTATE_CONTEXT, &ctx))
+    return RETRO_SAVESTATE_CONTEXT_NORMAL;
+  return ctx;
+}
+
 bool HostInterface::retro_serialize(void* data, size_t size)
 {
   std::unique_ptr<ByteStream> stream = ByteStream_CreateMemoryStream(data, static_cast<uint32_t>(size));
+
+  // Run-ahead and preemptive frames save a state every frame and load it
+  // back in this process. The full path reads VRAM back, which waits for the
+  // GPU to finish everything queued, the frame's upscaled rendering included;
+  // these keep it on the GPU instead.
+  if (GetSavestateContext() == RETRO_SAVESTATE_CONTEXT_RUNAHEAD_SAME_INSTANCE)
+  {
+    if (System::SaveFrontendRunaheadState(data, stream.get()))
+      return true;
+    stream->SeekAbsolute(0);
+  }
+
   return System::SaveState(stream.get());
 }
 
@@ -952,6 +972,9 @@ bool HostInterface::retro_unserialize(const void* data, size_t size)
   }
 
   std::unique_ptr<ByteStream> stream = ByteStream_CreateReadOnlyMemoryStream(data, static_cast<uint32_t>(size));
+  if (ctx == RETRO_SAVESTATE_CONTEXT_RUNAHEAD_SAME_INSTANCE && System::IsFrontendRunaheadState(data, size))
+    return System::LoadFrontendRunaheadState(stream.get());
+
   return System::LoadState(stream.get(), is_memory_state);
 }
 
