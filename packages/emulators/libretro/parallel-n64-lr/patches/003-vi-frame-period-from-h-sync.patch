From: PortareOS <hello@portare.org>
Subject: [PATCH] vi: the frame period from V_SYNC and H_SYNC, as the console has it

The VI's frame period was (clock / 60) / (V_SYNC + 1) counts per half-line,
truncated, times V_SYNC + 1: a nominal 60 Hz frame cut into the game's line
count, with H_SYNC ignored. A standard NTSC game came out at 60.0176 Hz,
0.32% faster than the console, and reported that to the frontend.

A real N64 runs a line of H_SYNC + 1 VI clocks (0xC15 + 1 = 3094 for NTSC,
the 15734 Hz line rate) and a frame of V_SYNC + 1 half-lines, so a standard
frame is 526 x 3094 / 2 = 813722 clocks: 59.826 Hz in 240p, 59.94 Hz
interlaced, 49.92 Hz PAL. Compute the period from the two registers, and
recompute it when H_SYNC is written after V_SYNC. Before a game programs
H_SYNC, the standard line for the region is assumed; the libretro fallback
before V_SYNC uses the same numbers.

Audio needs no change: the AI DMA duration already counts in VI clocks.

For PortareOS this lets the panel run at exactly twice the console's rate
(119.652 Hz) with one game frame per two refreshes, instead of a mode that
fits the emulator's old approximation.
diff --git a/libretro/libretro.c b/libretro/libretro.c
index 5394a3dc..eb48aee0 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -1258,10 +1258,14 @@ void retro_get_system_av_info(struct retro_system_av_info *info)
 
       if (fps <= 0.0)
       {
-         const unsigned int clock = vi_clock_from_tv_standard(region);
-         const unsigned int rr    = vi_expected_refresh_rate_from_tv_standard(region);
-         const unsigned int vsync = (region == SYSTEM_PAL) ? 625u : 525u;
-         const unsigned int delay = vsync * ((clock / rr) / vsync);
+         /* The standard frame for the region, as vi_update_frame_period()
+          * computes it once the game has programmed V_SYNC and H_SYNC:
+          * V_SYNC + 1 half-lines of (H_SYNC + 1) / 2 VI clocks. */
+         const unsigned int clock  = vi_clock_from_tv_standard(region);
+         const unsigned int rr     = vi_expected_refresh_rate_from_tv_standard(region);
+         const unsigned int vsync  = (region == SYSTEM_PAL) ? 0x271u : 0x20du;
+         const unsigned int hsync  = (region == SYSTEM_PAL) ? 0xc69u : 0xc15u;
+         const unsigned int delay  = ((vsync + 1u) * (hsync + 1u)) / 2u;
 
          fps = (delay != 0) ? (double)clock / (double)delay : (double)rr;
       }
diff --git a/mupen64plus-core/src/device/rcp/vi/vi_controller.c b/mupen64plus-core/src/device/rcp/vi/vi_controller.c
index 84e56472..49d14b63 100644
--- a/mupen64plus-core/src/device/rcp/vi/vi_controller.c
+++ b/mupen64plus-core/src/device/rcp/vi/vi_controller.c
@@ -57,21 +57,46 @@ unsigned int vi_expected_refresh_rate_from_tv_standard(m64p_system_type tv_stand
     }
 }
 
-/* The refresh rate the VI is actually being emulated at, in Hz.
- *
- * The frame period is vi->delay counts of the VI clock, and delay is derived
- * from the game's programmed V_SYNC:
- *
- *   count_per_scanline = (clock / expected_refresh_rate) / (V_SYNC + 1)
- *   delay              = (V_SYNC + 1) * count_per_scanline
- *
- * The integer division in the first step truncates, so delay lands slightly
- * under clock/expected_refresh_rate and the emulated rate lands slightly
- * over the nominal 60 or 50 - for a standard NTSC V_SYNC of 0x20D that is
- * 48681812 / 811125 = 60.0176 Hz, not 60.
+/* One VI line is H_SYNC + 1 counts of the VI clock: the register holds the
+ * line length minus one, 0xC15 = 3093 for NTSC and 0xC69 = 3177 for PAL,
+ * which is the 15734 Hz and 15625 Hz line rate of the standards. Before a
+ * game programs it, the standard line for the region is assumed. */
+static unsigned int vi_line_counts(const struct vi_controller* vi)
+{
+    unsigned int h_sync = vi->regs[VI_H_SYNC_REG] & 0xfff;
+
+    if (h_sync == 0)
+        h_sync = (vi->expected_refresh_rate == 50) ? 0xc69 : 0xc15;
+
+    return h_sync + 1;
+}
+
+/* The frame period, in counts of the VI clock, from what the game programmed:
+ * V_SYNC + 1 half-lines of (H_SYNC + 1) / 2 counts each. For a standard NTSC
+ * frame that is 526 x 3094 / 2 = 813722 counts, 59.826 Hz, which is what the
+ * console does and what a display matched to it has to be told. Interlaced
+ * output (V_SYNC = 0x20C, 525 half-lines) comes out at 59.94 Hz the same way.
  *
- * Returns 0 before the game has programmed V_SYNC, when there is no frame
- * period to report yet. */
+ * This used (clock / expected_refresh_rate) / (V_SYNC + 1) per half-line,
+ * i.e. a nominal 60 or 50 Hz frame cut into the game's line count, which put
+ * NTSC at 60.0176 Hz - 0.32% fast - and ignored H_SYNC altogether. */
+static void vi_update_frame_period(struct vi_controller* vi)
+{
+    uint32_t half_lines = vi->regs[VI_V_SYNC_REG] + 1;
+
+    if (CountPerScanlineOverride) {
+        vi->count_per_scanline = CountPerScanlineOverride;
+        vi->delay = half_lines * vi->count_per_scanline;
+        return;
+    }
+
+    vi->delay = (half_lines * vi_line_counts(vi)) / 2;
+    vi->count_per_scanline = vi->delay / half_lines;
+}
+
+/* The refresh rate the VI is actually being emulated at, in Hz: the VI
+ * clock over the frame period. Returns 0 before the game has programmed
+ * V_SYNC, when there is no frame period to report yet. */
 double vi_actual_refresh_rate(const struct vi_controller* vi)
 {
     if (vi == NULL || vi->delay == 0)
@@ -167,16 +192,23 @@ void write_vi_regs(void* opaque, uint32_t address, uint32_t value, uint32_t mask
         if ((vi->regs[VI_V_SYNC_REG] & mask) != (value & mask))
         {
             masked_write(&vi->regs[VI_V_SYNC_REG], value, mask);
-            if(!CountPerScanlineOverride) {
-                vi->count_per_scanline = (vi->clock / vi->expected_refresh_rate) / (vi->regs[VI_V_SYNC_REG] + 1);
-            } else {
-                vi->count_per_scanline = CountPerScanlineOverride;
-            }
-            vi->delay = (vi->regs[VI_V_SYNC_REG] + 1) * vi->count_per_scanline;
+            vi_update_frame_period(vi);
             set_vi_vertical_interrupt(vi);
         }
         return;
 
+    case VI_H_SYNC_REG:
+        if ((vi->regs[VI_H_SYNC_REG] & mask) != (value & mask))
+        {
+            masked_write(&vi->regs[VI_H_SYNC_REG], value, mask);
+            /* The line length is part of the frame period; a V_SYNC already
+             * programmed is recomputed against it. The interrupt already
+             * scheduled keeps its time, the next one uses the new period. */
+            if (vi->regs[VI_V_SYNC_REG] != 0)
+                vi_update_frame_period(vi);
+        }
+        return;
+
     case VI_V_INTR_REG:
         masked_write(&vi->regs[VI_V_INTR_REG], value, mask);
         set_vi_vertical_interrupt(vi);
