From: PortareOS <hello@portare.org>
Subject: [PATCH] Default to 32 kHz audio output

PortareOS measures its audio path at 32 kHz, where the period step is
exactly 10 ms. Add 32 kHz to the core option and its validator, and use it
when the core initializes. Upstream now reports the selected sample
rate to RetroArch.
--- a/Libretro/libretro.cpp
+++ b/Libretro/libretro.cpp
@@ -80,7 +80,8 @@
 static string _mesenVersion = "";
 static int32_t _saveStateSize = -1;
 static bool _shiftButtonsClockwise = false;
-static int32_t _audioSampleRate = 44100;
+static constexpr int32_t DefaultAudioSampleRate = 32000;
+static int32_t _audioSampleRate = DefaultAudioSampleRate;
 
 //Include game database as a byte array (representing the MesenDB.txt file)
 #include "MesenDB.inc"
@@ -532,7 +533,7 @@
 
 	RETRO_API void retro_init()
 	{
-		_audioSampleRate = 44100;
+		_audioSampleRate = DefaultAudioSampleRate;
 
 		struct retro_log_callback log;
 		if(env_cb(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log)) {
@@ -723,8 +724,8 @@
 				{{ "disabled", "Off" }, { "enabled", "On" }, { NULL, NULL }},
 				"disabled" },
 			{ MesenAudioSampleRate, "Audio - Sample Rate", "Sample Rate", "Audio output sample rate", NULL, "audio",
-				{{ "48000", "48000 Hz" }, { "96000", "96000 Hz" }, { "11025", "11025 Hz" }, { "22050", "22050 Hz" }, { "44100", "44100 Hz" }, { NULL, NULL }},
-				"44100" },
+				{{ "48000", "48000 Hz" }, { "96000", "96000 Hz" }, { "11025", "11025 Hz" }, { "22050", "22050 Hz" }, { "32000", "32000 Hz" }, { "44100", "44100 Hz" }, { NULL, NULL }},
+				"32000" },
 
 			// SNES options
 			{ MesenSnesColorCorrection, "Video - SNES Color Correction", "Color Correction", "Select SNES color correction mode", NULL, "video",
@@ -1600,7 +1601,7 @@
 		audioCfg.SampleRate = _audioSampleRate;
 		if(readVariable(MesenAudioSampleRate, var)) {
 			int requestedRate = atoi(var.value);
-			if(requestedRate == 11025 || requestedRate == 22050 || requestedRate == 44100 ||
-				requestedRate == 48000 || requestedRate == 96000) {
+			if(requestedRate == 11025 || requestedRate == 22050 || requestedRate == DefaultAudioSampleRate ||
+				requestedRate == 44100 || requestedRate == 48000 || requestedRate == 96000) {
 				audioCfg.SampleRate = requestedRate;
 			}
