# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

tocon "Starting services..."

for SERVICE in /usr/lib/autostart/daemons/*
do
  # Each file sets what it needs and nothing else: 004-tailscaled sets no
  # CONF, so without this it inherited sshd.conf from 001-ssh and the "remove
  # the old marker" step below deleted the SSH marker that had just been
  # created - a moment before systemd checked for it. That was SSH off after
  # every boot, whatever ssh.enabled said.
  unset STATE SVC CONF DAEMONS
  source ${SERVICE}


  if [ ! -d "/storage/.cache/services" ]
  then
    mkdir -p "/storage/.cache/services"
  fi

  if [ -n "${CONF}" ] && \
     [ -e "/storage/.cache/services/${CONF}" ]
  then
    rm -f "/storage/.cache/services/${CONF}"
  fi

  statemgr() {
    for daemon in ${DAEMONS[@]}
    do
      nohup systemctl ${1} ${daemon} &
    done
  }

  case "$STATE" in
    "1")
      touch "/storage/.cache/services/${CONF}"
      statemgr start
    ;;
    *)
      statemgr stop
    ;;
  esac
done
