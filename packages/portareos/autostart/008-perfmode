# Minimal OS variable loading for performance
. /etc/profile.d/001-functions
. /etc/profile.d/099-freqfunctions

tocon "Setting performance mode..."

### Enable the desired number of threads.
tocon "Restoring cpu threads..."
NUMTHREADS=$(get_setting "system.threads")
if [ -n "${NUMTHREADS}" ]; then
  onlinethreads ${NUMTHREADS} 0
else
  onlinethreads all 1
fi

### Pick a default governor if none is set. schedutil first: it is driven by
### the scheduler's own utilisation signal, where ondemand samples on a timer
### and knows nothing about what the scheduler is doing. On this big.LITTLE
### part ondemand parked the little cluster at 2016000 kHz on an otherwise
### idle system, and the little cluster is where irqaffinity=0-2 sends every
### interrupt. Switching to schedutil dropped it to 556800 kHz.
if [ -z "$(get_setting system.cpugovernor)" ]; then
  AVAILABLE="$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors 2>/dev/null)"
  for GOV in schedutil ondemand performance; do
    case " ${AVAILABLE} " in
      *" ${GOV} "*)
        set_setting system.cpugovernor ${GOV}
        break
        ;;
    esac
  done
fi

### Set the GPU performance mode. When nothing is configured, still put the
### governor back to auto rather than leaving it wherever the last boot left
### it. Suspend sets it to powersave and only the resume hook undoes that, so a
### boot that inherits a latched powersave otherwise keeps the GPU at its
### lowest operating point with no other writer to correct it.
GPUPERF=$(get_setting system.gpuperf)
if [ -n "${GPUPERF}" ]; then
  gpu_performance_level ${GPUPERF}
else
  gpu_performance_level auto
fi
