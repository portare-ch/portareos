# Back to stock: every setting goes, what the player has stays.
#
#   factoryreset         flag the reset and restart into it
#   factoryreset --wipe  the reset itself, run by factory-reset.service
#
# Stays: the games, BIOS, saves and states (roms, games-internal,
# games-external), a staged update, favourites and recently played, the
# play history, and Steam as installed - its x86 RootFS is a 4 GB download
# and its games and own settings are in roms. Everything else under
# /storage goes, the Wi-Fi networks and SSH keys with it; first boot then
# sets the device up from /usr/config as on a new install.
#
# The wipe runs in a boot of its own: the initramfs sees the flag and starts
# factory-reset.target instead of the system, so nothing is running that
# could write a setting back between the wipe and the restart.

FLAG="/storage/.cache/reset_oe"

# Removes everything in a directory but the names given, never crossing
# into a mount.
keep_only() {
  local dir="${1}" entry name kept k
  shift
  for entry in "${dir}"/* "${dir}"/.[!.]* "${dir}"/..?*; do
    [ -e "${entry}" ] || [ -L "${entry}" ] || continue
    name="${entry##*/}"
    kept=0
    for k in "$@"; do
      [ "${name}" = "${k}" ] && kept=1
    done
    [ "${kept}" = 1 ] && continue
    mountpoint -q "${entry}" && continue
    # BusyBox rm has no --one-file-system; find stays on this one.
    find "${entry}" -xdev -depth -delete
  done
}

case "${1}" in
  "")
    mkdir -p "${FLAG%/*}"
    touch "${FLAG}"
    sync
    systemctl reboot
  ;;
  "--wipe")
    # First, so a failure below restarts into the system, not into this.
    rm -f "${FLAG}" /storage/.cache/reset_xbmc
    sync
    keep_only /storage roms games-internal games-external .update lost+found \
              .config playlists .steam .local
    keep_only /storage/.config portarelauncher
    keep_only /storage/.local share
    keep_only /storage/.local/share Steam fex-emu applications
    sync
  ;;
  *)
    echo "usage: factoryreset [--wipe]" >&2
    exit 2
  ;;
esac
