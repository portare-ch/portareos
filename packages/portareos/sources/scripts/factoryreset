# Back to a fresh install, to find or rule out a regression on one.
#
#   factoryreset         flag the reset and restart into it
#   factoryreset --wipe  the reset itself, run by factory-reset.service
#
# Stays: the roms folder (roms, games-internal, games-external) - games,
# BIOS and what is saved beside them - and Wi-Fi, so the device is still
# on the network. Everything else under /storage goes, Steam, favourites
# and SSH keys with it; first boot then sets the device up from
# /usr/config as on a new install.
#
# The wipe runs in a boot of its own: the initramfs sees the flag and starts
# factory-reset.target instead of the system, so nothing is running that
# could write a setting back between the wipe and the restart.

FLAG="/storage/.cache/reset_oe"
CFG="/storage/.config/system/configs/system.cfg"

# Removes everything in a directory but the names given, never crossing
# into a mount.
keep_only() {
  local dir="${1}" entry name kept k
  shift
  for entry in "${dir}"/* "${dir}"/.[!.]* "${dir}"/..?*; do
    [ -e "${entry}" ] || [ -L "${entry}" ] || continue
    name="${entry##*/}"
    kept=0
    for k in "$@"; do
      [ "${name}" = "${k}" ] && kept=1
    done
    [ "${kept}" = 1 ] && continue
    mountpoint -q "${entry}" && continue
    # BusyBox rm has no --one-file-system; find stays on this one.
    find "${entry}" -xdev -depth -delete
  done
}

case "${1}" in
  "")
    mkdir -p "${FLAG%/*}"
    touch "${FLAG}"
    sync
    systemctl reboot
  ;;
  "--wipe")
    # First, so a failure below restarts into the system, not into this.
    rm -f "${FLAG}" /storage/.cache/reset_xbmc
    sync
    # Wi-Fi: iwd's known networks, and the wifi.* keys over the image's
    # system.cfg. First boot copies /usr/config without overwriting, so
    # the system.cfg written here is the one it keeps.
    wifi="$(grep '^wifi\.' "${CFG}" 2>/dev/null)"
    keep_only /storage roms games-internal games-external lost+found .cache
    keep_only /storage/.cache iwd
    if [ -n "${wifi}" ]; then
      mkdir -p "${CFG%/*}"
      grep -v '^wifi\.' /usr/config/system/configs/system.cfg >"${CFG}"
      printf '%s\n' "${wifi}" >>"${CFG}"
    fi
    sync
  ;;
  *)
    echo "usage: factoryreset [--wipe]" >&2
    exit 2
  ;;
esac
