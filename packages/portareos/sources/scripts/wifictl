#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2022 kkoshelev (https://github.com/kkoshelev)
# Wi-Fi via iwd, through portnet. AP/netplay uses iwctl on the interface.

. /etc/profile

PORTNET="$(command -v portnet 2>/dev/null)"

###
### Basic WIFI properties used across the tool.
###
### Usage:
###     wifictl command [ssid] [psk]
###

IWD_AP_CFG_DIR="/storage/.cache/iwd/ap"
WIFI_TYPE=$(get_setting wifi.adhoc.enabled)
NETWORK_ADDRESS="192.168.80"
ADHOC_CLIENT_ID=$(get_setting wifi.adhoc.id)
WIFI_DEV="$(ls /sys/class/net | grep -m1 ^wlan)"
DEFAULT_CHAN="6"

# Exit the script if the WiFi device isn't available
[ -z "${WIFI_DEV}" ] && exit 0
[ ! -d "/sys/class/net/${WIFI_DEV}" ] && exit 0
[ -z "${PORTNET}" ] && exit 0

SSID="${2:-$(get_setting wifi.ssid 2>/dev/null)}"
PSK="${3:-$(get_setting wifi.key 2>/dev/null)}"

if [ "${WIFI_TYPE}" = "1" ]; then
  SSID="NETPLAY_AP"
  PSK="deadbeef"
fi

ADHOC_CHAN=$(get_setting wifi.adhoc.channel)
if [ -z "${ADHOC_CHAN}" ]; then
  ADHOC_CHAN="${DEFAULT_CHAN}"
  set_setting wifi.adhoc.channel ${DEFAULT_CHAN}
fi

###
### Functions...
###

# Wait for iwd to start and have a device available
wait_for_wifi() {
  for i in $(seq 1 5); do
    iwctl device list | grep -q "${WIFI_DEV}" && break
    sleep 1
  done
  # The regulatory domain follows the timezone's country.
  /usr/lib/iw/setregdomain
}

# lists all wifi networks
list_wifi() {
  wait_for_wifi
  # portnet waits for the scan itself, so there is nothing to sleep on.
  "${PORTNET}" list --rescan 2>/dev/null | cut -f1 | sed '/^$/d' | sort -u
}

connect_wifi() {
  wait_for_wifi
  # Already on it: iwd reconnects to a known network by itself, so this is
  # often true before anything is asked of it.
  [ "$("${PORTNET}" status 2>/dev/null)" = "${SSID}" ] && return 0

  # One scan so the network is there to connect to. The stale-profile
  # delete the NetworkManager version did here has no equivalent: iwd
  # writes credentials only after the association succeeds, so there is no
  # half-written profile to trip over.
  "${PORTNET}" list --rescan >/dev/null 2>&1

  if [ -n "${PSK}" ]; then
    "${PORTNET}" join "${SSID}" "${PSK}" >/dev/null 2>&1
  else
    "${PORTNET}" connect "${SSID}" >/dev/null 2>&1
  fi
}

create_adhoc() {
  wait_for_wifi

  # Create an iwd AP profile file
  mkdir -p "${IWD_AP_CFG_DIR}"
  cat <<EOF >"${IWD_AP_CFG_DIR}/${SSID}.ap"
[General]
Channel=${ADHOC_CHAN}
DisableHT=true

[Security]
Passphrase=${PSK}

[IPv4]
Address=${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}
Netmask=255.255.255.0
Gateway=${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}
EOF

  iwctl device ${WIFI_DEV} set-property Mode ap
  # Start the AP profile
  iwctl ap ${WIFI_DEV} start-profile "${SSID}" 2>/dev/null
}

destroy_adhoc() {
  iwctl ap ${WIFI_DEV} stop 2>/dev/null
  rm -f "${IWD_AP_CFG_DIR}/${SSID}.ap" 2>/dev/null
}

# Nothing to do any more, and kept only because sleep.sh calls it.
#
# This used to raise NetworkManager's autoconnect-priority on the network
# in use, so that a resume - where the radio comes back with only an rfkill
# unblock - rejoined the same access point instead of whichever saved
# profile NetworkManager tried first, which could silently move the device
# to another subnet.
#
# iwd ranks its known networks by when each was last connected, so the one
# in use is already the one it tries first. The behaviour this bought is
# now the default.
pin_wifi() {
  return 0
}

has_ap_mode() {
  wait_for_wifi

  PHY=$(basename "$(readlink /sys/class/net/${WIFI_DEV}/phy80211)")
  if iwctl adapter "$PHY" show | grep -q 'SupportedModes.*ap'; then
    exit 0
  else
    exit 1
  fi
}

case "${1}" in
  enable)
    rfkill unblock wifi
    ;;
  disable)
    rfkill block wifi
    ;;
  pin)
    pin_wifi
    ;;
  connect)
    if [ "${WIFI_TYPE}" = "1" ] && \
       [ "${ADHOC_CLIENT_ID}" = "1" ]; then
      create_adhoc >/dev/null 2>&1
    else
      destroy_adhoc >/dev/null 2>&1
      connect_wifi >/dev/null 2>&1
    fi
  ;;
  disconnect)
    if [ "${WIFI_TYPE}" = "1" ]; then
      destroy_adhoc >/dev/null 2>&1
      iwctl ap ${WIFI_DEV} stop 2>/dev/null
    else
      "${PORTNET}" disconnect >/dev/null 2>&1
    fi
    ;;
  reconnect)
    /usr/bin/wifictl disconnect
    /usr/bin/wifictl connect
    ;;
  list)
    list_wifi
    ;;
  channels)
    iw list | awk '/[0-9] MHz \[/ && ! /disabled|radar|no IR/ { gsub(/^.*\[/,""); gsub(/\].*$/,""); print}'
    ;;
  has_ap_mode)
    has_ap_mode
    ;;
  scan)
    "${PORTNET}" list --rescan >/dev/null 2>&1
    ;;
  scanlist)
    list_wifi
    ;;
esac
