# Source minimal predefined functions and variables
# to ensure as much performance as possible.
. /etc/profile.d/001-functions

VOLUME=$(get_setting "audio.volume")
MAX_VOLUME=100
MIN_VOLUME=0
STEP=5

case ${1} in
  "+"|"up")
    VOLUME=$(( ${VOLUME} + ${STEP} ))
  ;;
  "-"|"down")
    VOLUME=$(( ${VOLUME} - ${STEP} ))
  ;;
  "restore")
    true
  ;;
  *)
    VOLUME=${1}
  ;;
esac

if (( ${VOLUME} < ${MIN_VOLUME} ))
then
  VOLUME=${MIN_VOLUME}
elif (( ${VOLUME} > ${MAX_VOLUME} ))
then
  VOLUME=${MAX_VOLUME}
elif [ -z "${VOLUME}" ]
then
  VOLUME=50
fi

# wpctl applies the cubic curve itself, the same one EmulationStation uses for
# its slider, so it takes the plain fraction. Cubing it here as well put 30% at
# -94 dB.
wpctl set-volume @DEFAULT_AUDIO_SINK@ "$(awk -v v="${VOLUME}" 'BEGIN { printf "%.2f", v / 100 }')"
set_setting "audio.volume" ${VOLUME}