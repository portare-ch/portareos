#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026-present PortareOS (https://github.com/portare-ch)

# One folder per system, named for the US console (#756). The regional
# aliases, ROM-hack collections and add-ons inherited from EmulationStation
# are gone: their games run on the kept system with the same core.
#
# This moves an older install over, from post-update: the games and the
# files beside them, the save states, the settings in system.cfg,
# RetroArch's per-folder files and the launcher's lists. File by file and
# never overwriting: a file whose place is taken stays where it was and is
# logged, unless it is the same file, which goes. A run that is cut off
# picks up where it stopped, and once all is moved it finds nothing to do.
# An emptied old folder goes, as does any empty folder in /storage/roms
# that the image no longer makes.
#
#   system-merge [storage root]     (default /storage; tests pass another)

ROOT="${1:-/storage}"
ROMS="${ROOT}/roms"
SYSCFG="${ROOT}/.config/system/configs/system.cfg"
LISTS="${ROOT}/.config/portarelauncher"
SYSTEM_DIRS="${SYSTEM_DIRS:-/usr/config/system-dirs.conf}"

# The old system, its folder, and the system it joins (whose folder has its
# name).
MERGES="
megadrive        megadrive        genesis
megadrive-japan  megadrive-japan  genesis
genh             genh             genesis
megadriveh       megadriveh       genesis
sfc              sfc              snes
snesh            snesh            snes
satellaview      satellaview      snes
snesmsu1         snesmsu1         snes
famicom          famicom          nes
fds              fds              nes
megacd           megacd           segacd
ggh              gamegearh        gamegear
gbh              gbh              gb
gbch             gbch             gbc
gbah             gbah             gba
gbav             gbav             gba
n64dd            n64dd            n64
pspminis         pspminis         psp
wiiware          wiiware          wii
triforce         triforce         gamecube
"

log() {
  echo "system-merge: $*"
}

# src to dst, a file's full path, unless dst is taken. Across filesystems
# (the games on a card, or an overlay) the copy is made as dst.part and
# renamed once whole: a cut-off move never leaves part of a game under the
# real name.
move() {
  local src="$1" dst="$2"
  [ -e "${src}" ] || [ -L "${src}" ] || return 0
  if [ -e "${dst}" ] || [ -L "${dst}" ]; then
    if [ -f "${src}" ] && [ ! -L "${src}" ] && [ ! -L "${dst}" ] && cmp -s "${src}" "${dst}"; then
      rm -f "${src}"
      return 0
    fi
    log "kept ${src}: ${dst} is taken"
    return 1
  fi
  mkdir -p "${dst%/*}"
  rm -f "${dst}.part"
  if [ "$(stat -c %d "${src}")" = "$(stat -c %d "${dst%/*}")" ]; then
    mv "${src}" "${dst}"
  else
    cp -a "${src}" "${dst}.part" && sync && mv "${dst}.part" "${dst}" && rm -f "${src}"
  fi
}

# The files under src into dst at the same relative paths, so cue sheets,
# playlists and the cores' folders beside the games still resolve. The
# emptied folders go.
move_tree() {
  local src="$1" dst="$2" f
  [ -d "${src}" ] && [ ! -L "${src}" ] || return 0
  while IFS= read -r -d '' f; do
    move "${f}" "${dst}/${f#${src}/}"
  done < <(find "${src}" -mindepth 1 \( -type f -o -type l \) -print0)
  find "${src}" -depth -mindepth 1 -type d -empty -delete 2>/dev/null
  rmdir "${src}" 2>/dev/null || log "left in ${src}: $(ls -A "${src}" | tr '\n' ' ')"
  return 0
}

### The games, the save states and RetroArch's per-folder files: core
### overrides and options (config/<core>/<folder>.cfg|.opt) and remaps
### (remappings/<core>/<folder>.rmp).
files() {
  local old dir new d
  while read -r old dir new; do
    [ -n "${old}" ] || continue
    move_tree "${ROMS}/${dir}" "${ROMS}/${new}"
    move_tree "${ROMS}/savestates/${old}" "${ROMS}/savestates/${new}"
    for d in "${ROOT}"/.config/retroarch/config/*/; do
      move "${d}${dir}.cfg" "${d}${new}.cfg"
      move "${d}${dir}.opt" "${d}${new}.opt"
    done
    for d in "${ROOT}"/remappings/*/; do
      move "${d}${dir}.rmp" "${d}${new}.rmp"
    done
  done <<<"${MERGES}"
}

### system.cfg: <old>.<key> and <old>["game"].<key> become <new>.<...>. A
### key the kept system already has wins, and the old one goes, logged.
settings() {
  local to
  [ -f "${SYSCFG}" ] || return 0
  to=$(awk 'NF == 3 { printf "%s=%s ", $1, $3 }' <<<"${MERGES}")
  awk -v to="${to}" '
    function sys(k) { return match(k, /^[^.[]+/) ? substr(k, 1, RLENGTH) : "" }
    BEGIN { n = split(to, p, " "); for (i = 1; i <= n; i++) { split(p[i], kv, "="); new[kv[1]] = kv[2] } }
    NR == FNR {
      if (!/^#/ && (i = index($0, "="))) { k = substr($0, 1, i - 1); if (!(sys(k) in new)) have[k] }
      next
    }
    !/^#/ && (i = index($0, "=")) {
      k = substr($0, 1, i - 1); s = sys(k)
      if (s in new) {
        nk = new[s] substr(k, length(s) + 1)
        if (nk in have) { print "system-merge: dropped " $0 ": " nk " is set" >"/dev/stderr"; next }
        have[nk]
        print nk substr($0, i)
        next
      }
    }
    { print }
  ' "${SYSCFG}" "${SYSCFG}" >"${SYSCFG}.merge" || { rm -f "${SYSCFG}.merge"; return 0; }
  if cmp -s "${SYSCFG}" "${SYSCFG}.merge"; then
    rm -f "${SYSCFG}.merge"
  else
    mv "${SYSCFG}.merge" "${SYSCFG}"
  fi
}

# Where a game the launcher lists under an old folder is now: sets NEWPATH
# and NEWSYS, or leaves them empty while it has not moved (a taken name).
moved() {
  local path="$1" old dir new rel
  NEWPATH=""
  NEWSYS=""
  while read -r old dir new; do
    [ -n "${old}" ] || continue
    case "${path}" in
      "/storage/roms/${dir}/"*)
        rel="${path#/storage/roms/${dir}/}"
        if [ -e "${ROMS}/${new}/${rel}" ] && [ ! -e "${ROMS}/${dir}/${rel}" ]; then
          NEWPATH="/storage/roms/${new}/${rel}"
          NEWSYS="${new}"
        fi
        return 0 ;;
    esac
  done <<<"${MERGES}"
}

# A list, rewritten in place when anything in it changed.
replace() {
  if cmp -s "$1" "$1.merge"; then
    rm -f "$1.merge"
  else
    mv "$1.merge" "$1"
  fi
}

### The launcher's recent games (time, system, path) and favourites (path).
lists() {
  local f="${LISTS}/recent" line when sys path
  if [ -f "${f}" ]; then
    while IFS= read -r line || [ -n "${line}" ]; do
      IFS=$'\t' read -r when sys path <<<"${line}"
      moved "${path}"
      if [ -n "${NEWPATH}" ]; then
        printf '%s\t%s\t%s\n' "${when}" "${NEWSYS}" "${NEWPATH}"
      else
        printf '%s\n' "${line}"
      fi
    done <"${f}" >"${f}.merge" && replace "${f}"
  fi
  f="${LISTS}/favourites"
  if [ -f "${f}" ]; then
    while IFS= read -r line || [ -n "${line}" ]; do
      moved "${line}"
      printf '%s\n' "${NEWPATH:-${line}}"
    done <"${f}" >"${f}.merge" && replace "${f}"
  fi
}

### The empty folders the image no longer makes: the old systems', the
### themes folder, and those of systems an older release had.
prune() {
  local keep d
  [ -f "${SYSTEM_DIRS}" ] || return 0
  keep=$(awk '$1 == "d" { print $2 }' "${SYSTEM_DIRS}")
  for d in "${ROMS}"/*/; do
    d="${d%/}"
    [ -L "${d}" ] && continue
    grep -qxF "/storage/roms/${d##*/}" <<<"${keep}" && continue
    rmdir "${d}" 2>/dev/null
  done
}

[ -d "${ROMS}" ] || exit 0
files
settings
lists
prune
exit 0
