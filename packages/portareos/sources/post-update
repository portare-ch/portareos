. /etc/profile

LOG="/var/log/boot.log"

### This script contains items that we only want to execute after a PortareOS upgrade,
### or after a fresh installation.

### Items in this block should always run after updates.
################################################################################

echo "Rebuild library cache..." >>${LOG}
tocon "Rebuilding library cache..."
### Rebuild the library cache
rm -f /storage/.cache/ld.so.cache
ldconfig -X

echo "Drop the compiled shader cache..." >>${LOG}
### The SPIR-V cache survives a reboot on purpose - recompiling it is what
### makes the first game after a boot stutter. It must not survive an
### update. Its filenames are a hash of the shader, not of the compiler,
### so a new glslang or shaderc produces the same key and the old SPIR-V
### would be served for the life of the install. Valid SPIR-V, so nothing
### breaks; it just never picks up a compiler fix. Keep across a boot,
### drop across an update.
rm -rf /storage/cache/spirv/* >/dev/null 2>&1

echo "Sync configuration files..." >>${LOG}
tocon "Re-sync configuration files..."
### Sync configurations
if [ -d "/storage/.config/system/configs" ]
then
  EXCLUDE="--exclude=configs"
fi

### Remove and link es configs so they are managed with OS updates.
for es_cfg in es_features.cfg es_systems.cfg
do
  mv /storage/.config/emulationstation/${es_cfg} /storage/.config/emulationstation/last_${es_cfg} >/dev/null 2>&1
  ln -s /usr/config/emulationstation/${es_cfg} /storage/.config/emulationstation/${es_cfg}  >/dev/null 2>&1
done

### .migrations holds the markers of the one-shot migrations below, which
### the image does not have, so --delete took them and every migration ran
### again on every update: SSH back on, the colour profile back to stock.
rsync -a --delete ${EXCLUDE} --exclude=.migrations /usr/config/system/ /storage/.config/system/

### simple-http-server is gone from the image: it was EmulationStation's file
### browser, serving /storage on port 80 to anyone on the network with the
### root password every device shares. A device that had it switched on
### keeps the enable link in /storage, which would point at nothing.
rm -f /storage/.config/system.d/*.wants/simple-http-server.service

### ScummVM's theme sources were copied into /storage on first start - 74 MB
### on every card. It reads the built themes from /usr/local/share/scummvm
### now; the copy, recognisable by its nested themes/themes, goes.
if [ -d /storage/.config/scummvm/themes/themes ]; then
  rm -rf /storage/.config/scummvm/themes
fi
sed -i '/^simplehttp\./d' /storage/.config/system/configs/system.cfg 2>/dev/null ||:

### Keys new in the shipped system.cfg. configs/ is excluded from the sync
### above, so the file is the one copied at install, and a default added
### since never reached it: gpuperf, the GPU floor for emulators, and
### cores=big were missing on a device installed before them. Only absent
### keys are appended; a value already there, chosen or not, stays.
SYSCFG=/storage/.config/system/configs/system.cfg
if [ -f "${SYSCFG}" ]; then
  awk 'function key(l) { return substr(l, 1, index(l, "=") - 1) }
       NR == FNR { if (!/^#/ && index($0, "=")) have[key($0)]; next }
       !/^#/ && index($0, "=") && !(key($0) in have)' \
      "${SYSCFG}" /usr/config/system/configs/system.cfg >/tmp/system.cfg.new
  if [ -s /tmp/system.cfg.new ]; then
    [ -n "$(tail -c1 "${SYSCFG}")" ] && echo >>"${SYSCFG}"
    cat /tmp/system.cfg.new >>"${SYSCFG}"
    sed 's/^/New setting: /' /tmp/system.cfg.new >>${LOG}
  fi
  rm -f /tmp/system.cfg.new
fi
rsync -a --ignore-existing /usr/config/game /storage/.config/
rsync -a /usr/config/modules /storage/.config/

### Config files that are new in this image. userconfig-setup does this once,
### guarded by /storage/.configured, so without a pass here a file added to
### /usr/config never reaches a device that has already booted.
###
### --ignore-existing, so this delivers files that are new and never touches
### one the user has edited. Changed *contents* of an existing file still need
### a migration at the bottom of this script. system/ is excluded because the
### block above already syncs it deliberately, and the es configs because they
### are symlinks into /usr/config.
rsync -a --ignore-existing --exclude=system \
      --exclude={es_features.cfg,es_systems.cfg} \
      /usr/config/* /storage/.config/ >>${LOG} 2>&1

if [ -f "/storage/.config/emulationstation/resources/logo.png" ]
then
  rm -f /storage/.config/emulationstation/resources/logo.png
fi

echo "Sync modules..." >>${LOG}
tocon "Update tool modules..."
rsync -a /usr/config/modules/* /storage/.config/modules/
# The sync only adds. A tool the image dropped would stay in Tools and fail
# when started, so remove those by name.
rm -f /storage/.config/modules/GPcal.sh
cp -f /usr/config/retroarch/retroarch-core-options.cfg /storage/.config/retroarch/retroarch-core-options.cfg

# ...and retroarch.cfg itself, which was not refreshed here and so froze at
# whatever first boot wrote. Every change the image makes to it - the video
# driver, black frame insertion, the swap interval, run-ahead, the panel's
# own 1280x960 geometry - reached nobody who already had a config. A device
# updated from an older build was still on glcore at 1920x1080 with BFI off
# while the image had shipped vulkan, 1280x960 and BFI on for weeks.
#
# Safe to overwrite: retroarch never writes this file back, because
# config_save_on_exit is false, and setsettings.sh rewrites every input
# binding in it at each launch. One copy of whatever was there is kept the
# first time, for anyone who had hand-edited it.
if [ -f /storage/.config/retroarch/retroarch.cfg ] && \
   [ ! -f /storage/.config/retroarch/retroarch.cfg.pre-refresh ]
then
  cp /storage/.config/retroarch/retroarch.cfg /storage/.config/retroarch/retroarch.cfg.pre-refresh
fi
cp -f /usr/config/retroarch/retroarch.cfg /storage/.config/retroarch/retroarch.cfg

# The per-core overrides have the same problem: nothing copied them either,
# so an override added to the image - PPSSPP's, most recently - never
# reached a device that already had a config directory. No --delete: these
# are keyed by core name, so anything here for a core we no longer ship is
# inert, and deleting would take a user's own overrides with it.
#
# .opt files are included, deliberately, and this is a choice rather than an
# oversight: what the image ships is what the device runs. A .opt the image
# does not carry a seed for is untouched, and one it does is replaced.
#
# The cost is real and is accepted - a core option changed in the RetroArch
# menu does not survive an update for any core the image seeds. What is
# bought is that an updated device and a freshly flashed one are in the same
# state, so a build can be tested without first working out which of the
# settings on the device came from it.
#
# One copy of whatever was there is kept the first time, for anyone who had
# set options by hand, the same way retroarch.cfg is handled above.
if [ -d /storage/.config/retroarch/config ] && \
   [ ! -d /storage/.config/retroarch/config.pre-refresh ]
then
  cp -a /storage/.config/retroarch/config \
        /storage/.config/retroarch/config.pre-refresh
fi
rsync -a /usr/config/retroarch/config/ /storage/.config/retroarch/config/ 2>/dev/null

### Apply developer ssh keys if they exist
echo "Apply dev keys if available..." >>${LOG}
if [ -e /usr/config/ssh/authorized_keys ]
then
  tocon "Update developer keys..."
  cp /usr/config/ssh/authorized_keys /storage/.ssh
fi

### Apply developer wifi config if they exist
echo "Apply dev wifi config if available..." >>${LOG}
if [ -d /usr/config/iwd ]
then
  tocon "Update developer wifi config..."
  cp /usr/config/iwd/* /storage/.cache/iwd/
fi

### Sync locale data
tocon "Re-sync locale data..."
rsync -a --delete /usr/config/locale/* /storage/.config/locale/ >>/var/log/configure.log 2>&1
rm -rf /storage/.config/emulationstation/locale >>/var/log/configure.log 2>&1 ||:
ln -sf /usr/share/locale /storage/.config/emulationstation/locale >>/var/log/configure.log 2>&1 ||:

### Handle assets folder for ppsspp v1.20+ upgrade
if [ ! -d "/storage/.config/ppsspp/assets/ui_images" ]
then
  rsync -a --delete /usr/config/ppsspp/assets/* /storage/.config/ppsspp/assets/
fi

### Fix Japanese language bug
if [ ! -e "/storage/.config/ppsspp/assets/NotoSansJP-Regular.ttf" ]
then
  cd /storage/.config/ppsspp/assets
  cp /usr/config/ppsspp/assets/NotoSansJP-Regular.ttf .
  ln -s NotoSansJP-Regular.ttf Roboto-Condensed.ttf
  cd -
fi

### Add items below this line that are safe to remove after a period of time.
################################################################################

### ScummVM's core looks for its themes and engine data under RetroArch's
### system directory, and they have to match the core's version, so they
### are copied from the image after every update. The ini next to them is
### where added games live, so it is only put in place when there is none.
mkdir -p /storage/roms/bios/scummvm
rsync -a /usr/share/scummvm/ /storage/roms/bios/scummvm/
if [ ! -f /storage/roms/bios/scummvm.ini ]; then
  cp /usr/config/scummvm/scummvm.ini /storage/roms/bios/scummvm.ini
fi

### The PS2 core reads its BIOS from bios/pcsx2/bios only. The standalone
### emulators before it used bios/armsx2 and bios/aethersx2/bios, so copy
### what is there across, leaving any file already in place alone.
mkdir -p /storage/roms/bios/pcsx2/bios
for dir in /storage/roms/bios/armsx2 /storage/roms/bios/aethersx2/bios; do
  [ -d "${dir}" ] && rsync -a --ignore-existing "${dir}/" /storage/roms/bios/pcsx2/bios/
done

### And a system or game pinned to the standalone in system.cfg would
### launch a program that is no longer there, so those pins go and the
### core, es_systems' default, applies.
sed -i -e '/^ps2\(\[.*\]\)\?\.core=armsx2-sa$/d' \
       -e '/^ps2\(\[.*\]\)\?\.emulator=armsx2$/d' \
  /storage/.config/system/configs/system.cfg

### And for Beetle Saturn, which Ymir replaced.
sed -i -e '/^saturn\(\[.*\]\)\?\.core=mednafen_saturn$/d' \
  /storage/.config/system/configs/system.cfg

### And for bsnes, which stood in for Snes9x on the SNES for a while.
sed -i -e '/^snes\(\[.*\]\)\?\.core=bsnes$/d' \
       -e '/^snesh\(\[.*\]\)\?\.core=bsnes$/d' \
       -e '/^sfc\(\[.*\]\)\?\.core=bsnes$/d' \
       -e '/^satellaview\(\[.*\]\)\?\.core=bsnes$/d' \
       -e '/^snesmsu1\(\[.*\]\)\?\.core=bsnes$/d' \
  /storage/.config/system/configs/system.cfg

### The same for Nestopia, which MesenCE (mesen2) replaced for the NES.
sed -i -e '/^nes\(\[.*\]\)\?\.core=nestopia$/d' \
       -e '/^famicom\(\[.*\]\)\?\.core=nestopia$/d' \
       -e '/^fds\(\[.*\]\)\?\.core=nestopia$/d' \
  /storage/.config/system/configs/system.cfg

# Set the flag to enable batteryplus capacity reporting if it doesn't already exist
grep -q "^system\.batteryplus\.enabled=" /storage/.config/system/configs/system.cfg ||
    sed -i '$ a\system.batteryplus.enabled=1' /storage/.config/system/configs/system.cfg

# Dolphin controller profiles moved from evdev to SDL bindings. Existing copies
# in /storage name "Microsoft X-Box 360 pad", the virtual pad gptokeyb used to
# create, and Dolphin no longer starts gptokeyb, so they would bind nothing.
# The launch scripts only seed these when absent, so refresh them here.
DOLPHIN_CFG="/storage/.config/dolphin-emu"
# Checked against the shipped profiles only, never the backups written below.
# Those profiles have since been renamed, so the rsync no longer overwrites the
# names tested here; the cleanup below is what keeps this from firing twice.
if grep -qs "Microsoft X-Box 360 pad" \
     "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.south" \
     "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.east" \
     "${DOLPHIN_CFG}/Hotkeys.ini"; then
  tocon "Updating Dolphin controller profiles for SDL..."
  # A custom profile cannot be carried over, so keep a copy before replacing it.
  if [ -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom" ]; then
    mv -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom" \
          "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.custom.evdev"
  fi
  if [ -f "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini" ]; then
    mv -f "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini" \
          "${DOLPHIN_CFG}/WiiControllerProfiles/custom.ini.evdev"
  fi
  rsync -a /usr/config/dolphin-emu/Hotkeys.ini \
           /usr/config/dolphin-emu/GamecubeControllerProfiles \
           /usr/config/dolphin-emu/WiiControllerProfiles "${DOLPHIN_CFG}/"
  # Regenerated from the profiles above on the next launch.
  rm -f "${DOLPHIN_CFG}/GCPadNew.ini" "${DOLPHIN_CFG}/WiimoteNew.ini"
fi

# The GC profiles gained stacked/inline shoulder variants and are now named for
# the layout they target, so the old single-layout files are dead. They must go:
# the SDL migration above tests them by name, and nothing overwrites them any
# more, so leaving them behind re-fires that block on every later update and
# overwrites the .evdev backup it took the first time.
rm -f "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.east" \
      "${DOLPHIN_CFG}/GamecubeControllerProfiles/GCPadNew.ini.south"

# portareos-fake-suspend is gone (the Nova suspends for real), and with it
# its settings.
for KEY in system.suspend.enable system.suspend.enable_timed_shutdown \
           system.suspend.park_cores system.suspend.dpms \
           system.shutdown_delay system.shutdown_delay_running_game; do
  sed -i "/^${KEY}=/d" /storage/.config/system/configs/system.cfg
done

### One-shot migrations
################################################################################
#
# For defaults that changed inside a file an existing install already has, so
# neither userconfig-setup nor the --ignore-existing pass above can deliver
# them. Each runs once and leaves a marker, so a later deliberate choice by the
# user is not undone by the next update.

MIGRATIONS="/storage/.config/system/.migrations"
mkdir -p "${MIGRATIONS}"

migrate() {
  local name="${1}"
  shift

  [ -e "${MIGRATIONS}/${name}" ] && return 0

  echo "Migration: ${name}" >>${LOG}
  "$@" >>${LOG} 2>&1
  touch "${MIGRATIONS}/${name}"
}

# ondemand was never chosen: 008-perfmode picked it automatically for any
# device that offered it, and only ever sets the value when it is unset. On
# this part it parked the little cluster at 2016000 kHz while idle, where
# schedutil sits at 556800. Anything the user has since set on purpose is left
# alone, since only ondemand is moved.
migrate_cpugovernor() {
  [ "$(get_setting system.cpugovernor)" = "ondemand" ] || return 0
  grep -qw schedutil \
    /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors 2>/dev/null || return 0

  set_setting system.cpugovernor schedutil
}

# FpsLimit ships as a default in es_settings.cfg, and an existing install
# already has that file. Read the value out of the image rather than repeating
# it here, and only insert when the key is absent.
migrate_es_fpslimit() {
  local cfg="/storage/.config/emulationstation/es_settings.cfg"
  local shipped="/usr/config/emulationstation/es_settings.cfg"
  local value

  [ -f "${cfg}" ] || return 0
  grep -q 'name="FpsLimit"' "${cfg}" && return 0

  value=$(sed -n 's/.*name="FpsLimit" value="\([0-9]*\)".*/\1/p' "${shipped}" 2>/dev/null)
  [ -n "${value}" ] || return 0

  sed -i "s|</config>|    <int name=\"FpsLimit\" value=\"${value}\" />\n</config>|" "${cfg}"
}

# SSH used to be off except on community builds, and the launcher had no way
# to turn it on, so an official install could only be reached with a keyboard
# and a terminal. It is on by default now, behind the per-device root password
# (autostart/007-rootpw), and Settings > SSH turns it off again.
migrate_ssh_on() {
  set_setting ssh.enabled 1
}

# Both measured profiles crush the dark greys on the device (BUGS.md), so
# stock is the standard until they are refitted. Moves a device that chose
# one back to stock, once; a profile picked again afterwards stays.
migrate_colorprofile_stock() {
  case "$(get_setting display.colorprofile)" in
    gamma22|srgb) set_setting display.colorprofile stock ;;
  esac
}

# system.cfg ships music.cores=little. Without it runemu starts PORTAMP in
# the game slice on cores 3-7 (#485), where start_portamp.sh's taskset to the
# little cores is refused and music does not play. A music value the user set
# is left alone.
migrate_music_little_cores() {
  [ -n "$(get_setting music.cores)" ] || set_setting music.cores little
}

# system.cfg ships the PS2 core layout, ps2.cores=frontend and
# ps2.cpugovernor=performance; an existing install has neither and runs PS2
# on all big cores under schedutil. A ps2 value the user already set is left
# alone, and a per-game one still wins over these.
migrate_ps2_cpu_layout() {
  [ -n "$(get_setting ps2.cores)" ] || set_setting ps2.cores frontend
  [ -n "$(get_setting ps2.cpugovernor)" ] || set_setting ps2.cpugovernor performance
}

# glide64 was the shipped N64 renderer until ParaLLEl-RDP replaced it. It
# needs OpenGL, which here is zink, and RetroArch crashed within seconds of
# every N64 launch on a device still carrying it. Only glide64 is moved.
migrate_n64_parallel_rdp() {
  [ "$(get_setting n64.parallel_n64_video_core)" = "glide64" ] || return 0
  set_setting n64.parallel_n64_video_core parallel
}

# Integer scaling became the default system by system as the Nova's display
# configs were written, and a device installed before kept each old 0:
# Dreamcast, Genesis, NES, Saturn, Neo Geo and more ran scaled to fit. Each
# system the image ships at 1 is moved to 1, once.
migrate_integerscale_on() {
  local key
  for key in $(sed -n 's/^\([^#=]*\.integerscale\)=1$/\1/p' /usr/config/system/configs/system.cfg); do
    [ "$(get_setting ${key})" = "0" ] && set_setting ${key} 1
  done
}

# The NES shipped at 4/3, which stretches its 8:7 pixels to fill the panel,
# 9% too wide. The original ratio is the core's, 128/105 with mesence-lr's
# 002 patch: 1172x960 with integer scaling. Only 4/3 is moved.
migrate_nes_ratio_core() {
  local sys
  for sys in nes famicom fds; do
    [ "$(get_setting ${sys}.ratio)" = "4/3" ] && set_setting ${sys}.ratio core
  done
  return 0
}

# The SNES shipped at 4/3, 2% wider than its 8:7 pixels made the picture
# on a CRT. Snes9x's "auto" aspect reports that shape (as bsnes did
# before it): 224 lines at 1172x896 with integer scaling. Only 4/3 is
# moved.
migrate_snes_ratio_core() {
  local sys
  for sys in snes snesh sfc satellaview snesmsu1; do
    [ "$(get_setting ${sys}.ratio)" = "4/3" ] && set_setting ${sys}.ratio core
  done
  return 0
}

# audiolatency shipped as 32 from upstream and 020-set_audio_latency only ever
# writes it when unset, so an install that has booted once keeps 32. 24 keeps
# RetroArch's ring more than two graph quanta deep at every link rate this
# device uses, and is worth 4 to 12 ms depending on the rate. Only the old
# default is moved, so a value chosen since stays. docs/audio-latency.md.
migrate_audiolatency_24() {
  [ "$(get_setting global.audiolatency)" = "32" ] || return 0
  set_setting global.audiolatency 24
}

# 24 held while the DSP set the floor. It does not any more: the period is
# 10 ms at every rate (#422) and the playback graph publishes a sample
# accurate position (#428), so 8 runs clean - and 8 is RetroArch's own
# minimum, so there is nothing below it to try. Registered after the 24
# migration, so an install still on upstream's 32 lands on 8 in one update.
# Only the old default is moved; a value chosen since stays.
migrate_audiolatency_8() {
  [ "$(get_setting global.audiolatency)" = "24" ] || return 0
  set_setting global.audiolatency 8
}

# The sleep hooks read an unset led.color as battery and saved it, so the
# first suspend lit the sticks in charge colours for good, charger or not.
# Nothing offers battery to a player, so every battery came from them.
# ledcontrol off also darkens the sticks the battery service had painted.
migrate_led_battery_off() {
  [ "$(get_setting led.color)" = "battery" ] || return 0
  /usr/bin/ledcontrol off
  set_setting sleep.led.color off
}

# Saturn's picture: Ymir hands over the console's own frame, 320x224 and
# up, so the beam shader at native resolution (crt-240-1x) draws its
# lines, and the 4:3 frame fills the 4:3 panel instead of an integer 4x
# that left a border all round. This ran on every update, so it also took
# back crt-guest-advanced or integer scaling chosen since; once is enough.
migrate_saturn_picture() {
  sed -i -e 's|^saturn\.shaderset=crt/crt-guest-advanced\.slangp$|saturn.shaderset=portare/crt-240-1x.slangp|' \
         -e 's|^saturn\.integerscale=1$|saturn.integerscale=0|' \
    /storage/.config/system/configs/system.cfg
}

migrate cpugovernor-schedutil migrate_cpugovernor
migrate audiolatency-24 migrate_audiolatency_24
migrate audiolatency-8 migrate_audiolatency_8
migrate es-fpslimit migrate_es_fpslimit
migrate ssh-default-on migrate_ssh_on
migrate colorprofile-stock migrate_colorprofile_stock
migrate n64-parallel-rdp migrate_n64_parallel_rdp
migrate integerscale-on migrate_integerscale_on
migrate ps2-cpu-layout migrate_ps2_cpu_layout
migrate music-little-cores migrate_music_little_cores
migrate nes-ratio-core migrate_nes_ratio_core
migrate snes-ratio-core migrate_snes_ratio_core
migrate led-battery-off migrate_led_battery_off
migrate saturn-picture migrate_saturn_picture
