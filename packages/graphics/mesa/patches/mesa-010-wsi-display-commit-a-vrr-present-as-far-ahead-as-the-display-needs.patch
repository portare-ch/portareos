From: PortareOS <hello@portare.org>
Subject: [PATCH] wsi/display: commit a VRR present as far ahead as the display needs

On VRR, _wsi_display_queue_next commits a timed present a millisecond
before its target, for the time a page flip takes to reach the display,
and reports it as shown no earlier than the target (minimum_ns). A
variable refresh starts when the commit lands, so on a display that
needs less the frame is shown before its target, which
VK_GOOGLE_display_timing's desiredPresentTime rules out, and the report
says it was on time.

Measure the delay instead. Keep, per connector, the shortest time a
commit has taken from the commit to its page flip timestamp while VRR
was on, since the mode was set, and commit a timed VRR present that far
ahead of its target, at most the millisecond as before. A commit that
met a refresh still in progress took longer; the shortest is one the
display was waiting for. It is kept for the mode, not a recent window:
content at the display's fastest refresh only ever waits, and with a
window of 256 commits the lead grew with those waits once the idle
commits of the game's start had left it, which moved Super Mario
World's frames to another refresh.

Measured on SM8550 (Retroid Pocket Nova), VRR. A commit reaches the
panel 0.32 ms after it is made (median); frames shown before their
target, before and after:

  present-probe 50 Hz, 60 s      2944 of 3076   0 of 3075, +0.16 ms
  present-probe 30 Hz, 60 s      1352 of 1846   0 of 1846, +0.29 ms
  Tekken 3, 59.826 Hz, 130 s     7066 of 7513   0 of 7536, +0.27 ms
  Super Mario World, 130 s          0 of 7592   0 of 7601, +1.21 ms

(after: the median time past the target). Super Mario World runs at
the panel's fastest refresh and was never early; it is unchanged.
Tekken 3's refresh interval error went from 0.250 to 0.074 ms at p99.

Signed-off-by: PortareOS <hello@portare.org>
---
--- a/src/vulkan/wsi/wsi_common_display.c
+++ b/src/vulkan/wsi/wsi_common_display.c
@@ -205,6 +205,10 @@
    bool                         has_vblank;
    uint64_t                     last_frame;
    uint64_t                     last_nsec;
+   /* With VRR on, the shortest time a commit took to reach the display
+    * since the mode was set: commit to page flip timestamp. 0 before one.
+    */
+   uint64_t                     vrr_latency_ns;
 } wsi_display_connector;
 
 struct wsi_display {
@@ -528,6 +532,7 @@
    struct wsi_display_fence        *fence;
    uint64_t                        minimum_ns;
    uint64_t                        queued_ns;
+   uint64_t                        commit_ns;
 };
 
 struct wsi_display_swapchain {
@@ -1839,6 +1844,7 @@
    image->state = WSI_IMAGE_IDLE;
    image->fence = NULL;
    image->minimum_ns = 0;
+   image->commit_ns = 0;
    image->fb_id = 0;
 
    uint64_t *fb_modifiers = NULL;
@@ -2088,6 +2094,14 @@
 
    uint64_t nsec = 1000000000ull * sec + 1000ull * usec;
 
+   if (nsec > image->commit_ns && image->commit_ns &&
+       connector->vrr_enabled == VRR_TRISTATE_ENABLED) {
+      uint64_t latency = nsec - image->commit_ns;
+      if (!connector->vrr_latency_ns || latency < connector->vrr_latency_ns)
+         connector->vrr_latency_ns = latency;
+   }
+   image->commit_ns = 0;
+
    /* Pageflip event with invalid frame and timestamp received? */
    if (nsec == 0 && frame == 0) {
       /* This happens on amdgpu driven AMD gpu's on the first (full modesetting) atomic commit
@@ -2646,6 +2660,7 @@
 
       connector->current_mode = display_mode;
       connector->current_drm_mode = *drm_mode;
+      connector->vrr_latency_ns = 0;
    }
 
 bail_connector:
@@ -3043,6 +3058,24 @@
       (void) !write(wsi->trace_fd, line, MIN2((size_t)n, sizeof(line) - 1));
 }
 
+/* How far ahead of its target to commit a VRR present: the shortest time a
+ * commit has taken to reach the display since the mode was set, so a frame
+ * is not shown before its target, and at most the millisecond allowed for
+ * any driver. A commit that met a refresh still in progress took longer; the
+ * shortest is one the display was waiting for. It is kept for the mode, not
+ * a recent window: content at the display's fastest refresh only ever waits,
+ * and a lead that grew with those waits moved its frames to another refresh.
+ */
+static int64_t
+wsi_display_vrr_lead_ns(const wsi_display_connector *connector)
+{
+   uint64_t lead = 1000 * 1000;
+
+   if (connector->vrr_latency_ns)
+      lead = MIN2(lead, connector->vrr_latency_ns);
+   return (int64_t)lead;
+}
+
 static int
 drm_atomic_commit(wsi_display_connector *connector, struct wsi_display_image *image, bool test_only)
 {
@@ -3357,8 +3390,13 @@
 
             /* Account for some minimum delay in submitting a page flip until it's processed and sleep jitter.
              * We will compensate for the difference if there is any, so that we don't report completion
-             * times in the past. */
-            target_ns -= 1 * 1000 * 1000;
+             * times in the past.
+             *
+             * On VRR that delay is measured instead: a refresh starts when the commit lands, so a fixed
+             * millisecond showed the frame up to that much before its target on a display that needs
+             * less, and minimum_ns reported it as on time.
+             */
+            target_ns -= is_vrr ? wsi_display_vrr_lead_ns(connector) : 1 * 1000 * 1000;
 
             /* Sleeping here sleeps in the presenting thread, and with wait_mutex held, which also
              * keeps the wait thread from handling flip events. On VRR, hold the image instead and
@@ -3397,6 +3435,7 @@
       if (!connector->active && !image->minimum_ns)
          image->minimum_ns = os_time_get_nano();
 
+      image->commit_ns = os_time_get_nano();
       int ret = drm_atomic_commit(connector, image, false);
       if (ret == 0) {
          image->state = WSI_IMAGE_FLIPPING;
