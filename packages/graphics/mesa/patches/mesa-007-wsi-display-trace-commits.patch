From: PortareOS <hello@portare.org>
Subject: [PATCH] wsi/display: write each commit to the kernel trace when asked

A flip trace shows when the panel refreshed and which buffer it scanned,
but not which present a commit came from. With
MESA_VK_WSI_DISPLAY_TRACE=1 every commit writes one line to
/sys/kernel/tracing/trace_marker: the swapchain image, the present's
serial and VK_GOOGLE_display_timing ID, its target, when it reached this
backend and when it was committed, on CLOCK_MONOTONIC. The lines land in
the same trace as drm_vblank_event and the DPU's flip events, so a frame
can be followed from present to scanout. Unset, a commit costs one
comparison.

Used on SM8550 (Retroid Pocket Nova) to check MangoHud's display
intervals and the display driver's repeats against the trace, every
commit paired with its flip.

Signed-off-by: PortareOS <hello@portare.org>
---
--- a/src/vulkan/wsi/wsi_common_display.c
+++ b/src/vulkan/wsi/wsi_common_display.c
@@ -241,6 +241,12 @@
     * last DRM master left it.
     */
    int                          vrr_request;
+
+   /* MESA_VK_WSI_DISPLAY_TRACE=1: every commit is written to the kernel's
+    * trace_marker, so it lands in the same trace as the DRM and DPU events
+    * of its flip. -1 otherwise.
+    */
+   int                          trace_fd;
 
    struct u_cnd_monotonic       hotplug_cond;
    pthread_t                    hotplug_thread;
@@ -521,6 +527,7 @@
    struct wsi_image_timing_request timing_request;
    struct wsi_display_fence        *fence;
    uint64_t                        minimum_ns;
+   uint64_t                        queued_ns;
 };
 
 struct wsi_display_swapchain {
@@ -2979,6 +2986,40 @@
    }
 }
 
+/* One line per commit: the swapchain image,
+ * the present's serial and VK_GOOGLE_display_timing ID (-1 without one), its
+ * target, when the present reached this backend, and when it was committed,
+ * on CLOCK_MONOTONIC. A present queued after its target came late; one
+ * committed after its target can also have waited for the panel.
+ */
+static void
+wsi_display_trace_commit(struct wsi_display *wsi, struct wsi_display_image *image)
+{
+   struct wsi_display_swapchain *chain = image->chain;
+   uint64_t serial = image->timing_request.serial;
+   long long id = -1;
+
+   if (chain->base.present_timing.active && serial) {
+      mtx_lock(&chain->base.present_timing.lock);
+      for (uint32_t i = 0; i < chain->base.present_timing.timings_count; i++) {
+         if (chain->base.present_timing.timings[i].serial == serial) {
+            id = (long long)chain->base.present_timing.timings[i].present_id;
+            break;
+         }
+      }
+      mtx_unlock(&chain->base.present_timing.lock);
+   }
+
+   char line[192];
+   int n = snprintf(line, sizeof(line),
+                    "wsi_display: frame image=%u serial=%" PRIu64 " id=%lld target=%" PRIu64
+                    " queued=%" PRIu64 " commit=%" PRIu64 "\n",
+                    (unsigned)(image - chain->images),
+                    serial, id, image->timing_request.time, image->queued_ns, os_time_get_nano());
+   if (n > 0)
+      (void) !write(wsi->trace_fd, line, MIN2((size_t)n, sizeof(line) - 1));
+}
+
 static int
 drm_atomic_commit(wsi_display_connector *connector, struct wsi_display_image *image, bool test_only)
 {
@@ -3083,6 +3124,9 @@
    ret = drmModeAtomicCommit(fd, req, flags, image);
    if (ret)
       goto out;
+
+   if (!test_only && connector->wsi->trace_fd >= 0)
+      wsi_display_trace_commit(connector->wsi, image);
 
    if (set_vrr >= 0 && !test_only) {
       connector->vrr_enabled = set_vrr ? VRR_TRISTATE_ENABLED : VRR_TRISTATE_DISABLED;
@@ -3415,6 +3459,7 @@
 
    image->present_id = present_id;
    image->timing_request = chain->timing_request;
+   image->queued_ns = os_time_get_nano();
 
    assert(image->state == WSI_IMAGE_DRAWING);
    wsi_display_debug("present %d\n", image_index);
@@ -3836,6 +3881,10 @@
    list_inithead(&wsi->connectors);
 
    wsi->timer_fd = -1;
+
+   const char *trace = getenv("MESA_VK_WSI_DISPLAY_TRACE");
+   wsi->trace_fd = trace && atoi(trace) ?
+      open("/sys/kernel/tracing/trace_marker", O_WRONLY | O_CLOEXEC) : -1;
 
    const char *vrr = getenv("MESA_VK_WSI_DISPLAY_VRR");
    wsi->vrr_request = vrr && *vrr ? atoi(vrr) != 0 : -1;
@@ -3902,6 +3951,8 @@
       wsi_display_stop_wait_thread(wsi);
       if (wsi->timer_fd >= 0)
          close(wsi->timer_fd);
+      if (wsi->trace_fd >= 0)
+         close(wsi->trace_fd);
 
       if (wsi->hotplug_thread) {
          pthread_cancel(wsi->hotplug_thread);
