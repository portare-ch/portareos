+   struct pollfd pollfd[3] = {
       { .fd = wsi->fd, .events = POLLIN },
       { .fd = wsi->timer_fd, .events = POLLIN },
+      { .fd = wsi->repeat_fd, .events = POLLIN },
    };
-   nfds_t nfds = wsi->timer_fd >= 0 ? 2 : 1;
 
    pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, NULL);
    for (;;) {
-      int ret = poll(pollfd, nfds, -1);
+      int ret = poll(pollfd, 3, -1);
       if (ret > 0) {
          mtx_lock(&wsi->wait_mutex);
          if (pollfd[0].revents)
             (void) drmHandleEvent(wsi->fd, &event_context);
-         if (nfds > 1 && (pollfd[1].revents & POLLIN))
+         if (pollfd[1].revents & POLLIN)
             wsi_display_timer_expired(wsi);
+         if (pollfd[2].revents & POLLIN)
+            wsi_display_repeat_expired(wsi);
          u_cnd_monotonic_broadcast(&wsi->wait_cond);
          mtx_unlock(&wsi->wait_mutex);
       }
@@ -2168,6 +2322,8 @@
    if (!wsi->wait_thread) {
       if (wsi->timer_fd < 0)
          wsi->timer_fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
+      if (wsi->repeat_fd < 0)
+         wsi->repeat_fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
       int ret = pthread_create(&wsi->wait_thread, NULL,
                                wsi_display_wait_thread, wsi);
       if (ret)
@@ -3201,6 +3357,40 @@
       bool is_vrr = connector->vrr_enabled == VRR_TRISTATE_ENABLED &&
                     connector->vrr_capable == VRR_TRISTATE_ENABLED;
 
+      /* The frame period, from the distance between targets, met or not.
+       * One distance off the period - the application moving its targets,
+       * or dropping a frame - is noise, and the repeats of a single frame
+       * must not follow it; a new period is taken once it is seen twice.
+       */
+      if (image->state == WSI_IMAGE_QUEUED) {
+         if (is_vrr && !skip_timing && is_absolute_time) {
+            uint64_t target = image->timing_request.time;
+            uint64_t last = chain->vrr_last_target_ns;
+            uint64_t period = chain->vrr_interval_ns;
+            uint64_t prev = chain->vrr_last_interval_ns;
+            uint64_t seen = last && target > last ? target - last : 0;
+
+            if (!seen)
+               period = 0;
+            else if (!period)
+               period = seen;
+            else if (seen > period - period / 4 && seen < period + period / 4)
+               period = period - period / 8 + seen / 8;
+            else if (prev && seen > prev - prev / 16 && seen < prev + prev / 16)
+               period = seen;
+
+            image->vrr_target_ns = target;
+            chain->vrr_last_target_ns = target;
+            chain->vrr_last_interval_ns = seen;
+            chain->vrr_interval_ns = period;
+         } else {
+            image->vrr_target_ns = 0;
+            chain->vrr_last_target_ns = 0;
+            chain->vrr_last_interval_ns = 0;
+            chain->vrr_interval_ns = 0;
+         }
+      }
+
       /* Nor as a threshold: on VRR a target less than a refresh after the last vblank is still a
        * time to start the next refresh at, and the hardware's shortest frame bounds it anyway. The
        * last vblank is stamped at the end of vblank, so a present aimed one refresh after the
@@ -3785,6 +3975,7 @@
    list_inithead(&wsi->connectors);
 
    wsi->timer_fd = -1;
+   wsi->repeat_fd = -1;
 
    int ret = mtx_init(&wsi->wait_mutex, mtx_plain);
    if (ret != thrd_success) {
@@ -3848,6 +4039,8 @@
       wsi_display_stop_wait_thread(wsi);
       if (wsi->timer_fd >= 0)
          close(wsi->timer_fd);
+      if (wsi->repeat_fd >= 0)
