#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ROCKNIX (https://github.com/ROCKNIX)
# Copyright (C) 2026-present PortareOS (https://github.com/portare-ch)

# Power key policy for the Nova, which has real suspend.
#
#   screen already blanked     -> unblank, whatever put it there
#   external display attached  -> blank the internal panel, never suspend
#   suspend switched off       -> blank the internal panel
#   otherwise                  -> real suspend
#
# "idle" is the launcher's request after its menu sat dark and untouched for
# system.sleepminutes: the same rules, and SSH in use besides. It answers 0
# when the suspend is queued, 1 when it declines.
#
# The "never suspend on an external display" rule is what stops a docked
# device powering its TV output down mid-session. The blank state is ours and
# lives in one flag, which sleep.d tears down before any real suspend so the
# two paths can never overlap.

. /etc/profile

case $(get_setting system.loglevel) in
verbose) DEBUG=true ;;
*)       DEBUG=false ;;
esac

BLANK_FLAG="/run/power-blank-active.flag"
# PORTAMP's mpv, when it is playing; see start_portamp.sh.
PORTAMP_SOCK="/run/portamp.sock"

# Blanking and the "is a display attached" question both come from
# external-display. It blanks internal panels only: a DPMS off on an active DP output makes
# msm_dp_display_disable() report the audio jack as unplugged, and the HPD
# plug events that would undo it are discarded while the display is off, so
# dock audio stays dead until a physical replug.
EXTERNAL_DISPLAY="/usr/bin/external-display"

# External display dependency. The helper itself is not part of this series.
# Where it is missing, "connected" answers "not attached" so the handler
# suspends exactly as it would on a device with no external output, and the
# blanking falls through to the front-end below.
# The helper is not in this tree, so before this fallback existed the blank
# path did nothing at all: the flag was set, "blank" returned 1, and the DPU
# carried on scanning out. Measured, that left 735805 kBps of DDR bandwidth
# and the whole display pipeline powered behind a dark screen.
#
# Whoever holds DRM master is the only process that can blank the panel, and
# that is now portarelauncher rather than a compositor. It disables the CRTC
# on SIGUSR1 and re-presents on SIGUSR2, which stops the display pipeline
# scanning out rather than just drawing black - the part that costs DDR
# bandwidth whether or not anything is lit.
#
# Internal outputs only is no longer something this has to enforce: the
# launcher drives the one connector it opened, and that is the panel.
frontend_power() {
  local pid
  # The service's main process rather than pidof: a test build run from a
  # drop-in has another file name, and pidof matches that, not the comm.
  pid=$(systemctl show -p MainPID --value portarelauncher 2>/dev/null)
  case "${pid}" in ''|0|*[!0-9]*) return 1 ;; esac
  case "${1}" in
    off) kill -USR1 ${pid} 2>/dev/null ;;
    on)  kill -USR2 ${pid} 2>/dev/null ;;
    *)   return 1 ;;
  esac
}

external_display() {
  if [ -x "${EXTERNAL_DISPLAY}" ]; then
    "${EXTERNAL_DISPLAY}" "$@"
    return
  fi

  # Without the helper there is no external display to ask about, so
  # "connected" stays false and only the blanking is answered.
  case "${1}" in
    blank)   frontend_power off ;;
    unblank) frontend_power on ;;
    *)       return 1 ;;
  esac
}

# Deliberately no sink muting. wireplumber persists mute per route, so a sink
# muted here that then disappears (external display audio across a dock change)
# stays muted on disk forever, with nothing to unmute it. A docked device with
# its screen off is still driving a TV, so its audio should keep playing.
#
# Deliberately no LED handling on the blank path. A dark power LED means
# asleep on this platform, and a docked device with its screen off is awake
# and charging. The suspend path below is the one exception: sleep.d does not
# light the sleep indication until after the WiFi teardown, seconds after the
# press, so the press looks dead and invites a second press that wakes the
# device. Light it here, at press time; 000-led repeats the same writes later
# and the post hooks restore as usual.
POWER_LED="/sys/class/leds/power-led"

# There is deliberately nothing here that stops the front-end.
#
# EmulationStation had to be frozen while the panel was dark: its main loop
# rendered and swapped every iteration with no damage tracking, so the Adreno
# core rail never got the 66ms it needs to collapse and gpu_cc_gx_gdsc stayed
# on behind a blank screen. A SIGSTOP was the cheap way to stop that.
#
# portarelauncher does not draw unless something changed and never touches
# the GPU at all - the menu is a dumb buffer and a memcpy - so it costs
# nothing to leave running. Stopping it would also be actively wrong: it is
# what blanks and unblanks the panel, and a process under SIGSTOP cannot
# handle the signal that would turn the screen back on.

# SSH in use: a remote command, scp or rsync runs as "sshd-session:
# user@notty" for as long as it lasts, and an interactive login holds a pty
# whose access time moves with what is typed into it (the kernel updates it
# in 8 s steps). A login nobody typed into for the sleep time is not in use.
ssh_in_use() {
  local idle_s="${1}" p t now
  for p in $(pidof sshd-session 2>/dev/null); do
    grep -q '@notty' /proc/${p}/cmdline 2>/dev/null && return 0
  done
  now=$(date +%s)
  for t in /dev/pts/[0-9]*; do
    [ -e "${t}" ] || continue
    [ $(( now - $(stat -c %X "${t}") )) -lt "${idle_s}" ] && return 0
  done
  return 1
}

# Dark screen with the blue LED, at request time: sleep.d does not light the
# sleep indication until after the WiFi teardown, seconds later, so a press
# looks dead and invites a second press that wakes the device. Safe on an
# aborted suspend: resume re-powers the panel and the post hooks restore
# brightness, and the same restore runs on a failed sleep.
suspend_now() {
  if [ -d "${POWER_LED}" ]; then
    echo none >"${POWER_LED}/trigger"
    echo 0 0 255 >"${POWER_LED}/multi_intensity"
    echo 255 >"${POWER_LED}/brightness"
  fi
  for BL in /sys/class/backlight/*/brightness; do
    [ -f "${BL}" ] && echo 0 >"${BL}"
  done
  systemctl suspend
}

case "$1" in
  power)
    # The blank is ours, so a press always ends it first. This also covers the
    # display being blanked while docked and then undocked: without it the
    # screen stays dark with nothing explaining why, and the next press would
    # suspend a device the user thought was already asleep.
    if [ -e "${BLANK_FLAG}" ]; then
      ${DEBUG} && log $0 "Waking from blank."
      rm -f "${BLANK_FLAG}"
      external_display unblank
      exit 0
    fi

    # Music is no reason to suspend. While PORTAMP plays the key only
    # switches the screen, and portamp.lua keeps that state: it went dark
    # there, it wakes there. A socket left by a killed mpv refuses the
    # connection and the key suspends as it always has.
    if [ -S "${PORTAMP_SOCK}" ] &&
       echo '{"command":["script-message","power-button"]}' |
       socat -t1 - "UNIX-CONNECT:${PORTAMP_SOCK}" >/dev/null 2>&1; then
      ${DEBUG} && log $0 "PORTAMP playing, switching its screen instead of suspending."
      exit 0
    fi

    # Never suspend while an external display is attached: the output would go
    # down with the SoC. The key becomes a screen toggle instead. The same
    # applies when suspend is switched off in settings (suspendmode off sets
    # AllowSuspend=no, so systemctl suspend would only fail).
    if external_display connected; then
      ${DEBUG} && log $0 "External display attached, blanking instead of suspending."
      touch "${BLANK_FLAG}"
      external_display blank
      exit 0
    fi
    if [ "$(get_setting system.suspendmode)" = "off" ]; then
      ${DEBUG} && log $0 "Suspend switched off, blanking instead."
      touch "${BLANK_FLAG}"
      external_display blank
      exit 0
    fi

    ${DEBUG} && log $0 "Suspending."
    suspend_now
    ;;

  idle)
    # Blanked by the key while docked or with suspend off: the user chose
    # a dark screen over sleep, and the rules below would say the same.
    if [ -e "${BLANK_FLAG}" ]; then
      exit 1
    fi
    if [ -S "${PORTAMP_SOCK}" ] &&
       echo '{"command":["get_property","pid"]}' |
       socat -t1 - "UNIX-CONNECT:${PORTAMP_SOCK}" >/dev/null 2>&1; then
      exit 1
    fi
    if external_display connected ||
       [ "$(get_setting system.suspendmode)" = "off" ]; then
      exit 1
    fi
    SLEEP_MIN=$(get_setting system.sleepminutes)
    case "${SLEEP_MIN}" in ''|*[!0-9]*) SLEEP_MIN=5 ;; esac
    if ssh_in_use $(( SLEEP_MIN * 60 )); then
      ${DEBUG} && log $0 "Idle, but SSH is in use: not sleeping."
      exit 1
    fi
    ${DEBUG} && log $0 "Idle for the sleep time, suspending."
    suspend_now
    ;;

  release)
    # Called from sleep.d/pre. A real suspend must never begin while we hold
    # the panel blanked: "output ... power off" is compositor state that
    # survives suspend, so resume would restore brightness onto a panel still
    # switched off and the device would look dead, recoverable only over ssh.
    if [ -e "${BLANK_FLAG}" ]; then
      ${DEBUG} && log $0 "Releasing blank before suspend."
      rm -f "${BLANK_FLAG}"
      external_display unblank
    fi
    # The launcher's own idle blank holds the CRTC off the same way, and
    # the key suspends from it as from a lit menu. Have it present again,
    # under the backlight the key or the idle request already darkened; a
    # lit menu only redraws.
    frontend_power on

    ;;

  lid)
    # logind still owns the lid on this platform (HandleLidSwitch=suspend in
    # 030-suspend_mode), so acting here as well would race its handler. Note
    # that this means closing the lid on a docked device does suspend it,
    # unlike the power key above.
    ${DEBUG} && log $0 "Lid event left to logind: $2"
    ;;
esac

exit 0
