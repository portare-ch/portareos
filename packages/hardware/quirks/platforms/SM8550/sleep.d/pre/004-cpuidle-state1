### Give cpu0 its state1 back for the length of the suspend.
#
# 096-cpuidle disables cpu0's idle state1 at boot because leaving it on
# upsets the GMU while the GPU is in use. s2idle suspends *through*
# cpuidle, so that same disable stops cpu0 from ever power-collapsing
# once the system is asleep - and the RPMh sleep vote is only flushed by
# the last CPU going down. Left alone it keeps aosd, cxsd and ddr at zero
# no matter what else is configured, which is the bug this is part of
# fixing.
#
# The GPU is idle by the time anything suspends, so the reason for the
# boot-time disable does not apply here. 004-cpuidle-state1 in post/ puts
# it back, and writes the file unconditionally rather than trusting this
# one to have run: a resume that leaves state1 enabled is the failure this
# guards against.

STATE1=/sys/devices/system/cpu/cpu0/cpuidle/state1/disable
[ -w "${STATE1}" ] || exit 0

mkdir -p /run/portareos
cat "${STATE1}" > /run/portareos/cpuidle-state1 2>/dev/null
echo 0 > "${STATE1}"
