### Take cpu0's state1 away again now the GPU is coming back.
#
# The pre hook enables it for the suspend window; this restores the
# boot-time disable from 096-cpuidle. It writes 1 whenever the saved
# value is missing or unreadable rather than leaving the file alone,
# because the failure that matters is resuming with state1 still enabled
# and the GMU misbehaving - that is worse than a redundant write.

STATE1=/sys/devices/system/cpu/cpu0/cpuidle/state1/disable
[ -w "${STATE1}" ] || exit 0

SAVED=$(cat /run/portareos/cpuidle-state1 2>/dev/null)
case "${SAVED}" in
  0) echo 0 > "${STATE1}" ;;
  *) echo 1 > "${STATE1}" ;;
esac
rm -f /run/portareos/cpuidle-state1
