+static void count_first_pending(struct swapchain_data *data,
+                                const VkPastPresentationTimingGOOGLE *rec,
+                                frame_record why)
+{
+   swapchain_data::pending_present p = data->pending.front();
+   data->pending.pop_front();
+   count_present(data, p, rec, why);
+}
+
+/* Records retire in present order, so the presents before the one a record
+ * is for will never get theirs. A record for a present already counted, after
+ * the timeout, is dropped.
+ */
+static void take_record(struct swapchain_data *data,
+                        const VkPastPresentationTimingGOOGLE &rec)
+{
+   size_t n = 0;
+   while (n < data->pending.size() && data->pending[n].id != rec.presentID)
+      n++;
+   if (n == data->pending.size())
+      return;
+   for (; n > 0; n--)
+      count_first_pending(data, nullptr, frame_record::skipped);
+   count_first_pending(data, &rec, frame_record::ok);
+}
+
+/* Back to counting at present, for the rest of the swapchain's life. What is
+ * still pending is counted once, without a record.
+ */
+static void stop_display_timing(struct swapchain_data *data)
+{
+   {
+      std::lock_guard<std::mutex> lk(data->arrived_mutex);
+      data->collecting = false;
+      data->arrived.clear();
+   }
+   while (!data->pending.empty())
+      count_first_pending(data, nullptr, frame_record::end);
+   data->sw_stats.display_timing = false;
+   data->sw_stats.last_present_time = data->last_call_ns;
+}
+
+/* Everything the driver has, with an array as large as its queue, so it
+ * never drops a record.
+ */
+static void read_own_records(struct swapchain_data *data)
+{
+   struct device_data *device_data = data->device;
+   uint32_t count = data->own_records.size();
+   VkResult result = device_data->vtable.GetPastPresentationTimingGOOGLE(
+      device_data->device, data->swapchain, &count, data->own_records.data());
+   if (result != VK_SUCCESS && result != VK_INCOMPLETE) {
+      stop_display_timing(data);
+      return;
+   }
+   for (uint32_t k = 0; k < count; k++)
+      take_record(data, data->own_records[k]);
+}
+
+/* The layer's own read, or what the application read since its last present. */
+static void drain_records(struct swapchain_data *data)
+{
+   if (data->device->timing == display_timing_mode::own) {
+      read_own_records(data);
+      return;
+   }
+   std::vector<VkPastPresentationTimingGOOGLE> arrived;
+   {
+      std::lock_guard<std::mutex> lk(data->arrived_mutex);
+      arrived.swap(data->arrived);
+   }
+   for (auto &rec : arrived)
+      take_record(data, rec);
+}
+
+/* Before a present on a swapchain counted by display time: take the records
+ * that came, then count the presents that waited too long, then queue this
+ * one under the ID it carries. False when the swapchain falls back to
+ * counting at present instead.
+ */
+static bool display_timing_present(struct swapchain_data *data,
+                                   const VkPresentTimesInfoGOOGLE *app_times,
+                                   uint32_t swapchain_count, uint32_t *id)
+{
+   display_timing_mode timing = data->device->timing;
+   uint64_t now = os_time_get_nano();
+   uint64_t last_read_ns;
+   bool unread = false;
+
+   drain_records(data);
+   if (!data->sw_stats.display_timing)
+      return false;
+
+   {
+      std::lock_guard<std::mutex> lk(data->arrived_mutex);
+      last_read_ns = data->last_read_ns;
+   }
+   /* A present that timed out with no read by the application since it was
+    * made means the application does not read its records (RetroArch
+    * before 0020, on frames timed at the core's rate): none will come.
+    */
+   while (!data->pending.empty() &&
+          (now - data->pending.front().call_ns > record_timeout_ns ||
+           data->pending.size() > data->timing_capacity)) {
+      if (timing == display_timing_mode::observe && last_read_ns < data->pending.front().call_ns)
+         unread = true;
+      count_first_pending(data, nullptr, frame_record::timeout);
+   }
+
+   bool tagged = false;
+   if (swapchain_count == 1 && !unread) {
+      if (timing == display_timing_mode::own) {
+         *id = ++data->next_present_id;
+         tagged = true;
+      } else if (app_times && app_times->pTimes) {
+         *id = app_times->pTimes[0].presentID;
+         tagged = true;
+      }
