+   if (!tagged) {
+      stop_display_timing(data);
+      return false;
+   }
+   uint64_t app_ns = data->last_call_ns ? now - data->last_call_ns : 0;
+   data->pending.push_back({ *id, now, app_ns });
+   data->last_call_ns = now;
+   return true;
+}
