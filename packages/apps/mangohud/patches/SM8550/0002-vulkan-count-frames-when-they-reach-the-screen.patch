+/* The application's own read. What it got is kept for its next present and
+ * handed back untouched; the layer never reads in its place.
+ */
+static VkResult overlay_GetPastPresentationTimingGOOGLE(
+    VkDevice                                    device,
+    VkSwapchainKHR                              swapchain,
+    uint32_t*                                   pPresentationTimingCount,
+    VkPastPresentationTimingGOOGLE*             pPresentationTimings)
+{
+   struct device_data *device_data = FIND(struct device_data, device);
+   VkResult result = device_data->vtable.GetPastPresentationTimingGOOGLE(
+      device, swapchain, pPresentationTimingCount, pPresentationTimings);
+
+   if (pPresentationTimings && (result == VK_SUCCESS || result == VK_INCOMPLETE)) {
+      struct swapchain_data *swapchain_data = FIND(struct swapchain_data, swapchain);
+      if (swapchain_data) {
+         std::lock_guard<std::mutex> lk(swapchain_data->arrived_mutex);
+         swapchain_data->last_read_ns = os_time_get_nano();
+         if (swapchain_data->collecting)
+            swapchain_data->arrived.insert(swapchain_data->arrived.end(), pPresentationTimings,
+                                           pPresentationTimings + *pPresentationTimingCount);
+      }
+   }
+   return result;
+}
 
