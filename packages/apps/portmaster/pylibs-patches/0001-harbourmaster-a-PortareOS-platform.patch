From: portare-ch <hello@portare.org>
Subject: [PATCH] harbourmaster: a PortareOS platform

PortMaster picks a platform by the OS name and falls back to a default
that installs nothing of the OS's own. PortareOS ships control.txt,
mapper.txt and the controller database that name the pad's buttons as
they are printed; without a platform to copy them in, PortMaster's own
generic control.txt won on every update and the buttons came out in
SDL's order. No front end to refresh on exit: the launcher rescans the
ports folder when it gets the panel back.

--- a/pylibs/harbourmaster/platform.py
+++ b/pylibs/harbourmaster/platform.py
@@ -356,8 +356,41 @@
 
 class PlatformROCKNIX(PlatformJELOS):
     ES_NAME = 'weston'
+
+
+class PlatformPortareOS(PlatformBase):
+    """
+    PortareOS: the Retroid Pocket Nova, a launcher of its own on KMS, no
+    EmulationStation. The OS ships PortMaster's control.txt, mapper.txt and
+    controller database under /usr/config/PortMaster and copies them to
+    /storage/.config/PortMaster; they carry the pad's button names and the
+    ports' runtime paths, so they go into the PortMaster folder on every
+    install. Nothing to refresh on exit: the launcher rescans the ports
+    folder when it gets the panel back.
+    """
+    ES_NAME = None
+
+    def gamelist_file(self):
+        return self.hm.ports_dir / 'gamelist.xml'
+
+    def first_run(self):
+        self.portmaster_install([])
+
+    def portmaster_install(self, bash_files):
+        OS_PM_DIR = Path("/storage/.config/PortMaster")
+        PM_DIR = self.hm.tools_dir / "PortMaster"
+
+        if not OS_PM_DIR.is_dir():
+            shutil.copytree("/usr/config/PortMaster", OS_PM_DIR)
+
+        for name in ("control.txt", "gamecontrollerdb.txt", "mapper.txt"):
+            if (OS_PM_DIR / name).is_file():
+                shutil.copy(OS_PM_DIR / name, PM_DIR / name)
 
+        for oga_control in OS_PM_DIR.glob("oga_controls*"):
+            shutil.copy(oga_control, PM_DIR / oga_control.name)
 
+
 class PlatformBatocera(PlatformBase):
     MOVE_PM_BASH = False
     ES_NAME = "batocera-es"
@@ -1324,6 +1357,7 @@
     'unofficialos': PlatformUOS,
     'jelos':     PlatformJELOS,
     'rocknix':   PlatformROCKNIX,
+    'portareos': PlatformPortareOS,
     'batocera':  PlatformBatocera,
     'reglinux':  PlatformREGLinux,
     'knulli':    PlatformKnulli,
