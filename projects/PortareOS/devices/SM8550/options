################################################################################
# setup device defaults
################################################################################

  # The TARGET_CPU variable controls which processor should be targeted for
  # generated code.
    case ${TARGET_ARCH} in
      aarch64)
        TARGET_CPU="cortex-x3"
        TARGET_CPU_FLAGS="+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2"
        ;;
      arm)
        TARGET_KERNEL_ARCH="arm64"
        TARGET_FLOAT="hard"
        TARGET_CPU="cortex-a710"
        TARGET_CPU_FLAGS="+fp16+crypto+i8mm+bf16"
        TARGET_FPU="crypto-neon-fp-armv8"
        ;;
    esac

    PARTITION_TABLE="gpt"
    HW_CPU="Snapdragon 8 Gen2"

  # Kernel target
    KERNEL_TARGET="Image"

  # Additional kernel make parameters (for example to specify the u-boot loadaddress)
    KERNEL_MAKE_EXTRACMD=" $(get_kernel_make_extracmd)"

  # Kernel cmdline
    EXTRA_CMDLINE="quiet rootwait console=tty0 allow_mismatched_32bit_el0 fw_devlink.strict=1 pcie_ports=compat irqaffinity=0-2 cgroup.memory=nokmem,nosocket nosoftlockup usbcore.interrupt_interval_override=045e:028e:2 ufshcd_core.uic_cmd_timeout=3000 mem_sleep_default=s2idle cpuidle.governor=teo"

  # Bootloader to use (syslinux / u-boot)
    BOOTLOADER="qcom-abl"

  # Adreno GPU family
    GRAPHIC_DRIVERS="freedreno"

  # For maximum cross compatbility
    PREFER_GLES="no"

  # VULKAN_SUPPORT
    VULKAN_SUPPORT="yes"

  # Vulkan implementation to use (vulkan-loader / no)
    VULKAN="vulkan-loader"

  # Displayserver to use (wl / no)
    DISPLAYSERVER="wl"

  # Windowmanager to use (swaywm-env / no)
    # No window manager. The front-end takes DRM master itself and the two
    # things that still want a wayland socket - Steam and gamescope - bring
    # their own compositor. DISPLAYSERVER stays "wl" because that is what
    # carries the wayland libraries they link against.
    WINDOWMANAGER=""

  # Additional drivers to install:
  # for a list of additional drivers see packages/linux-drivers
  # Space separated list is supported,
  # e.g. ADDITIONAL_DRIVERS="DRIVER1 DRIVER2"
    ADDITIONAL_DRIVERS=""

  # Additional Firmware to use ( )
  # Space separated list is supported,
  # e.g. FIRMWARE=""
    FIRMWARE="extra-firmware nova-firmware"

  # Additional packages to install
    ADDITIONAL_PACKAGES="gamepadcalibration portareos-abl inputplumber"

  # Debug tty path
    DEBUG_TTY="/dev/ttyMSM0"

  # ZRAM Algorithm
    ZRAM_COMPRESSION_ALGO="zstd"

  # ZRAM Size
    ZRAM_SWAP_SIZE="Auto"

  # Disk Swap
    SWAP_FILE_SIZE="0"
