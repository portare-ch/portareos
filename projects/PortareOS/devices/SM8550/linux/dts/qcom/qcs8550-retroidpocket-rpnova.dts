/dts-v1/;

#include "qcs8550-retroidpocket-rp6.dts"

/ {
	model = "Retroid Pocket Nova";
	compatible = "retroidpocket,rpnova", "qcom,qcs8550", "qcom,sm8550";
};

/*
 * The Nova's own DSP and speaker amplifier firmware (package
 * nova-firmware, from its Android build) rather than the Odin 2's the
 * RP6 tree names. The ADSP runs the audio graph and the charger
 * interface; the amplifiers' tuning is the Nova speakers' own.
 */
/*
 * The three thermistors Retroid wired to the PMICs, read through the
 * PMK8550's ADC: the crystal's (PMK8550 AMUX1), the USB-C connector's and
 * the one Android calls wireless-charging (PM8550B AMUX4 and AMUX6; the
 * Nova has no wireless charging, where that thermistor sits on the board
 * is read from the temperatures, not from the name). Channel numbers,
 * settle time and the names are the Nova's Android device tree's. Each
 * is a thermal zone so fancontrol can read it; the single trip is the
 * placeholder Android uses too, there is no kernel mitigation on these.
 */
&pmk8550_vadc {
	channel@44 {
		reg = <ADC5_GEN3_AMUX1_THM_100K_PU(0)>;
		label = "pmk8550_xo_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	channel@747 {
		reg = <ADC5_GEN3_AMUX4_THM_100K_PU(7)>;
		label = "pm8550b_usb_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};

	channel@749 {
		reg = <ADC5_GEN3_AMUX6_THM_100K_PU(7)>;
		label = "pm8550b_wls_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
		qcom,adc-tm;
	};
};

/ {
	thermal-zones {
		xo-thermal {
			thermal-sensors = <&pmk8550_vadc ADC5_GEN3_AMUX1_THM_100K_PU(0)>;

			trips {
				trip-point0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		usb-thermal {
			thermal-sensors = <&pmk8550_vadc ADC5_GEN3_AMUX4_THM_100K_PU(7)>;

			trips {
				trip-point0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		wls-thermal {
			thermal-sensors = <&pmk8550_vadc ADC5_GEN3_AMUX6_THM_100K_PU(7)>;

			trips {
				trip-point0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};
	};
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8550/retroidpocket/rpnova/adsp.mbn",
			"qcom/sm8550/retroidpocket/rpnova/adsp_dtb.mbn";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm8550/retroidpocket/rpnova/cdsp.mbn",
			"qcom/sm8550/retroidpocket/rpnova/cdsp_dtb.mbn";
};

/*
 * The Nova's tuning file holds one block per amplifier, picked by
 * audio-channel; the two differ only in the I2S channel select
 * (register 0x06). Android gives 0x34 channel 1 and 0x35 channel 0;
 * the Odin 2's values the other way round played left on the right.
 */
&spk_amp_l {
	firmware-name = "qcom/sm8550/retroidpocket/rpnova/aw883xx_acf.bin";
	awinic,audio-channel = <1>;
};

&spk_amp_r {
	firmware-name = "qcom/sm8550/retroidpocket/rpnova/aw883xx_acf.bin";
	awinic,audio-channel = <0>;
};

&mdss_dsi0 {
	panel@0 {
		compatible = "il97680a,rpnova";
		/delete-property/ rotation;
		/*
		 * The Nova's own rails, as Android and Retroid's tree have
		 * them. The RP6 node supplied vddio and avdd, and the driver
		 * asks for vdd, vddio, vci, vdd18 and vdd28: avdd went unused,
		 * and the 2.8 V and 1.2 V rails stayed as the bootloader left
		 * them, on through every blank and suspend.
		 */
		/delete-property/ avdd-supply;
		vdd-supply = <&vreg_l11b_1p2>;
		vddio-supply = <&vreg_l12b_1p8>;
		vci-supply = <&vreg_l13b_3p0>;
		vdd18-supply = <&vdd_disp_1v8>;
		vdd28-supply = <&vdd_disp_2v8>;
		/*
		 * The DPU turns output dithering off at 8bpc, so the 10-bit
		 * result of a colour profile is truncated onto the panel and
		 * dark gradients step. Kernel patch 0049 reads this.
		 */
		armada,dpu-8bpc-dither;
	};
};

/* GPIO 142 is the RP6's; Android's qcom,platform-mipi-2v8 is 143. */
&vdd_disp_2v8 {
	gpio = <&tlmm 143 GPIO_ACTIVE_HIGH>;
};

&i2c_hub_3 {
	/*
	 * Byte-at-a-time reads (the AYN i2c_hub workaround inherited from the
	 * RP6) take 63 transfers per ft5426 frame and cap touch at ~28 Hz.
	 * Bulk reads at 400 kHz keep up with the controller's 120 Hz reports.
	 */
	clock-frequency = <400000>;

	touchscreen@38 {
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <960>;
		/delete-property/ touchscreen-inverted-y;
		/delete-property/ no-regmap-bulk-read;
		/*
		 * The RP6 node's ts_p states are GPIO 24/25, the reference
		 * board's touch pins and unused here; the Nova's reset and
		 * interrupt are 14 and 15, which the ts_s states configure the
		 * way Android's ts_active1/ts_suspend1 do.
		 */
		pinctrl-0 = <&ts_s_rst_default &ts_s_int_default>;
		pinctrl-1 = <&ts_s_rst_sleep &ts_s_int_sleep>;
	};
};

&gamepad {
	invert-x;
	invert-y;
	trigger-left-deadzone = <100>;
	trigger-right-deadzone = <100>;
};
