From: PortareOS <hello@portare.org>
Subject: [PATCH] drm/panel: il97680a: report the panel's own error count

tear-test showed no torn frame reaching the DSI on the SNES mode, and
dsi_err_worker logged nothing through thousands of frames at 1050.7MHz
a lane. Both instruments sit on this side of the link. The panel is the
only thing that can say whether it is unhappy with what arrives, and
DCS has a command for exactly that.

RDNUMED, MIPI_DCS_GET_ERROR_COUNT_ON_DSI, returns the number of errors
the panel has counted on the link since the last read - ECC, checksum,
and the contention and timeout conditions - in the low six bits. Reading
it clears it, so two reads a known interval apart give a rate.

RDDPM and RDDSDR come with it: power mode proves a read reached the
panel at all, which matters because an unsupported RDNUMED and a link
too broken to answer look alike otherwise, and the diagnostic result
says whether the panel's own register and functionality checks passed.

Exposed as a sysfs file rather than taken at init, because the question
is what the link does under load:

    cat /sys/bus/mipi-dsi/devices/*/dsi_errors

A read needs a bus turnaround, which the host only does in low power
mode, so the flag is set for the read and put back. This is a debug
read taken while a video-mode stream is running: it may disturb a
frame, and a panel that does not implement RDNUMED will say so rather
than returning a zero that looks like good news.

--- a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -50,6 +50,7 @@
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
+#include <linux/sysfs.h>
 
 #include <video/mipi_display.h>
 
@@ -659,6 +660,62 @@
 	return 0;
 }
 
+/*
+ * The panel's own view of the link. Everything else that reports on the DSI -
+ * the host's error worker, the DPU's per-frame CRC - sits on this side of it
+ * and cannot see a byte the panel received wrongly.
+ *
+ * RDNUMED clears on read, so a rate needs two reads a known interval apart.
+ * RDDPM is read first because an unsupported RDNUMED and a link too broken to
+ * answer are otherwise the same result.
+ */
+static ssize_t dsi_errors_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	unsigned long saved = dsi->mode_flags;
+	u8 power = 0, errs = 0, diag = 0;
+	ssize_t ret;
+	int n = 0;
+
+	/* A read needs a bus turnaround, which the host only does in LP. */
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_read(dsi, MIPI_DCS_GET_POWER_MODE, &power, 1);
+	if (ret < 0) {
+		dsi->mode_flags = saved;
+		return sysfs_emit(buf,
+				  "no answer from the panel: %zd\n"
+				  "  it may be off, or reads may not work while\n"
+				  "  the video stream is running\n", ret);
+	}
+	n += sysfs_emit_at(buf, n, "power_mode  0x%02x\n", power);
+
+	ret = mipi_dsi_dcs_read(dsi, MIPI_DCS_GET_ERROR_COUNT_ON_DSI, &errs, 1);
+	if (ret < 0)
+		n += sysfs_emit_at(buf, n, "error_count unsupported: %zd\n", ret);
+	else
+		n += sysfs_emit_at(buf, n,
+				   "error_count %u   (since the last read)\n",
+				   errs & 0x3f);
+
+	ret = mipi_dsi_dcs_read(dsi, MIPI_DCS_GET_DIAGNOSTIC_RESULT, &diag, 1);
+	if (ret < 0)
+		n += sysfs_emit_at(buf, n, "diagnostic  unsupported: %zd\n", ret);
+	else
+		n += sysfs_emit_at(buf, n, "diagnostic  0x%02x\n", diag);
+
+	dsi->mode_flags = saved;
+	return n;
+}
+static DEVICE_ATTR_RO(dsi_errors);
+
+static struct attribute *il97680a_attrs[] = {
+	&dev_attr_dsi_errors.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(il97680a);
+
 static int il97680a_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -690,7 +748,8 @@
 	.driver = {
 		.name = "panel-ilitek-il97680a",
 		.of_match_table = il97680a_of_match,
+		.dev_groups = il97680a_groups,
 	},
 };
 
