From: PortareOS <hello@portare.org>
Subject: [PATCH] serial: qcom-geni: re-enable the masked IRQ when a forced sleep transition fails

Upstream d0cd9c8d ("serial: qcom-geni: add force suspend/resume to
system sleep callbacks") is in 7.3. What remains of the 7.2 backport is
its error handling on top of 1006's IRQ mask: a failed force suspend
resumes the port and unmasks the IRQ, and a failed force resume unmasks
it, so neither failure leaves a non-console UART with its IRQ disabled.
---
diff --git a/drivers/tty/serial/qcom_geni_serial.c b/drivers/tty/serial/qcom_geni_serial.c
index 11d6163ae..d45b5d23e 100644
--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -2129,7 +2129,12 @@ static int qcom_geni_serial_suspend(struct device *dev)
 	if (!console_suspend_enabled && uart_console(uport))
 		return 0;
 
-	return pm_runtime_force_suspend(dev);
+	ret = pm_runtime_force_suspend(dev);
+	if (ret && !uart_console(uport)) {
+		uart_resume_port(private_data->drv, uport);
+		enable_irq(uport->irq);
+	}
+	return ret;
 }
 
 static int qcom_geni_serial_resume(struct device *dev)
@@ -2141,8 +2146,11 @@ static int qcom_geni_serial_resume(struct device *dev)
 
 	if (console_suspend_enabled || !uart_console(uport)) {
 		ret = pm_runtime_force_resume(dev);
-		if (ret)
+		if (ret) {
+			if (!uart_console(uport))
+				enable_irq(uport->irq);
 			return ret;
+		}
 	}
 
 	ret = uart_resume_port(private_data->drv, uport);
