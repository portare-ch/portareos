-		 * +0.35ppm from 2 x 59.82610, a frame in about 8 hours.
+		 * +2.6ppm from 2 x 59.82610, a frame in about 2 hours.
 		 *
 		 * The NTSC PlayStation in 240p is the same rate: 263 lines of
 		 * 3412.5 GPU clocks at 53.693175MHz, 59.82610 too, since the
@@ -267,7 +268,7 @@
 		 * it the core rounded the line to 3413 clocks, ran at 59.8173,
 		 * and had a 155920kHz mode of its own here.
 		 */
-		.clock = 155943,
+		.clock = 155476,
 		.hdisplay = 1280,
 		.hsync_start = 1280 + 12,
 		.hsync_end = 1280 + 12 + 2,
@@ -275,7 +276,7 @@
 		.vdisplay = 960,
 		.vsync_start = 960 + 12,
 		.vsync_end = 960 + 12 + 2,
-		.vtotal = 960 + 12 + 2 + 27,
+		.vtotal = 960 + 12 + 2 + 24,
 	},
 	{
 		/*
@@ -288,15 +289,15 @@
 		 *                                        every 28 seconds
 		 *   119.845592 / 59.92274 = 2.00000   <- this one
 		 *
-		 *   156195000 / (1302 * 1001) = 119.84559...
