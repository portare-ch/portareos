From: PortareOS <hello@portare.org>
Subject: [PATCH] drm/msm/dp: Adaptive-Sync sinks

A DP sink that may ignore the MSA timing (DPCD 0x007 bit 6) follows the
frame length it is sent, within the vertical range of its EDID. Mark
the connector vrr_capable when the sink says so, is not a branch device
and has a range wider than 10 Hz, the rule i915 and amdgpu use, and
clear it on unplug. While capable, link training sets
MSA_TIMING_PAR_IGNORE_EN (DPCD 0x107 bit 7), as i915 does, so turning
VRR on and off later needs no new training.

The variable frame length itself is the DPU's AVR (patches 1097, 1129).
---
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1671,6 +1671,12 @@
 
 	if (drm_dp_max_downspread(dpcd))
 		encoding[0] |= DP_SPREAD_AMP_0_5;
+	/*
+	 * Set whenever the sink can, as i915 does, so that VRR_ENABLED then
+	 * changes only the DPU's AVR and never needs the link trained again.
+	 */
+	if (panel->adaptive_sync)
+		encoding[0] |= DP_MSA_TIMING_PAR_IGNORE_EN;
 
 	/* config DOWNSPREAD_CTRL and MAIN_LINK_CHANNEL_CODING_SET */
 	drm_dp_dpcd_write(ctrl->aux, DP_DOWNSPREAD_CTRL, encoding, 2);
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -262,6 +262,22 @@
 	return lttpr_count;
 }
 
+/*
+ * Adaptive-Sync: a sink that may ignore the MSA timing follows the frame
+ * length it is sent, within the range its EDID gives. Not through a branch
+ * device, and not on a range too narrow to use, as i915 and amdgpu decide.
+ */
+static bool msm_dp_display_adaptive_sync(struct msm_dp_display_private *dp)
+{
+	const struct drm_display_info *info = &dp->msm_dp_display.connector->display_info;
+	const u8 *dpcd = dp->panel->dpcd;
+
+	return !dp->msm_dp_display.is_edp &&
+	       drm_dp_sink_can_do_video_without_timing_msa(dpcd) &&
+	       !drm_dp_is_branch(dpcd) &&
+	       info->monitor_range.max_vfreq > info->monitor_range.min_vfreq + 10;
+}
+
 static int msm_dp_display_process_hpd_high(struct msm_dp_display_private *dp)
 {
 	struct drm_connector *connector = dp->msm_dp_display.connector;
@@ -283,6 +299,9 @@
 	drm_edid = drm_edid_read_ddc(connector, &dp->aux->ddc);
 	drm_edid_connector_update(connector, drm_edid);
 
+	dp->panel->adaptive_sync = msm_dp_display_adaptive_sync(dp);
+	drm_connector_set_vrr_capable_property(connector, dp->panel->adaptive_sync);
+
 	if (!drm_edid) {
 		DRM_ERROR("panel edid read failed\n");
 		/* check edid read fail is due to unplug */
@@ -479,8 +498,12 @@
 		return 0;
 
 	/* Don't forget modes for eDP */
-	if (!dp->msm_dp_display.is_edp)
+	if (!dp->msm_dp_display.is_edp) {
 		drm_edid_connector_update(dp->msm_dp_display.connector, NULL);
+		dp->panel->adaptive_sync = false;
+		drm_connector_set_vrr_capable_property(dp->msm_dp_display.connector,
+						       false);
+	}
 
 	/* triggered by irq_hdp with sink_count = 0 */
 	if (dp->link->sink_count == 0)
--- a/drivers/gpu/drm/msm/dp/dp_drm.c
+++ b/drivers/gpu/drm/msm/dp/dp_drm.c
@@ -368,8 +368,10 @@
 	if (IS_ERR(connector))
 		return connector;
 
-	if (!msm_dp_display->is_edp)
+	if (!msm_dp_display->is_edp) {
 		drm_connector_attach_dp_subconnector_property(connector);
+		drm_connector_attach_vrr_capable_property(connector);
+	}
 
 	return connector;
 }
--- a/drivers/gpu/drm/msm/dp/dp_panel.h
+++ b/drivers/gpu/drm/msm/dp/dp_panel.h
@@ -30,6 +30,8 @@
 struct msm_dp_panel {
 	/* dpcd raw data */
 	u8 dpcd[DP_RECEIVER_CAP_SIZE];
+	/* the sink follows the frame length we send: MSA timing ignored */
+	bool adaptive_sync;
 	u8 downstream_ports[DP_MAX_DOWNSTREAM_PORTS];
 
 	struct msm_dp_link_info link_info;
