From: PortareOS <hello@portare.org>
Subject: [PATCH] drm/msm/dp: do not record a failed PHY init as done

msm_dp_display_host_phy_init() set phy_initialized whatever
phy_init() returned. After a failure the PHY core's init count is
still zero; the phy_exit() that then pairs with the recorded init takes
it to -1, and from there every later phy_init() skips the PHY's init
callback (the count is no longer zero) and every phy_exit() skips exit.
The DisplayPort PHY is never initialised again until reboot, silently:
seen on the Retroid Pocket Nova as one WARN at a game launch and no
further ones from identical probes afterwards.

Return phy_init()'s result from msm_dp_ctrl_phy_init() and only mark
the PHY initialised when it succeeded. A failed probe then reports the
connector disconnected and leaves the PHY in a state the next probe can
initialise.
---
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 59070f399..a20d1e1e8 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1955,7 +1955,7 @@ static void msm_dp_ctrl_phy_reset(struct msm_dp_ctrl_private *ctrl)
 	msm_dp_write_ahb(ctrl, REG_DP_PHY_CTRL, 0x0);
 }
 
-void msm_dp_ctrl_phy_init(struct msm_dp_ctrl *msm_dp_ctrl)
+int msm_dp_ctrl_phy_init(struct msm_dp_ctrl *msm_dp_ctrl)
 {
 	struct msm_dp_ctrl_private *ctrl;
 	struct phy *phy;
@@ -1964,7 +1964,7 @@ void msm_dp_ctrl_phy_init(struct msm_dp_ctrl *msm_dp_ctrl)
 	phy = ctrl->phy;
 
 	msm_dp_ctrl_phy_reset(ctrl);
-	phy_init(phy);
+	return phy_init(phy);
 }
 
 void msm_dp_ctrl_phy_exit(struct msm_dp_ctrl *msm_dp_ctrl)
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.h b/drivers/gpu/drm/msm/dp/dp_ctrl.h
index 5902cf7e7..42c5f847c 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.h
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.h
@@ -39,7 +39,7 @@ struct msm_dp_ctrl *msm_dp_ctrl_get(struct device *dev,
 
 void msm_dp_ctrl_reset(struct msm_dp_ctrl *msm_dp_ctrl,
 		       struct msm_dp_panel *panel);
-void msm_dp_ctrl_phy_init(struct msm_dp_ctrl *msm_dp_ctrl);
+int msm_dp_ctrl_phy_init(struct msm_dp_ctrl *msm_dp_ctrl);
 void msm_dp_ctrl_phy_exit(struct msm_dp_ctrl *msm_dp_ctrl);
 void msm_dp_ctrl_irq_phy_exit(struct msm_dp_ctrl *msm_dp_ctrl);
 
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 4dcbd9b99..cfa34e055 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -332,7 +332,14 @@ static bool msm_dp_display_host_phy_init(struct msm_dp_display_private *dp)
 		dp->phy_initialized);
 
 	if (!dp->phy_initialized) {
-		msm_dp_ctrl_phy_init(dp->ctrl);
+		/*
+		 * A failed phy_init() leaves the PHY's init count at zero. If
+		 * it were recorded as initialised, the matching phy_exit()
+		 * would take the count to -1 and no later phy_init() would
+		 * ever run the PHY's init again.
+		 */
+		if (msm_dp_ctrl_phy_init(dp->ctrl))
+			return false;
 		dp->phy_initialized = true;
 		return true;
 	}
