From: PortareOS <hello@portare.org>
Subject: [PATCH] drm/msm/dpu: a VRR floor per client, and repeats that are never behind

The panel declares an 80 Hz floor. That suits the emulators: LFC shows a
game of up to 60.1 Hz two or more times a frame, and RetroArch refuses
anything faster that does not fit twice. A PC game runs at any rate. A
commit has to land about 1.8 ms before the floor runs out to start the
refresh (measured on the Nova), so on 80 Hz a frame shown once only works
from about 93 Hz, and one between 60.7 and 93 Hz fits neither way: shown
twice it is faster than the panel, once it is longer than the floor
allows. For a frame of just over 60.1 Hz to be shown once, the floor has
to be 54 Hz or lower.

msm.dpu_vrr_min_hz sets the floor, as a rate, for the next time VRR goes
on; 0 is the panel's own. AVR_VTOTAL is written in the commit that turns
VRR on, with AVR still off and the INTF in that commit's flush, so each
client has the floor it asked for without a mode set. The kernel logs it
with "variable refresh on".

LFC's count is now as many of the mode's refreshes as fit in the period,
so the panel is never behind on the next frame. The fiftieth of a
refresh of slack stays where that would leave a refresh too close to the
floor; on 80 Hz that is everywhere it made a difference, so the counts
there are the same from 25 Hz up. On a floor low enough for a frame of
two refreshes, a source of 60.1 to 60.7 Hz is shown once a frame instead
of twice with a refresh missing now and then, and 40.2 or 30.1 Hz once
fewer instead of a refresh short. The slack still keeps a running count,
so a 60 Hz game on the 120 Hz mode, two refreshes exactly, stays doubled
through the noise in its period.
---
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
@@ -146,6 +146,7 @@
  *	but @timer are under the encoder's spinlock.
  * @timer:		Starts the next repeat
  * @refresh_ns:		The mode's frame, the shortest refresh
+ * @floor_ns:		The range's floor, the longest frame AVR holds
  * @last_commit:	When the last frame was kicked off
  * @last_interval:	The distance of that kickoff from the one before
  * @period:		The frame period, 0 until two kickoffs agree on one
@@ -161,6 +162,7 @@
 struct dpu_encoder_lfc {
 	struct hrtimer timer;
 	u64 refresh_ns;
+	u64 floor_ns;
 	ktime_t last_commit;
 	u64 last_interval;
 	u64 period;
@@ -208,6 +210,10 @@
  * @pending_kickoff_wq:		Wait queue for blocking until kickoff completes
  * @irq:			IRQ indices
  * @has_intf_te:		Interface TE configuration support
+ * @avr_min_hz:		The floor of the panel's own range
+ * @avr_htotal:		The mode's line, in pixels, for AVR's longest frame
+ * @avr_vtotal:		The mode's frame, in lines
+ * @avr_clock_khz:	The mode's pixel clock
  * @lfc:			Low framerate compensation, video mode with AVR
  */
 struct dpu_encoder_phys {
@@ -237,6 +243,10 @@
 	bool has_intf_te;
 	bool avr_capable;
 	bool avr_enabled;
+	unsigned int avr_min_hz;
+	u32 avr_htotal;
+	u32 avr_vtotal;
+	int avr_clock_khz;
 	struct dpu_encoder_lfc lfc;
 };
 
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -275,10 +275,50 @@
 	lfc->waiting = false;
 }
 
+static unsigned int dpu_vrr_min_hz;
+
 /*
+ * The floor of the variable refresh range, as a rate, taken the next time
+ * VRR goes on; 0 is the panel's own. A client that wants another sets it
+ * before it takes the display. The Nova's emulators keep the panel's 80
+ * Hz: RetroArch shows a game of up to 60.1 Hz twice or more and refuses
+ * one that does not fit twice. A PC game runs at any rate, and a frame
+ * shown once has to be committed about 2 ms before the floor runs out:
+ * Steam asks for 50, so that one just over 60.1 Hz still is. A floor at
+ * or above the mode's rate is ignored.
+ */
+module_param(dpu_vrr_min_hz, uint, 0644);
+MODULE_PARM_DESC(dpu_vrr_min_hz, "Floor of the variable refresh range in Hz, taken when VRR goes on (0: the panel's)");
+
+/*
+ * Programs AVR's longest frame and returns its rate. Under the encoder's
+ * spinlock, with AVR off.
+ */
+static unsigned int dpu_encoder_phys_vid_avr_floor(struct dpu_encoder_phys *phys_enc)
+{
+	u64 pixels_per_s = (u64)phys_enc->avr_clock_khz * 1000;
+	unsigned int min_hz = READ_ONCE(dpu_vrr_min_hz);
+	u64 lines = 0;
+
+	if (min_hz)
+		lines = div64_u64(pixels_per_s, (u64)phys_enc->avr_htotal * min_hz);
+	if (lines <= phys_enc->avr_vtotal) {
+		min_hz = phys_enc->avr_min_hz;
+		lines = div64_u64(pixels_per_s, (u64)phys_enc->avr_htotal * min_hz);
+	}
+	phys_enc->hw_intf->ops.setup_avr(phys_enc->hw_intf,
+					 (u32)(lines * phys_enc->avr_htotal));
+	phys_enc->lfc.floor_ns = div_u64(lines * phys_enc->avr_htotal * 1000000,
+					 phys_enc->avr_clock_khz);
+
+	return min_hz;
+}
+
+/*
  * Variable refresh from the INTF's AVR, for a DSI panel that declares a
  * refresh range: the mode's frame is the shortest, the range's minimum
- * gives the longest. The CRTC's VRR_ENABLED switches it per commit.
+ * gives the longest unless msm.dpu_vrr_min_hz asks for another. The CRTC's
+ * VRR_ENABLED switches it per commit.
  */
 static void dpu_encoder_phys_vid_setup_avr(struct dpu_encoder_phys *phys_enc,
 		const struct dpu_hw_intf_timing_params *timing, int clock_khz)
@@ -305,7 +345,11 @@
 	dpu_encoder_phys_vid_lfc_reset(&phys_enc->lfc);
 	phys_enc->lfc.refresh_ns = 0;
 	if (lines > vtotal && clock_khz) {
-		intf->ops.setup_avr(intf, (u32)(lines * htotal));
+		phys_enc->avr_min_hz = min_hz;
+		phys_enc->avr_htotal = htotal;
+		phys_enc->avr_vtotal = vtotal;
+		phys_enc->avr_clock_khz = clock_khz;
+		dpu_encoder_phys_vid_avr_floor(phys_enc);
 		phys_enc->avr_capable = true;
 		phys_enc->lfc.refresh_ns = div_u64((u64)vtotal * htotal * 1000000,
 						   clock_khz);
@@ -350,6 +394,7 @@
 	bool want = phys_enc->avr_capable &&
 		    phys_enc->enable_state == DPU_ENC_ENABLED &&
 		    dpu_encoder_vrr_enabled(phys_enc->parent);
+	unsigned int floor_hz = 0;
 	unsigned long lock_flags;
 
 	if (want == phys_enc->avr_enabled)
@@ -363,6 +408,8 @@
 	 * when nothing can arm it again before the next frame.
 	 */
 	spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
+	if (want)
+		floor_hz = dpu_encoder_phys_vid_avr_floor(phys_enc);
 	phys_enc->hw_intf->ops.enable_avr(phys_enc->hw_intf, want);
 	phys_enc->avr_enabled = want;
 	dpu_encoder_phys_vid_lfc_reset(&phys_enc->lfc);
@@ -374,18 +421,24 @@
 	if (!want)
 		dpu_encoder_set_dsi_avr(phys_enc->parent, false);
 
-	DRM_INFO("intf%d: variable refresh %s\n",
-		 phys_enc->hw_intf->idx - INTF_0, want ? "on" : "off");
+	if (want)
+		DRM_INFO("intf%d: variable refresh on, floor %u Hz\n",
+			 phys_enc->hw_intf->idx - INTF_0, floor_hz);
+	else
+		DRM_INFO("intf%d: variable refresh off\n",
+			 phys_enc->hw_intf->idx - INTF_0);
 }
 
 /*
  * Low framerate compensation. AVR holds the front porch until a frame is
- * committed, up to the range's longest frame; a frame slower than twice the
- * fastest refresh would then be refreshed by the panel on its own, at a time
- * unrelated to the next frame, which waits out a whole refresh. Instead it
- * is shown count = period / refresh times, evenly: after each of its
- * refreshes a timer writes AVR_TRIGGER at the frame's kickoff plus
- * shown * period / count. A trigger written while the INTF still scans the
+ * committed, up to the range's longest frame. A frame that lasts two of
+ * the mode's refreshes or more is shown count = period / refresh times
+ * instead, evenly: after each of its refreshes a timer writes AVR_TRIGGER
+ * at the frame's kickoff plus shown * period / count. Past the floor that
+ * keeps the panel from refreshing on its own, at a time unrelated to the
+ * next frame, which then waits out a whole refresh. Inside a range wider
+ * than two to one it is still taken: a late frame then has most of a
+ * refresh to spare, not what is left to the floor. A trigger written while the INTF still scans the
  * refresh before is kept for that refresh's end, so a repeat the panel is
  * behind on starts there and the panel catches up. The period comes from
  * the kickoffs, so this covers every client and costs no commit.
@@ -399,6 +452,13 @@
 /* Frames slower than 10 Hz are a pause, not a frame rate. */
 #define DPU_LFC_MAX_PERIOD_NS	(100 * NSEC_PER_MSEC)
 
+/*
+ * A commit that comes less than 1.6 to 1.8 ms before the floor runs out no
+ * longer starts the refresh (measured on the Nova), so a refresh closer to
+ * the floor than this is too long.
+ */
+#define DPU_LFC_FLOOR_LEAD_NS	(2 * NSEC_PER_MSEC)
+
 /* Under the encoder's spinlock. */
 static bool dpu_encoder_phys_vid_lfc_on(struct dpu_encoder_phys *phys_enc)
 {
@@ -492,6 +552,36 @@
 }
 
 /*
+ * How many times the frame on screen is refreshed: as many of the mode's
+ * refreshes as fit in its period, so the panel is never behind on the
+ * next frame. Where that leaves a refresh too close to the floor for the
+ * next commit to start it, a fiftieth of a refresh of slack may make it one
+ * more: a frame of exactly two refreshes, the SNES on the 120.198 Hz mode,
+ * does not round down to one on the 80 Hz floor, and the panel is behind
+ * now and then rather than waiting on its own refresh. The slack also keeps
+ * a count running, so that a source at half the mode's rate on a floor
+ * that would take it either way, a 60 Hz PC game, does not switch between
+ * the two on the noise in its period. Under the encoder's spinlock.
+ */
+static unsigned int dpu_encoder_phys_vid_lfc_count(const struct dpu_encoder_lfc *lfc)
+{
+	u64 slack = lfc->refresh_ns / 50;
+	unsigned int count;
+
+	if (!lfc->period || lfc->period > DPU_LFC_MAX_PERIOD_NS)
+		return 0;
+
+	count = div64_u64(lfc->period, lfc->refresh_ns);
+	if (!count ||
+	    div_u64(lfc->period, count) + DPU_LFC_FLOOR_LEAD_NS > lfc->floor_ns ||
+	    (lfc->count > count &&
+	     lfc->period + slack >= (u64)lfc->count * lfc->refresh_ns))
+		count = div64_u64(lfc->period + slack, lfc->refresh_ns);
+
+	return count < 2 ? 0 : count;
+}
+
+/*
  * A frame was kicked off. The kickoffs of a steady source fall on a grid,
  * the content's own clock, which stands in for a timed client's targets. A
  * kickoff within an eighth of a period of its place on the grid pulls the
@@ -504,9 +594,7 @@
  * alike are a new rate, and the grid starts again from them, as it starts
  * from the first two, when both kickoffs missed the grid or the distance
  * is more than an eighth off the period: a doubled rate puts every second
- * frame back on the old grid, and the misses alone never add up. A fiftieth of a
- * refresh of slack keeps a frame of exactly two refreshes, the SNES on the
- * 120.198 Hz mode, from rounding down to one.
+ * frame back on the old grid, and the misses alone never add up.
  */
 static void dpu_encoder_phys_vid_lfc_kickoff(struct dpu_encoder_phys *phys_enc)
 {
@@ -555,12 +643,7 @@
 		lfc->misses = 0;
 	}
 
-	lfc->count = 0;
-	if (lfc->period && lfc->period <= DPU_LFC_MAX_PERIOD_NS)
-		lfc->count = div64_u64(lfc->period + lfc->refresh_ns / 50,
-				       lfc->refresh_ns);
-	if (lfc->count < 2)
-		lfc->count = 0;
+	lfc->count = dpu_encoder_phys_vid_lfc_count(lfc);
 	trace_dpu_enc_lfc_frame(DRMID(phys_enc->parent),
 				phys_enc->hw_intf->idx - INTF_0,
 				seen, lfc->period, err, lfc->count);
