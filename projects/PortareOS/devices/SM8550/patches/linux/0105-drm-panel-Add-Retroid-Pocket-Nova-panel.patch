+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -0,0 +1,661 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Ilitek IL97680A panels driver
+ *
+ * Copyright (c) 2026 Teguh Sobirin <teguh@sobir.in>
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct panel_info {
+	struct drm_panel panel;
+	struct drm_connector *connector;
+	struct mipi_dsi_device *dsi;
+	struct panel_desc *desc;
+	enum drm_panel_orientation orientation;
+
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+};
+
+struct panel_desc {
+	unsigned int width_mm;
+	unsigned int height_mm;
+
+	unsigned int bpc;
+	unsigned int lanes;
+	unsigned long mode_flags;
+	enum mipi_dsi_pixel_format format;
+
+	const struct drm_display_mode *modes;
+	unsigned int num_modes;
+	int (*init_sequence)(struct panel_info *pinfo);
+};
+
+static const struct regulator_bulk_data panel_supplies[] = {
+	{ .supply = "vdd" },
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+	{ .supply = "vdd18" },
+	{ .supply = "vdd28" },
+};
+
+static inline struct panel_info *to_panel_info(struct drm_panel *panel)
+{
+	return container_of(panel, struct panel_info, panel);
+}
+
+static int il97680a_get_current_mode(struct panel_info *pinfo)
+{
+	struct drm_connector *connector = pinfo->connector;
+	struct drm_crtc_state *crtc_state;
+	int i;
+
+	/* Return the default (first) mode if no info available yet */
+	if (!connector->state || !connector->state->crtc)
+		return 0;
+
+	crtc_state = connector->state->crtc->state;
+
+	for (i = 0; i < pinfo->desc->num_modes; i++) {
+		if (drm_mode_match(&crtc_state->mode,
+				   &pinfo->desc->modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return i;
+	}
+
+	return 0;
+}
+
+/*
+ * The panel's frame-rate register (0x60) knows two classes: 0x00 for its
+ * 120Hz class and 0x01 for 60Hz. Every mode in the table below is a 120Hz-
+ * class mode a fraction of a hertz either side of 120, each matching one
+ * console's frame rate at twice its speed. Rounding cannot tell the class:
+ * 119.455Hz rounds to 119 and would have been programmed as 60Hz under
+ * 120Hz timings. So the class is a band, not an exact value.
+ */
+static int il97680a_rate_class(const struct drm_display_mode *m)
+{
+	return drm_mode_vrefresh(m) >= 90 ? 120 : 60;
+}
+
+static int il97680a_rpnova_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+
+	int cur_mode = il97680a_get_current_mode(pinfo);
+	int cur_class = il97680a_rate_class(&pinfo->desc->modes[cur_mode]);
+
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc8, 0x62);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x21);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xa4, 0x38);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x23);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x85, 0x15);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+	if (cur_class == 120) {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x00);
+	} else {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x01);
+	}
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6d, 0x00);
+
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x0d, 0x75, 0x00, 0x00);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode il97680a_rpnova_modes[] = {
+	{
+		/*
+		 * 119.88011988Hz exactly, which is 2 x NTSC (120000/1001).
+		 * Almost everything this device emulates is 59.94 fps content.
+		 * At a flat 120Hz the panel's half-rate is 59.9998, so the
+		 * frontend drops or repeats a frame every 16.7s to stay with
+		 * the content, and black frame insertion turns that correction
+		 * into a visible flash.
+		 *
+		 * The rate is exact rather than near. refresh is
+		 * clock * 1000 / (htotal * vtotal), so if htotal * vtotal is a
+		 * multiple of 1001 then 120 * htotal * vtotal / 1001 is a whole
+		 * number of kHz and the division comes back to 120000/1001 with
+		 * nothing left over. 1001 is 7 x 11 x 13; htotal 1302 already
+		 * carries the 7, and vtotal 1001 supplies the rest, which costs
+		 * three extra lines of vertical back porch.
+		 *
+		 *   156240000 / (1302 * 1001) = 119.88011988...
+		 *
+		 * so the frontend never has a correction to make for 59.94
+		 * content and the BFI cadence holds indefinitely.
+		 *
+		 * drm_mode_vrefresh() still rounds this to 120, so the panel's
+		 * frame-rate register (0x60) is programmed 0x00 exactly as
+		 * before - see il97680a_rpnova_init_sequence().
+		 */
+		.clock = 156240,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 27,
+	},
+	{
+		/*
+		 * 119.45505Hz, which is 2 x 59.727500 - the Game Boy, Game Boy
+		 * Color and Game Boy Advance, all three: 4194304Hz over 70224
+		 * cycles a frame, and 16777216Hz over 280896 for the GBA, come
+		 * to the same 59.7275.
+		 *
+		 *   119.880120 / 59.7275 = 2.0071   <- a frame repeated about
+		 *                                       every 2.3 seconds
+		 *   119.455046 / 59.7275 = 2.0000   <- this one
+		 *
+		 *   155686000 / (1302 * 1001) = 119.45505...
+		 *
+		 * +0.4ppm from 2 x 59.7275. Same totals as the modes above,
+		 * the pixel clock alone moves; drm_mode_vrefresh() rounds it to
+		 * 119, which is why the frame-rate register is chosen by class
+		 * (il97680a_rate_class()) rather than by that number.
+		 */
+		.clock = 155686,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 27,
+	},
+	{
+		/*
+		 * 120.19778Hz, which is 2 x 60.098814 - the NTSC Super
+		 * Nintendo: a 21477272.7Hz master clock over 357366 cycles a
+		 * frame, the rate snes9x reports.
+		 *
+		 *   119.880120 / 60.0988 = 1.9947   <- a frame dropped about
+		 *                                       every 3.2 seconds
+		 *   120.197775 / 60.0988 = 2.0000   <- this one
+		 *
+		 *   156654000 / (1302 * 1001) = 120.19778...
+		 *
+		 * +1.2ppm from 2 x 60.0988. The only mode in the table above
+		 * 120Hz, by 0.16%: the pixel clock is 0.26% above the 119.88
+		 * mode's.
+		 */
+		.clock = 156654,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 27,
+	},
+	{
+		/*
+		 * 119.65224Hz, which is 2 x 59.82610 - the NTSC Nintendo 64 in
+		 * 240p: a 48.681812MHz video clock, 3094 clocks a line and 263
+		 * lines a frame, 813722 clocks. ParaLLEl N64 emulates that
+		 * period exactly since its 003-vi-frame-period patch; before
+		 * it the core ran at 60.0176 and no mode could have fitted.
+		 *
+		 *   119.880120 / 59.82610 = 2.0039   <- a frame repeated about
+		 *                                       every 4.3 seconds
+		 *   119.652237 / 59.82610 = 2.0000   <- this one
+		 *
+		 *   155943000 / (1302 * 1001) = 119.65224...
+		 *
+		 * +0.35ppm from 2 x 59.82610, a frame in about 8 hours.
+		 *
+		 * The NTSC PlayStation in 240p is the same rate: 263 lines of
+		 * 3412.5 GPU clocks at 53.693175MHz, 59.82610 too, since the
+		 * 001-ntsc-line-is-3412-5-ticks patch to SwanStation. Before
+		 * it the core rounded the line to 3413 clocks, ran at 59.8173,
+		 * and had a 155920kHz mode of its own here.
+		 */
+		.clock = 155943,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 27,
+	},
+	{
+		/*
+		 * 119.84559Hz, which is 2 x 59.92274 - the NTSC Sega consoles that
+		 * Genesis Plus GX runs, Master System to Mega CD: a 53.693175MHz
+		 * master clock, 3420 clocks a line and 262 lines a frame, 896040
+		 * clocks, the rate the core reports.
+		 *
+		 *   119.880120 / 59.92274 = 2.00059   <- a frame repeated about
+		 *                                        every 28 seconds
+		 *   119.845592 / 59.92274 = 2.00000   <- this one
+		 *
+		 *   156195000 / (1302 * 1001) = 119.84559...
+		 *
+		 * +0.9ppm from 2 x 59.92274. The closest neighbour of the 119.88
+		 * mode, 0.035Hz below it; setsettings asks for a mode within
+		 * 0.002Hz and RetroArch takes the closest, so neither is confused
+		 * for the other. PicoDrive (32X) reports a flat 60 and stays on
+		 * 119.88.
+		 */
+		.clock = 156195,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 27,
+	},
+	{
+		/*
+		 * 118.36013Hz, which is 2 x 59.18 - the Neo Geo MVS as FBNeo runs
+		 * it. The board's rate is 15625 / 264 = 59.1856 (a 24MHz crystal,
+		 * 6MHz pixel clock, 384 pixels a line, 264 lines), but FBNeo keeps
+		 * its frame rate in hundredths of a hertz and truncates, so the
+		 * core reports and paces at 59.18 exactly, and that is what the
+		 * mode has to match.
+		 *
+		 *   119.880120 / 59.18 = 2.02568   <- a frame repeated about
+		 *                                     every 0.7 seconds
+		 *   118.360134 / 59.18 = 2.00000   <- this one
+		 *
+		 *   154259000 / (1302 * 1001) = 118.36013...
+		 *
+		 * +1.1ppm from 2 x 59.18. The lowest pixel clock in the table,
+		 * 1.27% below the 119.88 mode's; drm_mode_vrefresh() rounds it to
+		 * 118 and il97680a_rate_class() still puts it in the 120Hz class.
+		 */
+		.clock = 154259,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 27,
+	},
+	{
+		/*
+		 * 119.19954Hz, which is 2 x 59.59990 - the Neo Geo CD as NeoCD
+		 * runs it: a 24.168MHz master clock, 6.042MHz pixel clock, 384
+		 * pixels a line and 264 lines a frame, 6042000 / 101376. The AES
+		 * and the CD have this crystal; the MVS above has 24.000MHz.
+		 *
+		 *   119.880120 / 59.59990 = 2.01141   <- a frame repeated about
+		 *                                        every 1.5 seconds
+		 *   119.199541 / 59.59990 = 2.00000   <- this one
+		 *
+		 *   155353000 / (1302 * 1001) = 119.19954...
+		 *
+		 * -2.3ppm from 2 x 59.59990, a frame in about 1 hour.
+		 */
+		.clock = 155353,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 27,
+	},
+	{
+		/*
+		 * 120.00000Hz exactly, for Steam. gamescope asks for 120 and
+		 * takes the mode whose exact rate is closest to it (its patch
+		 * 0007); every emulator asks for its own rate or takes the
+		 * preferred mode, and this one is neither. PC games that pace
+		 * themselves by a timer - an in-game 60fps cap, DXVK's or
+		 * VKD3D's frame limiter - make 60.000 frames a second, and at
+		 * 119.88Hz gamescope drops one of them about every 17 seconds.
+		 *
+		 * The preferred mode's pixel clock over one line fewer: 26 lines
+		 * of vertical back porch instead of 27, still two more than the
+		 * panel's own timing had before the 1001 above.
+		 *
+		 *   156240000 / (1302 * 1000) = 120.00000
+		 *
+		 * Set from userspace before it was added here: 120.003Hz over a
+		 * minute of vblanks, against 119.884 for the preferred mode on
+		 * the same count, and no DSI errors.
+		 */
+		.clock = 156240,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 26,
+	},
+};
+
+
+static struct panel_desc il97680a_rpnova_desc = {
+	.modes = il97680a_rpnova_modes,
+	.num_modes = ARRAY_SIZE(il97680a_rpnova_modes),
+	.width_mm = 91,
+	.height_mm = 68,
+	.bpc = 8,
+	.lanes = 4,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO |
+				  MIPI_DSI_MODE_VIDEO_HSE |
+				  MIPI_DSI_CLOCK_NON_CONTINUOUS |
+				  MIPI_DSI_MODE_NO_EOT_PACKET |
+				  MIPI_DSI_MODE_LPM,
+	.init_sequence = il97680a_rpnova_init_sequence,
+};
+
+static void il97680a_reset(struct panel_info *pinfo)
+{
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 0);
+	usleep_range(20000, 21000);
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
+	usleep_range(20000, 21000);
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 0);
+	usleep_range(20000, 21000);
+}
+
+static int il97680a_prepare(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	il97680a_reset(pinfo);
+
+	ret = pinfo->desc->init_sequence(pinfo);
+	if (ret < 0) {
+		regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int il97680a_disable(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+
+	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int il97680a_unprepare(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+
+	return 0;
+}
+
+static void il97680a_remove(struct mipi_dsi_device *dsi)
+{
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(pinfo->dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&pinfo->panel);
+}
+
+static int il97680a_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	int first_class = il97680a_rate_class(&pinfo->desc->modes[0]);
+	int i, count = 0;
+
+	for (i = 0; i < pinfo->desc->num_modes; i++) {
+		const struct drm_display_mode *m = &pinfo->desc->modes[i];
+		struct drm_display_mode *mode;
+
+		/*
+		 * init_sequence() programs the frame-rate register (0x60) from
+		 * il97680a_get_current_mode(), which guesses the active mode at
+		 * prepare() time and can guess wrong. That is harmless only
+		 * while every exposed mode is in the same rate class, because
+		 * then every guess programs the same value. A mode of another
+		 * class - the old 60Hz entry was one - reopens the race that
+		 * left the panel at 60Hz under 120Hz timings, so it is not
+		 * exposed. This replaces cutting the table to one entry, which
+		 * closed the race by also hiding 119.63459Hz.
+		 */
+		if (il97680a_rate_class(m) != first_class) {
+			dev_warn(panel->dev,
+				 "not exposing %ux%u@%d: not in the %dHz rate class\n",
+				 m->hdisplay, m->vdisplay, drm_mode_vrefresh(m),
+				 first_class);
+			continue;
+		}
+
+		mode = drm_mode_duplicate(connector->dev, m);
+		if (!mode) {
+			dev_err(panel->dev, "failed to add mode %ux%u@%u\n",
+				m->hdisplay, m->vdisplay, drm_mode_vrefresh(m));
+			return -ENOMEM;
+		}
+
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+		count++;
+	}
+
+	connector->display_info.width_mm = pinfo->desc->width_mm;
+	connector->display_info.height_mm = pinfo->desc->height_mm;
+	connector->display_info.bpc = pinfo->desc->bpc;
+	pinfo->connector = connector;
+
+	return count;
+}
+
+static enum drm_panel_orientation il97680a_get_orientation(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+
+	return pinfo->orientation;
+}
+
+static const struct drm_panel_funcs il97680a_panel_funcs = {
+	.disable = il97680a_disable,
+	.prepare = il97680a_prepare,
+	.unprepare = il97680a_unprepare,
+	.get_modes = il97680a_get_modes,
+	.get_orientation = il97680a_get_orientation,
+};
+
+static int il97680a_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static int il97680a_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness;
+}
+
+static const struct backlight_ops il97680a_bl_ops = {
+	.update_status = il97680a_bl_update_status,
+	.get_brightness = il97680a_bl_get_brightness,
+};
+
+static struct backlight_device *il97680a_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 3445,
+		.max_brightness = 3445,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &il97680a_bl_ops, &props);
+}
+
+static int il97680a_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct panel_info *pinfo;
+	int ret;
+
+	pinfo = devm_drm_panel_alloc(dev, struct panel_info, panel,
+				   &il97680a_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(pinfo))
+		return PTR_ERR(pinfo);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
+					    panel_supplies, &pinfo->supplies);
+	if (ret < 0) {
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+	}
+
+	pinfo->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(pinfo->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(pinfo->reset_gpio), "failed to get reset gpio\n");
+
+	pinfo->desc = (struct panel_desc *)of_device_get_match_data(dev);
+	if (!pinfo->desc)
+		return -ENODEV;
+
+	pinfo->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, pinfo);
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &pinfo->orientation);
+	if (ret < 0) {
+		dev_err(dev, "%pOF: failed to get orientation %d\n", dev->of_node, ret);
+		return ret;
+	}
+
+	pinfo->panel.prepare_prev_first = true;
+
+	pinfo->panel.backlight = il97680a_create_backlight(dsi);
+	if (IS_ERR(pinfo->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(pinfo->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&pinfo->panel);
+
+	pinfo->dsi->lanes = pinfo->desc->lanes;
+	pinfo->dsi->format = pinfo->desc->format;
+	pinfo->dsi->mode_flags = pinfo->desc->mode_flags;
+
+	ret = mipi_dsi_attach(pinfo->dsi);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+		drm_panel_remove(&pinfo->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static const struct of_device_id il97680a_of_match[] = {
+	{ .compatible = "il97680a,rpnova", .data = &il97680a_rpnova_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, il97680a_of_match);
+
+static struct mipi_dsi_driver il97680a_driver = {
+	.probe = il97680a_probe,
+	.remove = il97680a_remove,
+	.driver = {
+		.name = "panel-ilitek-il97680a",
+		.of_match_table = il97680a_of_match,
+	},
+};
+module_mipi_dsi_driver(il97680a_driver);
+
+MODULE_AUTHOR("Teguh Sobirin <teguh@sobir.in>");
+MODULE_DESCRIPTION("DRM driver for Ilitek IL97680A based MIPI DSI panels");
+MODULE_LICENSE("GPL");
