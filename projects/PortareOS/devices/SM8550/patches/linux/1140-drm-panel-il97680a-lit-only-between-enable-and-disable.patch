From: PortareOS <hello@portare.org>
Subject: [PATCH] drm/panel: il97680a: lit only between enable and disable

prepare() ran the whole on-sequence, display on included, with the
brightness register at full (0x0d75), and the panel had no enable(). DRM
writes the user's brightness after enable (backlight_enable() in
drm_panel_enable()), so at every power-on and resume the panel showed at
full brightness from prepare until that write.

prepare() now stops after sleep out, with the brightness at 0, and
enable() turns the display on and sends the rest of Android's
on-command (E1 of page 0x22); disable() turns it off, unprepare() enters
sleep before cutting the power. The panel is lit between the backlight
core's write of the user's level and its write of 0.

A brightness write while the panel is off (suspended, or the CRTC off)
failed in the DSI transfer and returned with LPM cleared. It now only
updates the backlight core, which writes it at the next enable, and the
DSI mode flags are restored after every write. A mutex keeps enable,
disable and brightness writes apart.

The same lifecycle as Armada's reworked driver for this panel
(armada-os/armada#786, Jacob Pyke and Teguh Sobirin), kept in video mode
with the mode table, rate classes, variable refresh and the luminance-
linear brightness scale from the earlier patches.
---
--- a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -32,6 +33,14 @@ struct panel_info {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
 	struct drm_panel_bl_levels bl_levels;
+
+	/*
+	 * Held by enable, disable and brightness writes: a write from sysfs
+	 * while the panel is off goes only to the backlight core, which
+	 * hands it over again at the next enable.
+	 */
+	struct mutex lock;
+	bool enabled;
 };
 
 struct panel_desc {
@@ -46,6 +55,7 @@ struct panel_desc {
 	const struct drm_display_mode *modes;
 	unsigned int num_modes;
 	int (*init_sequence)(struct panel_info *pinfo);
+	int (*on_sequence)(struct panel_info *pinfo);
 
 	/*
 	 * Variable refresh floor in Hz, 0 for none. The top is the fastest
@@ -131,13 +141,26 @@ static int il97680a_rpnova_init_sequence(struct panel_info *pinfo)
 
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
 				     0x20);
+	/*
+	 * Dark until enable: the backlight core writes the user's level
+	 * after il97680a_enable(). Full brightness here lit the panel at
+	 * 3445 for a moment at every power-on and resume.
+	 */
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
-				     0x0d, 0x75, 0x00, 0x00);
+				     0x00, 0x00, 0x00, 0x00);
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 
 	mipi_dsi_msleep(&dsi_ctx, 120);
 
+	return dsi_ctx.accum_err;
+}
+
+/* Display on, after prepare's sleep out: the rest of Android's on-command */
+static int il97680a_rpnova_on_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 
 	mipi_dsi_msleep(&dsi_ctx, 20);
@@ -421,6 +444,7 @@ static struct panel_desc il97680a_rpnova_desc = {
 				  MIPI_DSI_MODE_NO_EOT_PACKET |
 				  MIPI_DSI_MODE_LPM,
 	.init_sequence = il97680a_rpnova_init_sequence,
+	.on_sequence = il97680a_rpnova_on_sequence,
 };
 
 static void il97680a_reset(struct panel_info *pinfo)
@@ -456,17 +480,40 @@ static int il97680a_prepare(struct drm_panel *panel)
 	return 0;
 }
 
+/*
+ * DRM's order: prepare, enable, then the backlight core's write of the
+ * user's level; at the end the backlight's write of 0, disable, unprepare.
+ * Display on and off here, sleep out and in with the power in prepare and
+ * unprepare, so the panel is lit only between the two brightness writes.
+ */
+static int il97680a_enable(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	int ret;
+
+	mutex_lock(&pinfo->lock);
+	ret = pinfo->desc->on_sequence(pinfo);
+	if (ret < 0)
+		dev_err(panel->dev, "failed to turn the display on: %d\n", ret);
+	else
+		pinfo->enabled = true;
+	mutex_unlock(&pinfo->lock);
+
+	return ret;
+}
+
 static int il97680a_disable(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	mutex_lock(&pinfo->lock);
+	pinfo->enabled = false;
 	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 20);
-	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 120);
+	mutex_unlock(&pinfo->lock);
 
 	return dsi_ctx.accum_err;
 }
@@ -474,6 +521,15 @@ static int il97680a_disable(struct drm_panel *panel)
 static int il97680a_unprepare(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+
+	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	if (dsi_ctx.accum_err)
+		dev_err(panel->dev, "failed to enter sleep mode: %d\n",
+			dsi_ctx.accum_err);
 
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
 	regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
@@ -572,6 +628,7 @@ static enum drm_panel_orientation il97680a_get_orientation(struct drm_panel *pan
 }
 
 static const struct drm_panel_funcs il97680a_panel_funcs = {
+	.enable = il97680a_enable,
 	.disable = il97680a_disable,
 	.prepare = il97680a_prepare,
 	.unprepare = il97680a_unprepare,
@@ -628,17 +685,24 @@ static int il97680a_bl_update_status(struct backlight_device *bl)
 	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = drm_panel_bl_levels_map(&pinfo->bl_levels,
 						 backlight_get_brightness(bl));
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
+	unsigned long mode_flags;
+	int ret = 0;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	/*
+	 * Off (suspended, blanked): nothing to send it to; enable's
+	 * backlight_enable() writes the level kept. The write used to fail
+	 * and leave LPM cleared for the next command.
+	 */
+	mutex_lock(&pinfo->lock);
+	if (pinfo->enabled) {
+		mode_flags = dsi->mode_flags;
+		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+		dsi->mode_flags = mode_flags;
+	}
+	mutex_unlock(&pinfo->lock);
 
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
 static int il97680a_bl_get_brightness(struct backlight_device *bl)
@@ -690,6 +754,10 @@ static int il97680a_probe(struct mipi_dsi_device *dsi)
 	if (!pinfo->desc)
 		return -ENODEV;
 
+	ret = devm_mutex_init(dev, &pinfo->lock);
+	if (ret)
+		return ret;
+
 	pinfo->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
 
