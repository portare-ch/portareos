From: PortareOS <hello@portare.org>
Subject: [PATCH] drm/msm: AVR variable refresh on DSI video mode, for testing

The INTF on DPU 9.0 has AVR, the block Qualcomm's downstream driver uses
for Qsync in video mode: the vertical front porch runs on until a
trigger, up to a set frame length. Mainline defines its registers and
never programs them. Downstream sets AVR_SUPPORT_ENABLE, bit 29 of the
DSI host's video mode control, with it.

msm.dpu_avr_min_fps sets a floor in Hz, read at mode set; 0, the
default, leaves the fixed refresh. With a floor, the DSI host sets bit
29, the mode set writes the longest frame, and the next commit switches
AVR on, one-shot, with the INTF in its flush, in the order downstream
uses. Each commit then ends the held porch. Without the DSI bit, AVR
read back as programmed and its status bit stayed clear. The panel gets
no Qsync commands; the Nova's has none.
---
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
@@ -112,6 +112,15 @@
 
 	void (*program_intf_cmd_cfg)(struct dpu_hw_intf *intf,
 				     struct dpu_hw_intf_cmd_mode_cfg *cmd_mode_cfg);
+
+	/*
+	 * AVR, the INTF's variable refresh in video mode: once enabled, the
+	 * vertical front porch runs on past the mode's frame until
+	 * avr_trigger(), or until the frame reaches setup_avr()'s length.
+	 */
+	void (*setup_avr)(struct dpu_hw_intf *intf, u32 max_frame_pixels);
+	void (*enable_avr)(struct dpu_hw_intf *intf, bool enable);
+	void (*avr_trigger)(struct dpu_hw_intf *intf);
 };
 
 struct dpu_hw_intf {
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
@@ -281,6 +281,25 @@
 	DPU_REG_WRITE(c, INTF_TIMING_ENGINE_EN, enable != 0);
 }
 
+static void dpu_hw_intf_setup_avr(struct dpu_hw_intf *intf,
+		u32 max_frame_pixels)
+{
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_VTOTAL, max_frame_pixels);
+}
+
+/* One-shot mode, as Qualcomm's downstream driver programs it for Qsync. */
+static void dpu_hw_intf_enable_avr(struct dpu_hw_intf *intf, bool enable)
+{
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_CONTROL, enable ? BIT(0) : 0);
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_MODE,
+		      enable ? (BIT(0) | BIT(8)) : 0);
+}
+
+static void dpu_hw_intf_avr_trigger(struct dpu_hw_intf *intf)
+{
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_TRIGGER, 0x1);
+}
+
 static void dpu_hw_intf_setup_prg_fetch(
 		struct dpu_hw_intf *intf,
 		const struct dpu_hw_intf_prog_fetch *fetch)
@@ -668,5 +687,11 @@
 	if (mdss_rev->core_major_ver >= 7)
 		c->ops.program_intf_cmd_cfg = dpu_hw_intf_program_intf_cmd_cfg;
 
+	if (mdss_rev->core_major_ver >= 9 && cfg->type == INTF_DSI) {
+		c->ops.setup_avr = dpu_hw_intf_setup_avr;
+		c->ops.enable_avr = dpu_hw_intf_enable_avr;
+		c->ops.avr_trigger = dpu_hw_intf_avr_trigger;
+	}
+
 	return c;
 }
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
@@ -198,6 +198,8 @@
 	wait_queue_head_t pending_kickoff_wq;
 	unsigned int irq[INTR_IDX_MAX];
 	bool has_intf_te;
+	bool avr_wanted;
+	bool avr_enabled;
 };
 
 static inline int dpu_encoder_phys_inc_pending(struct dpu_encoder_phys *phys)
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -254,6 +254,64 @@
 	spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
 }
 
+static void dpu_encoder_phys_vid_setup_avr(struct dpu_encoder_phys *phys_enc,
+		const struct dpu_hw_intf_timing_params *timing, int clock_khz)
+{
+	struct dpu_hw_intf *intf = phys_enc->hw_intf;
+	unsigned int min_fps = READ_ONCE(msm_avr_min_fps);
+	u32 htotal = get_horizontal_total(timing);
+	u32 vtotal = get_vertical_total(timing);
+	unsigned long lock_flags;
+	u64 lines = 0;
+
+	phys_enc->avr_wanted = false;
+	phys_enc->avr_enabled = false;
+	if (!intf->ops.setup_avr || !intf->ops.enable_avr ||
+	    !intf->ops.avr_trigger)
+		return;
+
+	if (min_fps && htotal)
+		lines = div_u64((u64)clock_khz * 1000, htotal * min_fps);
+	if (min_fps && lines <= vtotal)
+		DPU_ERROR_VIDENC(phys_enc,
+				 "AVR floor %u Hz is not below the mode's rate\n",
+				 min_fps);
+
+	spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
+	intf->ops.enable_avr(intf, false);
+	if (lines > vtotal) {
+		intf->ops.setup_avr(intf, (u32)(lines * htotal));
+		phys_enc->avr_wanted = true;
+	}
+	spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
+
+	if (phys_enc->avr_wanted)
+		DRM_INFO("intf%d: variable refresh, %u to %llu lines a frame\n",
+			 intf->idx - INTF_0, vtotal, lines);
+}
+
+/*
+ * AVR is switched on in a commit while the timing engine runs, with the INTF
+ * in that commit's flush, as Qualcomm's driver switches Qsync on. Enabled
+ * at mode set, before the timing engine starts, it read back as programmed
+ * and its status bit stayed clear.
+ */
+static void dpu_encoder_phys_vid_start_avr(struct dpu_encoder_phys *phys_enc)
+{
+	unsigned long lock_flags;
+
+	if (!phys_enc->avr_wanted || phys_enc->avr_enabled ||
+	    phys_enc->enable_state != DPU_ENC_ENABLED)
+		return;
+
+	spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
+	phys_enc->hw_intf->ops.enable_avr(phys_enc->hw_intf, true);
+	spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
+	phys_enc->hw_ctl->ops.update_pending_flush_intf(phys_enc->hw_ctl,
+							phys_enc->hw_intf->idx);
+	phys_enc->avr_enabled = true;
+}
+
 static void dpu_encoder_phys_vid_setup_timing_engine(
 		struct dpu_encoder_phys *phys_enc)
 {
@@ -330,6 +388,7 @@
 	spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
 
 	programmable_fetch_config(phys_enc, &timing_params);
+	dpu_encoder_phys_vid_setup_avr(phys_enc, &timing_params, mode.clock);
 }
 
 static void dpu_encoder_phys_vid_vblank_irq(void *arg)
@@ -558,6 +617,8 @@
 
 	drm_enc = phys_enc->parent;
 
+	dpu_encoder_phys_vid_start_avr(phys_enc);
+
 	ctl = phys_enc->hw_ctl;
 	if (!ctl->ops.wait_reset_status)
 		return;
@@ -602,6 +663,11 @@
 	}
 
 	spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
+	/* A held front porch would delay the vsync waited for below. */
+	if (phys_enc->avr_enabled)
+		phys_enc->hw_intf->ops.enable_avr(phys_enc->hw_intf, false);
+	phys_enc->avr_wanted = false;
+	phys_enc->avr_enabled = false;
 	phys_enc->hw_intf->ops.enable_timing(phys_enc->hw_intf, 0);
 	if (dpu_encoder_phys_vid_is_master(phys_enc))
 		dpu_encoder_phys_inc_pending(phys_enc);
@@ -666,6 +732,13 @@
 		spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
 		phys_enc->enable_state = DPU_ENC_ENABLED;
 	}
+
+	/* The frame is committed: end the held front porch. */
+	if (phys_enc->avr_enabled) {
+		spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
+		phys_enc->hw_intf->ops.avr_trigger(phys_enc->hw_intf);
+		spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
+	}
 }
 
 static void dpu_encoder_phys_vid_irq_enable(struct dpu_encoder_phys *phys_enc)
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -55,6 +55,17 @@
 module_param(modeset, bool, 0600);
 
 static bool separate_gpu_kms;
+/*
+ * Variable refresh on a DSI video-mode panel, for testing. With a floor in
+ * Hz, the DPU's video encoder holds each frame's vertical front porch open
+ * until the next commit (AVR) and the DSI host follows it. 0 keeps the
+ * fixed refresh. Read at mode set.
+ */
+unsigned int msm_avr_min_fps;
+MODULE_PARM_DESC(dpu_avr_min_fps,
+		 "Variable refresh floor in Hz on DSI video mode, 0 = off (test)");
+module_param_named(dpu_avr_min_fps, msm_avr_min_fps, uint, 0644);
+
 MODULE_PARM_DESC(separate_gpu_kms, "Use separate DRM device for the GPU (0=single DRM device for both GPU and display (default), 1=two DRM devices)");
 module_param(separate_gpu_kms, bool, 0400);
 
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -529,6 +529,9 @@
 
 extern const struct component_master_ops msm_drm_ops;
 
+/* AVR floor in Hz for DSI video mode, 0 = off; msm_drv.c. */
+extern unsigned int msm_avr_min_fps;
+
 int msm_kms_pm_prepare(struct device *dev);
 void msm_kms_pm_complete(struct device *dev);
 
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -843,6 +843,13 @@
 		data |= DSI_VID_CFG0_VIRT_CHANNEL(msm_host->channel);
 		if (msm_dsi_host_is_wide_bus_enabled(&msm_host->base))
 			data |= DSI_VID_CFG0_DATABUS_WIDEN;
+		/*
+		 * AVR_SUPPORT_ENABLE in Qualcomm's downstream driver, which sets
+		 * it together with the INTF's AVR: without it the video engine
+		 * keeps its own frame while the INTF holds the porch open.
+		 */
+		if (READ_ONCE(msm_avr_min_fps))
+			data |= BIT(29);
 		dsi_write(msm_host, REG_DSI_VID_CFG0, data);
 
 		/* Do not swap RGB colors */
