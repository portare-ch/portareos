<portareos>
  <!--
    One entry, because there is one device. Each <file> here becomes a dtb
    make target, so seven entries meant seven device trees built for a
    handheld that can only be a Nova. mkimage_options names the
    mkimage_<step> functions that fill the boot partition; abl is the only
    one there is.

    qcs8550-retroidpocket-rp6.dts and qcs8550-ayn-common.dtsi stay in
    devices/SM8550/linux/dts/qcom even though neither is listed here: the Nova
    tree is a thin override that includes rp6.dts, which in turn includes
    ayn-common.dtsi. They are the base of our device tree, not other devices'.
  -->
  <SM8550 mkimage_options="abl" dtb_prefix="qcom">
    <file short="rpnova" full="Retroid Pocket Nova">qcs8550-retroidpocket-rpnova</file>
  </SM8550>
</portareos>
