#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 PortareOS (https://portare.org)

# Yellow thumbsticks while the battery charges, off again when it stops.
# led.charging=0 in system.cfg switches it off; read every round, so the
# launcher's switch takes effect within a few seconds, no restart.
#
# Stays out of the way of the other LED owners: with led.color=battery the
# battery service colours the sticks by charge and this does nothing; with
# led.color=rgb the user's colours come back when charging ends.

. /etc/profile

LED_PATH="/sys/devices/platform"
STATUS="/sys/class/power_supply/battery/status"
# multi_intensity is blue green red
YELLOW="0 150 255"

sticks() {
  local n
  for side in l r; do
    for n in 1 2 3 4; do
      echo "${2}" > "${LED_PATH}/multi-led${side}${n}/leds/rgb:${side}${n}/multi_intensity"
      echo "${1}" > "${LED_PATH}/multi-led${side}${n}/leds/rgb:${side}${n}/brightness"
    done
  done 2>/dev/null
}

restore() {
  local cfg
  case "$(get_setting led.color)" in
    battery)
      # batteryledstatus owns the sticks in this mode. Leave them alone,
      # or they go dark until its next round, up to fifteen seconds.
      ;;
    rgb)
      # analog_sticks_ledcontrol takes seven values, brightness and an rgb
      # triplet per stick, and prints usage for anything else. Handing it an
      # unset or short analogsticks.led left the sticks on the charging
      # colour for good, which looks exactly like the LED ignoring the
      # charger. Check the count and fall back to off.
      cfg="$(get_setting analogsticks.led)"
      if [ "$(echo ${cfg} | wc -w)" = "7" ]; then
        /usr/bin/analog_sticks_ledcontrol ${cfg}
      else
        sticks 0 "0 0 0"
      fi
      ;;
    *)
      sticks 0 "0 0 0"
      ;;
  esac
}

# The battery arrives about two seconds after this service starts: measured
# on a cold boot at 08:45:58.4 for the service against 08:46:00.4 for
# /sys/class/power_supply/battery. This used to be a one-shot check that
# exited 0, and systemd does not restart a clean exit, so the service was
# dead for the session and the sticks kept whatever led.color had set,
# charging or not. Wait for it.
WAITED=0
while [ ! -e "${STATUS}" ]; do
  if [ "${WAITED}" -ge 60 ]; then
    echo "no battery at ${STATUS} after ${WAITED}s, giving up" >&2
    exit 0
  fi
  sleep 1
  WAITED=$((WAITED + 1))
done

# Start as if charging, so the first round through the loop asserts the
# idle state instead of waiting for a charge cycle. Restoring only on the
# charging -> idle edge left the sticks on the charging colour after a
# boot, a resume or a service restart with the charger already out, until
# someone plugged it in and pulled it again.
STATE="charging"
while true; do
  WANT=0
  if [ "$(get_setting led.charging)" != "0" ] && \
     [ "$(get_setting led.color)" != "battery" ] && \
     [ "$(cat "${STATUS}" 2>/dev/null)" = "Charging" ]; then
    WANT=1
  fi

  if [ "${WANT}" = "1" ]; then
    # Written every round, not only on the change: a resume can hand the
    # sticks back dark, and this is the cheapest way to have them yellow
    # again within seconds.
    sticks 255 "${YELLOW}"
    STATE="charging"
  elif [ "${STATE}" = "charging" ]; then
    restore
    STATE="idle"
  fi
  sleep 3
done
