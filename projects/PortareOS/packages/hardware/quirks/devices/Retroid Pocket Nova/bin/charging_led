#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 PortareOS (https://portare.org)

# Yellow thumbsticks while the battery charges, dark when it stops. The
# sticks are a charging indicator here, not decoration: led.color is not
# consulted on the way down, so an rgb colour does not come back while
# this is on. led.charging=0 in system.cfg hands them back, and that is
# what to set to keep a colour; read every round, so the launcher's switch
# takes effect within a few seconds, no restart.
#
# The one owner it stays out of the way of is led.color=battery, where the
# battery service colours the sticks by charge and needs them while
# discharging - that is where the low-battery warning lives.

. /etc/profile

LED_PATH="/sys/devices/platform"
STATUS="/sys/class/power_supply/battery/status"
# multi_intensity is blue green red
YELLOW="0 150 255"

sticks() {
  local n
  for side in l r; do
    for n in 1 2 3 4; do
      echo "${2}" > "${LED_PATH}/multi-led${side}${n}/leds/rgb:${side}${n}/multi_intensity"
      echo "${1}" > "${LED_PATH}/multi-led${side}${n}/leds/rgb:${side}${n}/brightness"
    done
  done 2>/dev/null
}

# Dark. While this script owns the sticks they are a charging indicator,
# so led.color is not consulted on the way down. Battery mode is the
# exception: that service owns them and shows charge while discharging,
# including the low-battery warning.
idle() {
  case "$(get_setting led.color)" in
    battery) ;;
    *)       sticks 0 "0 0 0" ;;
  esac
}

# led.charging=0: not ours any more. Put back what led.color asks for.
handback() {
  local cfg
  case "$(get_setting led.color)" in
    battery) ;;
    rgb)
      # analog_sticks_ledcontrol takes seven values, brightness and an rgb
      # triplet per stick, and prints usage for anything else. An unset or
      # short setting would leave the charging colour sitting there, so
      # fall back to off.
      cfg="$(get_setting analogsticks.led)"
      if [ "$(echo ${cfg} | wc -w)" = "7" ]; then
        /usr/bin/analog_sticks_ledcontrol ${cfg}
      else
        sticks 0 "0 0 0"
      fi
      ;;
    *) sticks 0 "0 0 0" ;;
  esac
}

# The battery arrives about two seconds after this service starts: measured
# on a cold boot at 08:45:58.4 for the service against 08:46:00.4 for
# /sys/class/power_supply/battery. This used to be a one-shot check that
# exited 0, and systemd does not restart a clean exit, so the service was
# dead for the session and the sticks kept whatever led.color had set,
# charging or not. Wait for it.
WAITED=0
while [ ! -e "${STATUS}" ]; do
  if [ "${WAITED}" -ge 60 ]; then
    echo "no battery at ${STATUS} after ${WAITED}s, giving up" >&2
    exit 0
  fi
  sleep 1
  WAITED=$((WAITED + 1))
done

# STATE starts unset rather than idle, so the first round through asserts
# whichever state applies instead of waiting for a charge cycle. Acting
# only on the charging -> idle edge left the sticks on the charging colour
# after a boot, a resume or a service restart with the charger already
# out, until someone plugged it in and pulled it again.
STATE="init"
while true; do
  if [ "$(get_setting led.charging)" = "0" ]; then
    [ "${STATE}" = "handed" ] || { handback; STATE="handed"; }
  elif [ "$(get_setting led.color)" != "battery" ] && \
       [ "$(cat "${STATUS}" 2>/dev/null)" = "Charging" ]; then
    # Written every round, not only on the change: a resume can hand the
    # sticks back dark, and this is the cheapest way to have them yellow
    # again within seconds.
    sticks 255 "${YELLOW}"
    STATE="charging"
  else
    [ "${STATE}" = "idle" ] || { idle; STATE="idle"; }
  fi
  sleep 3
done
