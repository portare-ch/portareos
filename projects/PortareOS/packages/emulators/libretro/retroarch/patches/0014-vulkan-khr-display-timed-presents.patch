       vk->fse_release = vkGetDeviceProcAddr(vk->context.device,
                "vkReleaseFullScreenExclusiveModeEXT");
    }
-   vk->display_timing_query = NULL;
-   vk->present_id           = 0;
+#endif
+
+   /* Present timing is Mesa's and Android's as much as anyone's: not
+    * under the Win32 ifdef above. */
+   vk->display_timing_query   = NULL;
+   vk->display_timing_refresh = NULL;
+   vk->present_id             = 0;
+   vk->last_present_ns        = 0;
+   vk->last_present_id        = 0;
+   vk->refresh_duration_ns    = 0;
