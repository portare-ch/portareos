+         vk->display_timing_supported = false;
+         vk->display_timing_query     = NULL;
+         vk->display_timing_refresh   = NULL;
+         RARCH_WARN("[Vulkan] VK_GOOGLE_display_timing: not enabled on the device, presents are not timed.\n");
