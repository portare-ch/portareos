    if (vk->swapchain == VK_NULL_HANDLE)
@@ -3518,28 +3595,90 @@ void vulkan_context_destroy(gfx_ctx_vulkan_data_t *vk,
 #endif
 }
 
-/* When the most recent present the driver has timed reached the display,
- * in microseconds on the platform's monotonic clock - the clock
- * cpu_features_get_time_usec() reads on the platforms that have this
- * extension. 0 without the extension or before the first timed present. */
-retro_time_t vulkan_last_present_time(gfx_ctx_vulkan_data_t *vk)
+/* Take what the driver has timed since the last poll into
+ * last_present_ns and last_present_id. The driver hands each record
+ * out once, so everything that wants them reads them from here. */
+static void vulkan_poll_present_timing(gfx_ctx_vulkan_data_t *vk)
 {
    PFN_vkGetPastPresentationTimingGOOGLE query;
    VkPastPresentationTimingGOOGLE timings[8];
    uint32_t count = 8;
    uint32_t i;
-   uint64_t latest = 0;
 
-   if (!vk || !vk->display_timing_supported || !vk->display_timing_query
+   if (!vk->display_timing_supported || !vk->display_timing_query
          || vk->swapchain == VK_NULL_HANDLE)
-      return 0;
+      return;
    query = (PFN_vkGetPastPresentationTimingGOOGLE)vk->display_timing_query;
    if (query(vk->context.device, vk->swapchain, &count, timings) < 0)
-      return 0;
+      return;
    for (i = 0; i < count; i++)
-      if (timings[i].actualPresentTime > latest)
-         latest = timings[i].actualPresentTime;
-   return (retro_time_t)(latest / 1000);
+   {
+      if (timings[i].actualPresentTime > vk->last_present_ns)
+      {
+         vk->last_present_ns = timings[i].actualPresentTime;
+         vk->last_present_id = timings[i].presentID;
+      }
+   }
+}
+
+/* When the most recent present the driver has timed reached the display,
+ * in microseconds on the platform's monotonic clock - the clock
+ * cpu_features_get_time_usec() reads on the platforms that have this
+ * extension. 0 without the extension or before the first timed present. */
+retro_time_t vulkan_last_present_time(gfx_ctx_vulkan_data_t *vk)
+{
+   if (!vk)
+      return 0;
+   vulkan_poll_present_timing(vk);
+   return (retro_time_t)(vk->last_present_ns / 1000);
+}
+
+/* Timed presents are on when the context asked for them, the device can
+ * time presents, and the swapchain runs a swap interval above 1. */
+void vulkan_update_timed_presents(gfx_ctx_vulkan_data_t *vk)
+{
+   if (     vk->timed_presents
+         && vk->display_timing_supported
+         && vk->display_timing_query
+         && vk->display_timing_refresh
+         && vk->context.swap_interval > 1)
+      vk->context.flags |=  VK_CTX_FLAG_SWAP_INTERVAL_TIMED;
+   else
+      vk->context.flags &= ~VK_CTX_FLAG_SWAP_INTERVAL_TIMED;
+}
+
+/* Where the present with this ID should reach the display: interval
+ * refresh periods after the last timed present, per present issued
+ * since it. The last one is what the display did, not what was asked,
+ * so a frame that came late moves the cadence by a refresh and the
+ * next frame is placed from where the display actually is. 0, an
+ * immediate present, before anything has been timed. */
+static uint64_t vulkan_timed_present_target(gfx_ctx_vulkan_data_t *vk,
+      uint32_t present_id)
+{
+   uint64_t interval_ns;
+
+   if (!vk->refresh_duration_ns)
+   {
+      PFN_vkGetRefreshCycleDurationGOOGLE refresh =
+         (PFN_vkGetRefreshCycleDurationGOOGLE)vk->display_timing_refresh;
+      VkRefreshCycleDurationGOOGLE duration;
+      if (refresh(vk->context.device, vk->swapchain, &duration) != VK_SUCCESS
+            || !duration.refreshDuration)
+         return 0;
+      vk->refresh_duration_ns = duration.refreshDuration;
+      RARCH_LOG("[Vulkan] Timed presents: swap interval %d, one present a frame, %.3f ms apart.\n",
+            (int)vk->context.swap_interval,
+            (double)vk->refresh_duration_ns * vk->context.swap_interval / 1e6);
+   }
+
+   vulkan_poll_present_timing(vk);
+   if (!vk->last_present_ns)
+      return 0;
+
+   interval_ns = vk->refresh_duration_ns * (uint64_t)vk->context.swap_interval;
+   return vk->last_present_ns
+      + (uint64_t)(present_id - vk->last_present_id) * interval_ns;
 }
 
 void vulkan_present(gfx_ctx_vulkan_data_t *vk, unsigned index)
@@ -3569,6 +3708,8 @@ void vulkan_present(gfx_ctx_vulkan_data_t *vk, unsigned index)
       times.pTimes               = &ptime;
       ptime.presentID            = ++vk->present_id;
       ptime.desiredPresentTime   = 0;
+      if (vk->context.flags & VK_CTX_FLAG_SWAP_INTERVAL_TIMED)
+         ptime.desiredPresentTime = vulkan_timed_present_target(vk, ptime.presentID);
       present.pNext              = &times;
    }
 
