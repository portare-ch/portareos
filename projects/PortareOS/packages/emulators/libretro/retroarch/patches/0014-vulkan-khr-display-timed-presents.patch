+   uint32_t last_present_id;
+   /* The swapchain's refresh period, 0 until asked. */
+   uint64_t refresh_duration_ns;
 #ifdef VULKAN_HDR_SWAPCHAIN
    /* Loaded from VK_EXT_hdr_metadata when that optional device extension is
