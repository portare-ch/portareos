+         if (!wanted_count)
+         {
+            for (i = 0; i < ARRAY_SIZE(vulkan_device_extensions); i++)
+               wanted[wanted_count++] = vulkan_device_extensions[i];
+         }
+         for (i = 0; i < wanted_count; i++)
+         {
+            if (!strcmp(wanted[i], "VK_GOOGLE_display_timing"))
+               vk->display_timing_supported = true;
+            else if (!strcmp(wanted[i], "VK_EXT_full_screen_exclusive"))
+               vk->fse_supported = true;
+         }
+
