    vk->context.swap_interval = swap_interval;
+   /* A new swapchain may carry a new mode, and its timing starts over. */
+   vk->refresh_duration_ns   = 0;
+   vk->last_present_ns       = 0;
+   vk->last_present_id       = 0;
+   vulkan_update_timed_presents(vk);
 
