diff --git a/retroarch.c b/retroarch.c
index 4c2fa29b15..2f1a903aa0 100644
--- a/retroarch.c
+++ b/retroarch.c
@@ -38,6 +38,14 @@
 #include <signal.h>
 #endif
 
+#if defined(__linux__) && !defined(ANDROID)
+#include <errno.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#define HAVE_GAME_GUIDE 1
+#define GAME_GUIDE_READER "/usr/bin/sdl2text"
+#endif
+
 #if defined(_WIN32) && !defined(_XBOX) && !defined(__WINRT__)
 #include <objbase.h>
 #include <process.h>
@@ -3354,6 +3362,66 @@ static void command_event_finish_content_deinit(void)
 
 }
 
+#ifdef HAVE_GAME_GUIDE
+/* Runs while the drivers are down, so the reader is the only
+ * process asking for the panel: the video driver's Vulkan display
+ * instance held DRM master until driver_uninit destroyed it, and
+ * the reader takes it through kmsdrm. The core is not stepped
+ * while this waits, so it resumes exactly where it was. */
+static void command_event_game_guide_show(void *data)
+{
+   const char *guide = (const char*)data;
+   pid_t pid         = fork();
+
+   if (pid == 0)
+   {
+      setenv("SDL_VIDEODRIVER", "kmsdrm", 1);
+      setenv("SDL_KMSDRM_REQUIRE_DRM_MASTER", "1", 1);
+      execl(GAME_GUIDE_READER, GAME_GUIDE_READER, guide, (char*)NULL);
+      _exit(127);
+   }
+   else if (pid > 0)
+   {
+      int status;
+      while (waitpid(pid, &status, 0) < 0 && errno == EINTR)
+         ;
+      if (WIFEXITED(status) && WEXITSTATUS(status) == 127)
+         RARCH_ERR("[Game guide] %s did not start.\n", GAME_GUIDE_READER);
+   }
+   else
+      RARCH_ERR("[Game guide] fork: %s\n", strerror(errno));
+}
+
+static void command_event_game_guide(void)
+{
+   char guide[PATH_MAX_LENGTH];
+   runloop_state_t *runloop_st    = runloop_state_get_ptr();
+   video_driver_state_t *video_st = video_state_get_ptr();
+   const char *basename           = path_get(RARCH_PATH_BASENAME);
+
+   if (     !(runloop_st->flags & RUNLOOP_FLAG_CORE_RUNNING)
+         || !video_st->data
+         || string_is_empty(basename))
+      return;
+
+   /* The guide sits next to the content as <name>.txt; for content
+    * in an archive that is next to the archive. */
+   strlcpy(guide, basename, sizeof(guide));
+   strlcat(guide, ".txt", sizeof(guide));
+
+   if (!path_is_valid(guide))
+   {
+      const char *msg = msg_hash_to_str(MSG_GAME_GUIDE_NOT_FOUND);
+      runloop_msg_queue_push(msg, strlen(msg), 1, 120, true, NULL,
+            MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+      return;
+   }
+
+   video_driver_reinit_around(DRIVERS_CMD_ALL,
+         command_event_game_guide_show, guide);
+}
+#endif
+
 bool command_event(enum event_command cmd, void *data)
 {
    struct rarch_state *p_rarch     = &rarch_st;
@@ -5315,6 +5383,11 @@ bool command_event(enum event_command cmd, void *data)
          runloop_st->flags      &= ~RUNLOOP_FLAG_PAUSED;
          runloop_pause_checks();
          break;
+      case CMD_EVENT_GAME_GUIDE:
+#ifdef HAVE_GAME_GUIDE
+         command_event_game_guide();
+#endif
+         break;
       case CMD_EVENT_PAUSE:
          /* Allow pausing only when there is an active core. */
          if (!(runloop_st->flags & RUNLOOP_FLAG_CORE_RUNNING))
