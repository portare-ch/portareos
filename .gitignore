# build directories
/build.*/
/builds
/.fakeroot.*

# automatically downloaded source files
/sources/

# prebuild target binarys to provide
/target/

# mkpkg temp
mkpkg-temp

# options
/.libreelec

# private working directory
/.work/

# dedicated filesystem
/lost+found/

# symlinks...
/sources
/.work

# ccache
/.ccache/

# backup files
*.orig

# crap
.DS_Store
.directory

# ignore git repos from update scripts

# ignore old linux configs
projects/**/*.old

# PortareOS
/.portareos
/.cache
/.doc_cache
/site/
/.env
/.es_cache
/.config

# Python bytecode. A __pycache__ directory under a package's sources/ breaks
# the build: scripts/install copies sources/scripts/* with a plain cp, which
# fails on a directory. This one arrived from running py_compile to check a
# script was valid Python.
__pycache__/
*.pyc

# cross-run build state (.github/scripts/build-state.sh)
/state-*.part-*
/state.tar
/.build-state-*
/statelist.txt
